diff --git drivers/net/wireless/realtek/rtw89/dfs.c drivers/net/wireless/realtek/rtw89/dfs.c
new file mode 100644
index 0000000..3d79570
--- /dev/null
+++ b/drivers/net/wireless/realtek/rtw89/dfs.c
@@ -0,0 +1,595 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright(c) 2007 - 2020  Realtek Corporation
+ *
+ * Radar detection, ported from the gen0 detector of Realtek's halbb
+ * (halbb_dfs.c) as the vendor driver runs it on the RTL8832BR.
+ *
+ * The BB reports each pulse it sees (width, interval to the previous
+ * pulse, chirp flag). The MAC collects the reports and sends them to the
+ * host in batches of up to 61 pulses or after 80 ms. Each batch is matched
+ * against the radar types of the DFS region; long (chirp) radars are
+ * counted across batches.
+ */
+
+#include <linux/unaligned.h>
+
+#include "debug.h"
+#include "dfs.h"
+#include "reg.h"
+
+#define RTW89_DFS_RPT_HDR_LEN 8
+#define RTW89_DFS_RPT_HDR_DROP_NUM GENMASK(15, 0)
+#define RTW89_DFS_RPT_LEN 8
+#define RTW89_DFS_RPT_CHIRP BIT_ULL(0)
+#define RTW89_DFS_RPT_PRI GENMASK_ULL(8, 1)
+#define RTW89_DFS_RPT_PW GENMASK_ULL(18, 9)
+#define RTW89_DFS_RPT_SEQ GENMASK_ULL(63, 57)
+#define RTW89_DFS_SEQ_MAX 127
+
+#define RTW89_DFS_BUF_64 1
+#define RTW89_DFS_NUM_TH_61 1
+#define RTW89_DFS_TIME_TH_80MS 3
+
+#define RTW89_DFS_LONG_IDX 6
+#define RTW89_DFS_ETSI_CHIRP_IDX 3
+#define RTW89_DFS_ETSI_TYPE5_IDX 4
+#define RTW89_DFS_ETSI_TYPE6_IDX 5
+#define RTW89_DFS_FAKE_NUM_TH 5
+#define RTW89_DFS_PRI_UBD_MAX 0xdc
+#define RTW89_DFS_PW_MAX_TH 660
+#define RTW89_DFS_CHRP_CNT_TH 4
+#define RTW89_DFS_LONG_INC_TH 1
+#define RTW89_DFS_LONG_PERIOD (12 * HZ)
+#define RTW89_DFS_TP_TH 2 /* Mbps */
+
+/* {pw_min, pw_max, pri_min, pri_max, ppb}; PW unit 200 ns, PRI unit 25 us */
+static const struct rtw89_dfs_rdr_type rtw89_dfs_fcc[RTW89_DFS_RDR_TYPE_NUM] = {
+	{5, 5, 20, 123, 18},		/* type 1 */
+	{5, 25, 6, 10, 23},		/* type 2 */
+	{30, 50, 8, 20, 16},		/* type 3 */
+	{55, 100, 8, 20, 12},		/* type 4 */
+	{5, 5, 13, 14, 15},		/* type 6 */
+	{5, 5, 57, 58, 18},		/* type 0 */
+	{250, 500, 40, 80, 15},		/* type 5, long chirp */
+};
+
+static const struct rtw89_dfs_rdr_type rtw89_dfs_etsi[RTW89_DFS_RDR_TYPE_NUM] = {
+	{2, 25, 40, 200, 9},		/* type 1 */
+	{2, 75, 25, 200, 15},		/* type 2 */
+	{2, 150, 10, 18, 25},		/* type 3 */
+	{100, 150, 10, 20, 20},		/* type 4, chirp */
+	{2, 15, 100, 134, 20},		/* type 5 */
+	{2, 15, 33, 100, 30},		/* type 6 */
+	{5, 5, 57, 58, 18},		/* reference */
+};
+
+static const struct rtw89_dfs_rdr_type rtw89_dfs_mkk_w53[RTW89_DFS_RDR_TYPE_NUM] = {
+	{2, 25, 40, 200, 10},
+	{2, 75, 25, 200, 15},
+	{2, 25, 30, 196, 22},
+	{2, 75, 15, 196, 22},
+	{2, 8, 24, 32, 30},
+	{2, 8, 32, 39, 25},
+	{2, 8, 34, 41, 24},
+	{2, 8, 43, 51, 20},
+};
+
+static const struct rtw89_dfs_rdr_type rtw89_dfs_mkk_w56[RTW89_DFS_RDR_TYPE_NUM] = {
+	{2, 3, 55, 56, 18},
+	{5, 5, 57, 58, 18},
+	{10, 11, 80, 160, 10},
+	{5, 25, 6, 10, 23},
+	{30, 50, 8, 20, 16},
+	{55, 100, 8, 20, 12},
+	{250, 500, 40, 80, 15},		/* long chirp */
+	{5, 5, 13, 14, 18},
+};
+
+struct rtw89_dfs_bound {
+	u16 pw_lbd;
+	u16 pw_ubd;
+	u8 pri_lbd;
+	u8 pri_ubd;
+	u8 ppb_th;
+};
+
+struct rtw89_dfs_range {
+	u16 min;
+	u16 max;
+};
+
+struct rtw89_dfs_batch {
+	struct rtw89_dfs_bound bnd[RTW89_DFS_RDR_TYPE_NUM];
+	u8 cnt[RTW89_DFS_RDR_TYPE_NUM];
+	struct rtw89_dfs_range pw[RTW89_DFS_RDR_TYPE_NUM];
+	struct rtw89_dfs_range pri[RTW89_DFS_RDR_TYPE_NUM];
+	struct rtw89_dfs_range chrp_pw;
+	struct rtw89_dfs_range lng_pw;
+	u8 chrp_cnt;
+	u16 pw_max;
+	bool n_seq;
+};
+
+bool rtw89_dfs_supported(const struct rtw89_chip_variant *variant)
+{
+	return variant && variant->rtl8832br;
+}
+
+const char *rtw89_dfs_region_str(enum nl80211_dfs_regions region)
+{
+	switch (region) {
+	case NL80211_DFS_FCC:
+		return "FCC";
+	case NL80211_DFS_ETSI:
+		return "ETSI";
+	case NL80211_DFS_JP:
+		return "JP";
+	default:
+		return "unset";
+	}
+}
+
+static void rtw89_dfs_range_init(struct rtw89_dfs_range *r)
+{
+	r->min = U16_MAX;
+	r->max = 0;
+}
+
+static void rtw89_dfs_range_add(struct rtw89_dfs_range *r, u16 val)
+{
+	r->min = min(r->min, val);
+	r->max = max(r->max, val);
+}
+
+static u16 rtw89_dfs_range_diff(const struct rtw89_dfs_range *r)
+{
+	return r->max >= r->min ? r->max - r->min : 0;
+}
+
+static void rtw89_dfs_set_dyn(struct rtw89_dfs_info *dfs, bool idle)
+{
+	dfs->idle = idle;
+
+	if (idle) {
+		dfs->pw_diff_th = 12;
+		dfs->pw_lng_chrp_diff_th = 18;
+		dfs->pri_diff_th = 5;
+		dfs->pw_factor = 1;
+		dfs->pri_factor = 1;
+		dfs->ppb_prcnt = 5;
+	} else {
+		dfs->pw_diff_th = 20;
+		dfs->pw_lng_chrp_diff_th = 20;
+		dfs->pri_diff_th = 120;
+		dfs->pw_factor = 3;
+		dfs->pri_factor = 3;
+		dfs->ppb_prcnt = 4;
+	}
+}
+
+static void rtw89_dfs_reset(struct rtw89_dfs_info *dfs)
+{
+	dfs->chrp_obsrv = false;
+	dfs->lng_rdr_cnt = 0;
+	dfs->lng_rdr_cnt_pre = 0;
+	dfs->last_seq = 0;
+}
+
+static bool rtw89_dfs_chandef_has(const struct cfg80211_chan_def *chandef,
+				  u32 freq_lo, u32 freq_hi)
+{
+	u32 width = cfg80211_chandef_get_width(chandef);
+	u32 freq;
+
+	for (freq = chandef->center_freq1 - width / 2 + 10;
+	     freq < chandef->center_freq1 + width / 2; freq += 20)
+		if (freq >= freq_lo && freq <= freq_hi)
+			return true;
+
+	return false;
+}
+
+static void rtw89_dfs_select_types(struct rtw89_dfs_info *dfs,
+				   const struct cfg80211_chan_def *chandef)
+{
+	dfs->types = NULL;
+	dfs->long_rdr = false;
+	dfs->etsi = false;
+
+	switch (dfs->region) {
+	case NL80211_DFS_FCC:
+		dfs->types = rtw89_dfs_fcc;
+		dfs->long_rdr = true;
+		break;
+	case NL80211_DFS_ETSI:
+		dfs->types = rtw89_dfs_etsi;
+		dfs->etsi = true;
+		break;
+	case NL80211_DFS_JP:
+		if (!chandef)
+			break;
+		if (rtw89_dfs_chandef_has(chandef, 5260, 5320)) {
+			dfs->types = rtw89_dfs_mkk_w53;
+		} else if (rtw89_dfs_chandef_has(chandef, 5500, 5720)) {
+			dfs->types = rtw89_dfs_mkk_w56;
+			dfs->long_rdr = true;
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+static const struct cfg80211_chan_def *rtw89_dfs_chandef(struct rtw89_dev *rtwdev)
+{
+	const struct cfg80211_chan_def *chandef;
+
+	chandef = rtw89_chandef_get(rtwdev, RTW89_CHANCTX_0);
+	if (!chandef->chan || !cfg80211_chandef_valid(chandef))
+		return NULL;
+
+	return chandef;
+}
+
+static void rtw89_dfs_hw_rpt(struct rtw89_dev *rtwdev, bool en)
+{
+	u32 val;
+	u8 cfg;
+	int ret;
+
+	if (en) {
+		/* the MAC function init leaves the BB report block off */
+		rtw89_write32_set(rtwdev, R_AX_DMAC_CLK_EN, B_AX_BBRPT_CLK_EN);
+		rtw89_write32_set(rtwdev, R_AX_DMAC_FUNC_EN, B_AX_BBRPT_EN);
+
+		/* queue and port 0: to the host */
+		val = B_AX_DFS_RPT_EN |
+		      u32_encode_bits(RTW89_DFS_BUF_64, B_AX_DFS_BUF_MASK) |
+		      u32_encode_bits(RTW89_DFS_NUM_TH_61, B_AX_DFS_NUM_TH_MASK) |
+		      u32_encode_bits(RTW89_DFS_TIME_TH_80MS, B_AX_DFS_TIME_TH_MASK);
+		rtw89_write32(rtwdev, R_AX_DFS_CFG0, val);
+		return;
+	}
+
+	cfg = rtw89_read8(rtwdev, R_AX_DFS_CFG0);
+	if (!(cfg & B_AX_DFS_RPT_EN))
+		return;
+
+	rtw89_write8(rtwdev, R_AX_DFS_CFG0, cfg | B_AX_STOP_DFS);
+	ret = read_poll_timeout_atomic(rtw89_read8, val, val & B_AX_DFS_IN_STOP,
+				       1, 3000, false, rtwdev, R_AX_DFS_CFG0);
+	if (ret)
+		rtw89_warn(rtwdev, "failed to stop DFS report\n");
+	rtw89_write8(rtwdev, R_AX_DFS_CFG0, cfg & ~B_AX_DFS_RPT_EN);
+}
+
+void rtw89_dfs_init(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_dfs_info *dfs = &rtwdev->dfs;
+
+	spin_lock_init(&dfs->lock);
+	dfs->supported = rtw89_dfs_supported(rtwdev->variant);
+	dfs->region = NL80211_DFS_UNSET;
+	rtw89_dfs_set_dyn(dfs, true);
+	rtw89_dfs_reset(dfs);
+}
+
+void rtw89_dfs_set_region(struct rtw89_dev *rtwdev,
+			  enum nl80211_dfs_regions region)
+{
+	struct rtw89_dfs_info *dfs = &rtwdev->dfs;
+
+	if (!dfs->supported || dfs->region == region)
+		return;
+
+	spin_lock_bh(&dfs->lock);
+	dfs->region = region;
+	rtw89_dfs_select_types(dfs, rtw89_dfs_chandef(rtwdev));
+	rtw89_dfs_reset(dfs);
+	spin_unlock_bh(&dfs->lock);
+
+	rtw89_debug(rtwdev, RTW89_DBG_DFS, "DFS region %s\n",
+		    rtw89_dfs_region_str(region));
+}
+
+void rtw89_dfs_set_channel(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_dfs_info *dfs = &rtwdev->dfs;
+	const struct cfg80211_chan_def *chandef;
+	bool radar = false;
+
+	if (!dfs->supported)
+		return;
+
+	chandef = rtw89_dfs_chandef(rtwdev);
+	if (chandef)
+		radar = cfg80211_chandef_dfs_required(rtwdev->hw->wiphy, chandef,
+						      NL80211_IFTYPE_AP) > 0;
+
+	spin_lock_bh(&dfs->lock);
+	rtw89_dfs_select_types(dfs, chandef);
+	rtw89_dfs_reset(dfs);
+	dfs->rpt_en = radar && dfs->types;
+	spin_unlock_bh(&dfs->lock);
+
+	/* the BB detector itself is enabled with each channel setting */
+	rtw89_dfs_hw_rpt(rtwdev, dfs->rpt_en);
+
+	rtw89_debug(rtwdev, RTW89_DBG_DFS, "DFS report %s (radar channel %d, region %s)\n",
+		    dfs->rpt_en ? "on" : "off", radar,
+		    rtw89_dfs_region_str(dfs->region));
+
+	if (radar && !dfs->types)
+		rtw89_warn(rtwdev, "no radar detection for DFS region %s\n",
+			   rtw89_dfs_region_str(dfs->region));
+}
+
+void rtw89_dfs_chanctx_radar(struct rtw89_dev *rtwdev, bool enabled)
+{
+	WRITE_ONCE(rtwdev->dfs.chanctx_radar, enabled);
+}
+
+static bool rtw89_dfs_radar_enabled(struct rtw89_dev *rtwdev)
+{
+	/* hw->conf is kept by mac80211 when it emulates channel contexts */
+	return rtwdev->hw->conf.radar_enabled ||
+	       READ_ONCE(rtwdev->dfs.chanctx_radar);
+}
+
+void rtw89_dfs_track(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_traffic_stats *stats = &rtwdev->stats;
+	struct rtw89_dfs_info *dfs = &rtwdev->dfs;
+	bool idle;
+
+	if (!dfs->supported)
+		return;
+
+	idle = stats->tx_throughput + stats->rx_throughput < RTW89_DFS_TP_TH;
+	if (idle == dfs->idle)
+		return;
+
+	spin_lock_bh(&dfs->lock);
+	rtw89_dfs_set_dyn(dfs, idle);
+	spin_unlock_bh(&dfs->lock);
+}
+
+static void rtw89_dfs_batch_init(struct rtw89_dfs_info *dfs,
+				 struct rtw89_dfs_batch *b)
+{
+	int i;
+
+	memset(b, 0, sizeof(*b));
+
+	for (i = 0; i < RTW89_DFS_RDR_TYPE_NUM; i++) {
+		const struct rtw89_dfs_rdr_type *t = &dfs->types[i];
+		struct rtw89_dfs_bound *bnd = &b->bnd[i];
+
+		bnd->ppb_th = (t->ppb * dfs->ppb_prcnt) >> 3;
+		bnd->pw_lbd = min(t->pw_min - 1,
+				  (t->pw_min * (8 - dfs->pw_factor)) >> 3);
+		bnd->pw_ubd = max(t->pw_max + 1,
+				  (t->pw_max * (8 + dfs->pw_factor)) >> 3);
+		bnd->pri_lbd = (t->pri_min * (8 - dfs->pri_factor)) >> 3;
+		bnd->pri_ubd = min((t->pri_max * (8 + dfs->pri_factor)) >> 3,
+				   RTW89_DFS_PRI_UBD_MAX);
+
+		rtw89_dfs_range_init(&b->pw[i]);
+		rtw89_dfs_range_init(&b->pri[i]);
+	}
+
+	rtw89_dfs_range_init(&b->chrp_pw);
+	rtw89_dfs_range_init(&b->lng_pw);
+}
+
+static void rtw89_dfs_chrp_mntr(struct rtw89_dfs_info *dfs, bool chirp)
+{
+	if (!dfs->chrp_obsrv ||
+	    time_after_eq(jiffies, dfs->chrp_start + RTW89_DFS_LONG_PERIOD)) {
+		dfs->chrp_obsrv = false;
+		dfs->lng_rdr_cnt = 0;
+	}
+
+	if (chirp && !dfs->chrp_obsrv) {
+		dfs->chrp_start = jiffies;
+		dfs->chrp_obsrv = true;
+	}
+}
+
+static void rtw89_dfs_match(struct rtw89_dfs_info *dfs,
+			    struct rtw89_dfs_batch *b, u32 idx,
+			    u16 pw, u8 pri, bool chirp)
+{
+	int i;
+
+	if (dfs->long_rdr)
+		rtw89_dfs_chrp_mntr(dfs, chirp);
+
+	if (chirp) {
+		b->chrp_cnt++;
+		rtw89_dfs_range_add(&b->chrp_pw, pw);
+	}
+
+	for (i = 0; i < RTW89_DFS_RDR_TYPE_NUM; i++) {
+		const struct rtw89_dfs_bound *bnd = &b->bnd[i];
+		bool pw_ok = pw >= bnd->pw_lbd && pw <= bnd->pw_ubd;
+		bool pri_ok = pri >= bnd->pri_lbd && pri <= bnd->pri_ubd;
+
+		if (!bnd->ppb_th || !pw_ok)
+			continue;
+
+		if (i == RTW89_DFS_LONG_IDX && dfs->long_rdr) {
+			/* the interval of the first pulse is not a real one */
+			if (!chirp || (idx ? !pri_ok : !pri))
+				continue;
+
+			dfs->lng_rdr_cnt++;
+			rtw89_dfs_range_add(&b->lng_pw, pw);
+			continue;
+		}
+
+		if (!pri_ok)
+			continue;
+
+		if (dfs->etsi && i == RTW89_DFS_ETSI_CHIRP_IDX) {
+			if (!chirp)
+				continue;
+		} else if (chirp) {
+			continue;
+		}
+
+		b->cnt[i]++;
+		rtw89_dfs_range_add(&b->pw[i], pw);
+
+		/* ETSI types 5 and 6 use several intervals */
+		if (dfs->etsi && (i == RTW89_DFS_ETSI_TYPE5_IDX ||
+				  i == RTW89_DFS_ETSI_TYPE6_IDX))
+			continue;
+
+		if (idx)
+			rtw89_dfs_range_add(&b->pri[i], pri);
+	}
+}
+
+static int rtw89_dfs_detect(struct rtw89_dev *rtwdev, const u8 *data, u32 num)
+{
+	struct rtw89_dfs_info *dfs = &rtwdev->dfs;
+	struct rtw89_dfs_batch b;
+	int type = -1;
+	u32 i;
+
+	/* too few pulses for any radar without a long one */
+	if (!dfs->long_rdr && num < RTW89_DFS_FAKE_NUM_TH)
+		return -1;
+
+	dfs->stats.batches++;
+	rtw89_dfs_batch_init(dfs, &b);
+
+	for (i = 0; i < num; i++) {
+		u64 rpt = get_unaligned_le64(data + i * RTW89_DFS_RPT_LEN);
+		bool chirp = rpt & RTW89_DFS_RPT_CHIRP;
+		u8 pri = u64_get_bits(rpt, RTW89_DFS_RPT_PRI);
+		u16 pw = u64_get_bits(rpt, RTW89_DFS_RPT_PW);
+		u8 seq = u64_get_bits(rpt, RTW89_DFS_RPT_SEQ);
+
+		rtw89_debug(rtwdev, RTW89_DBG_DFS,
+			    "DFS pulse %016llx: pw %u pri %u chirp %d seq %u\n",
+			    rpt, pw, pri, chirp, seq);
+
+		rtw89_dfs_match(dfs, &b, i, pw, pri, chirp);
+
+		if (i && (dfs->last_seq == RTW89_DFS_SEQ_MAX ? seq != 0 :
+			  abs(seq - dfs->last_seq) > 1))
+			b.n_seq = true;
+		dfs->last_seq = seq;
+
+		b.pw_max = max(b.pw_max, pw);
+	}
+
+	if (dfs->long_rdr) {
+		if (rtw89_dfs_range_diff(&b.lng_pw) > dfs->pw_lng_chrp_diff_th ||
+		    rtw89_dfs_range_diff(&b.chrp_pw) > dfs->pw_lng_chrp_diff_th ||
+		    b.pw_max > RTW89_DFS_PW_MAX_TH ||
+		    b.chrp_cnt > RTW89_DFS_CHRP_CNT_TH)
+			dfs->lng_rdr_cnt = 0;
+
+		/* An increase by one pulse is not reliable. As in the vendor
+		 * driver, this also takes back the resets above.
+		 */
+		if ((int)dfs->lng_rdr_cnt - dfs->lng_rdr_cnt_pre <=
+		    RTW89_DFS_LONG_INC_TH)
+			dfs->lng_rdr_cnt = dfs->lng_rdr_cnt_pre;
+	}
+
+	for (i = 0; i < RTW89_DFS_RDR_TYPE_NUM; i++) {
+		const struct rtw89_dfs_bound *bnd = &b.bnd[i];
+
+		if (!bnd->ppb_th)
+			continue;
+
+		if (i == RTW89_DFS_LONG_IDX && dfs->long_rdr) {
+			if (dfs->lng_rdr_cnt >= bnd->ppb_th)
+				type = i;
+			continue;
+		}
+
+		if (b.cnt[i] < bnd->ppb_th ||
+		    rtw89_dfs_range_diff(&b.pw[i]) > dfs->pw_diff_th ||
+		    rtw89_dfs_range_diff(&b.pri[i]) > dfs->pri_diff_th)
+			continue;
+
+		type = i;
+	}
+
+	rtw89_debug(rtwdev, RTW89_DBG_DFS,
+		    "DFS batch: %u pulses, cnt %*ph, lng %u, chrp %u, pw_max %u, n_seq %d, type %d\n",
+		    num, RTW89_DFS_RDR_TYPE_NUM, b.cnt, dfs->lng_rdr_cnt,
+		    b.chrp_cnt, b.pw_max, b.n_seq, type);
+
+	if (type >= 0) {
+		/* drop what looks like false detection */
+		if (b.pw_max > RTW89_DFS_PW_MAX_TH) {
+			dfs->stats.drop_pw_max++;
+			type = -1;
+		} else if (rtw89_dfs_range_diff(&b.chrp_pw) > dfs->pw_lng_chrp_diff_th) {
+			dfs->stats.drop_chrp_diff++;
+			type = -1;
+		} else if (b.n_seq) {
+			dfs->stats.drop_seq++;
+			type = -1;
+		}
+	}
+
+	if (type >= 0) {
+		dfs->lng_rdr_cnt = 0;
+		dfs->stats.detected++;
+	}
+
+	dfs->lng_rdr_cnt_pre = dfs->lng_rdr_cnt;
+
+	return type;
+}
+
+void rtw89_dfs_rx_report(struct rtw89_dev *rtwdev, struct sk_buff *skb)
+{
+	struct rtw89_dfs_info *dfs = &rtwdev->dfs;
+	u32 num, drop;
+	int type = -1;
+
+	if (!dfs->supported || skb->len < RTW89_DFS_RPT_HDR_LEN)
+		goto out;
+
+	num = (skb->len - RTW89_DFS_RPT_HDR_LEN) / RTW89_DFS_RPT_LEN;
+	drop = u32_get_bits(get_unaligned_le32(skb->data),
+			    RTW89_DFS_RPT_HDR_DROP_NUM);
+
+	spin_lock(&dfs->lock);
+
+	dfs->stats.rpt_pkts++;
+	dfs->stats.pulses += num;
+	dfs->stats.hw_drops += drop;
+
+	if (!dfs->rpt_en || rtwdev->scanning || !rtw89_dfs_radar_enabled(rtwdev))
+		dfs->stats.ignored++;
+	else
+		type = rtw89_dfs_detect(rtwdev,
+					skb->data + RTW89_DFS_RPT_HDR_LEN, num);
+
+	spin_unlock(&dfs->lock);
+
+	if (type < 0)
+		goto out;
+
+	rtw89_info(rtwdev, "radar detected (%s type index %d)\n",
+		   rtw89_dfs_region_str(dfs->region), type);
+	ieee80211_radar_detected(rtwdev->hw, NULL);
+
+out:
+	dev_kfree_skb_any(skb);
+}
+
+void rtw89_dfs_simulate_radar(struct rtw89_dev *rtwdev)
+{
+	rtw89_info(rtwdev, "simulated radar\n");
+	ieee80211_radar_detected(rtwdev->hw, NULL);
+}
