diff --git drivers/net/wireless/realtek/rtw89/core.h drivers/net/wireless/realtek/rtw89/core.h
index 712cd40..ac997dd 100644
--- a/drivers/net/wireless/realtek/rtw89/core.h
+++ b/drivers/net/wireless/realtek/rtw89/core.h
@@ -5884,6 +5884,55 @@ struct rtw89_regulatory_info {
 	DECLARE_BITMAP(block_6ghz_vlp, RTW89_REGD_MAX_COUNTRY_NUM);
 };
 
+#define RTW89_DFS_RDR_TYPE_NUM 8
+
+struct rtw89_dfs_rdr_type {
+	u16 pw_min; /* unit: 200 ns */
+	u16 pw_max;
+	u8 pri_min; /* unit: 25 us */
+	u8 pri_max;
+	u8 ppb; /* pulses per burst; 0: unused */
+};
+
+struct rtw89_dfs_stats {
+	u32 rpt_pkts;
+	u32 pulses;
+	u32 hw_drops;
+	u32 batches;
+	u32 detected;
+	u32 drop_pw_max;
+	u32 drop_chrp_diff;
+	u32 drop_seq;
+	u32 ignored;
+};
+
+struct rtw89_dfs_info {
+	spinlock_t lock;
+	bool supported;
+	bool rpt_en;
+	bool chanctx_radar;
+	enum nl80211_dfs_regions region;
+	const struct rtw89_dfs_rdr_type *types;
+	bool long_rdr;
+	bool etsi;
+
+	bool idle;
+	u8 pw_factor;
+	u8 pri_factor;
+	u8 ppb_prcnt;
+	u16 pw_diff_th;
+	u16 pri_diff_th;
+	u16 pw_lng_chrp_diff_th;
+
+	bool chrp_obsrv;
+	unsigned long chrp_start;
+	u8 lng_rdr_cnt;
+	u8 lng_rdr_cnt_pre;
+	u8 last_seq;
+
+	struct rtw89_dfs_stats stats;
+};
+
 enum rtw89_ifs_clm_application {
 	RTW89_IFS_CLM_INIT = 0,
 	RTW89_IFS_CLM_BACKGROUND = 1,
@@ -6546,6 +6595,7 @@ struct rtw89_dev {
 	bool scanning;
 
 	struct rtw89_regulatory_info regulatory;
+	struct rtw89_dfs_info dfs;
 	struct rtw89_sar_info sar;
 	struct rtw89_tas_info tas;
 	struct rtw89_ant_gain_info ant_gain;
diff --git drivers/net/wireless/realtek/rtw89/debug.c drivers/net/wireless/realtek/rtw89/debug.c
index ca9712e..1209fa3 100644
--- a/drivers/net/wireless/realtek/rtw89/debug.c
+++ b/drivers/net/wireless/realtek/rtw89/debug.c
@@ -7,6 +7,7 @@
 
 #include "coex.h"
 #include "debug.h"
+#include "dfs.h"
 #include "fw.h"
 #include "mac.h"
 #include "pci.h"
@@ -94,6 +95,7 @@ struct rtw89_debugfs {
 	struct rtw89_debugfs_priv diag_mac;
 	struct rtw89_debugfs_priv diag_bb;
 	struct rtw89_debugfs_priv monitor_opts;
+	struct rtw89_debugfs_priv dfs;
 };
 
 struct rtw89_debugfs_iter_data {
@@ -5444,6 +5446,58 @@ rtw89_debug_priv_monitor_opts_set(struct rtw89_dev *rtwdev,
 	return count;
 }
 
+static ssize_t
+rtw89_debug_priv_dfs_get(struct rtw89_dev *rtwdev,
+			 struct rtw89_debugfs_priv *debugfs_priv,
+			 char *buf, size_t bufsz)
+{
+	struct rtw89_dfs_info *dfs = &rtwdev->dfs;
+	struct rtw89_dfs_stats *stats = &dfs->stats;
+	char *p = buf, *end = buf + bufsz;
+
+	if (!dfs->supported) {
+		p += scnprintf(p, end - p, "radar detection not supported\n");
+		return p - buf;
+	}
+
+	p += scnprintf(p, end - p, "region: %s\n",
+		       rtw89_dfs_region_str(dfs->region));
+	p += scnprintf(p, end - p, "report: %s, radar detection requested: %d\n",
+		       dfs->rpt_en ? "on" : "off",
+		       rtwdev->hw->conf.radar_enabled || dfs->chanctx_radar);
+	p += scnprintf(p, end - p, "mode: %s, long radar count: %u\n",
+		       dfs->idle ? "idle" : "traffic", dfs->lng_rdr_cnt);
+	p += scnprintf(p, end - p,
+		       "reports: %u, pulses: %u, hw drops: %u, batches: %u, ignored: %u\n",
+		       stats->rpt_pkts, stats->pulses, stats->hw_drops,
+		       stats->batches, stats->ignored);
+	p += scnprintf(p, end - p,
+		       "detected: %u, dropped: pw_max %u, chirp pw %u, seq %u\n",
+		       stats->detected, stats->drop_pw_max,
+		       stats->drop_chrp_diff, stats->drop_seq);
+	p += scnprintf(p, end - p, "\nwrite 1 to simulate a radar\n");
+
+	return p - buf;
+}
+
+static ssize_t
+rtw89_debug_priv_dfs_set(struct rtw89_dev *rtwdev,
+			 struct rtw89_debugfs_priv *debugfs_priv,
+			 const char *buf, size_t count)
+{
+	bool radar;
+	int ret;
+
+	ret = kstrtobool(buf, &radar);
+	if (ret)
+		return -EINVAL;
+
+	if (radar)
+		rtw89_dfs_simulate_radar(rtwdev);
+
+	return count;
+}
+
 #define rtw89_debug_priv_get(name, opts...)			\
 {								\
 	.cb_read = rtw89_debug_priv_ ##name## _get,		\
@@ -5509,6 +5563,7 @@ static const struct rtw89_debugfs rtw89_debugfs_templ = {
 	.diag_mac = rtw89_debug_priv_get(diag_mac, RSIZE_16K, RLOCK),
 	.diag_bb = rtw89_debug_priv_get(diag_bb, RSIZE_8K, RLOCK),
 	.monitor_opts = rtw89_debug_priv_set_and_get(monitor_opts, RWLOCK),
+	.dfs = rtw89_debug_priv_set_and_get(dfs, RWLOCK),
 };
 
 #define rtw89_debugfs_add(name, mode, fopname, parent)				\
@@ -5566,6 +5621,7 @@ void rtw89_debugfs_add_sec2(struct rtw89_dev *rtwdev, struct dentry *debugfs_top
 	rtw89_debugfs_add_r(diag_mac);
 	rtw89_debugfs_add_r(diag_bb);
 	rtw89_debugfs_add_rw(monitor_opts);
+	rtw89_debugfs_add_rw(dfs);
 }
 
 void rtw89_debugfs_init(struct rtw89_dev *rtwdev)
