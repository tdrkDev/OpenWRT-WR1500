 #include "phy.h"
@@ -3382,6 +3383,7 @@ int rtw89_chanctx_ops_add(struct rtw89_dev *rtwdev,
 	cfg->idx = idx;
 	cfg->ref_count = 0;
 	hal->chanctx[idx].cfg = cfg;
+	rtw89_dfs_chanctx_radar(rtwdev, ctx->radar_enabled);
 	return 0;
 }
 
@@ -3391,6 +3393,7 @@ void rtw89_chanctx_ops_remove(struct rtw89_dev *rtwdev,
 	struct rtw89_chanctx_cfg *cfg = (struct rtw89_chanctx_cfg *)ctx->drv_priv;
 
 	rtw89_config_entity_chandef(rtwdev, cfg->idx, NULL);
+	rtw89_dfs_chanctx_radar(rtwdev, false);
 }
 
 void rtw89_chanctx_ops_change(struct rtw89_dev *rtwdev,
@@ -3407,6 +3410,9 @@ void rtw89_chanctx_ops_change(struct rtw89_dev *rtwdev,
 
 	if (changed & IEEE80211_CHANCTX_CHANGE_PUNCTURING)
 		rtw89_chan_update_punctured(rtwdev, idx, &ctx->def);
+
+	if (changed & IEEE80211_CHANCTX_CHANGE_RADAR)
+		rtw89_dfs_chanctx_radar(rtwdev, ctx->radar_enabled);
 }
 
 int rtw89_chanctx_ops_assign_vif(struct rtw89_dev *rtwdev,
diff --git drivers/net/wireless/realtek/rtw89/core.c drivers/net/wireless/realtek/rtw89/core.c
index a8ee4c2..813bd9f 100644
--- a/drivers/net/wireless/realtek/rtw89/core.c
+++ b/drivers/net/wireless/realtek/rtw89/core.c
@@ -10,6 +10,7 @@
 #include "chan.h"
 #include "coex.h"
 #include "core.h"
+#include "dfs.h"
 #include "efuse.h"
 #include "fw.h"
 #include "mac.h"
@@ -205,6 +206,27 @@ static const struct ieee80211_iface_combination rtw89_iface_combs[] = {
 	},
 };
 
+#define RTW89_RADAR_DETECT_WIDTHS (BIT(NL80211_CHAN_WIDTH_20_NOHT) | \
+				   BIT(NL80211_CHAN_WIDTH_20) | \
+				   BIT(NL80211_CHAN_WIDTH_40) | \
+				   BIT(NL80211_CHAN_WIDTH_80))
+
+static const struct ieee80211_iface_combination rtw89_iface_combs_dfs[] = {
+	{
+		.limits = rtw89_iface_limits,
+		.n_limits = ARRAY_SIZE(rtw89_iface_limits),
+		.max_interfaces = RTW89_MAX_INTERFACE_NUM,
+		.num_different_channels = 1,
+		.radar_detect_widths = RTW89_RADAR_DETECT_WIDTHS,
+	},
+	{
+		.limits = rtw89_iface_limits_mcc,
+		.n_limits = ARRAY_SIZE(rtw89_iface_limits_mcc),
+		.max_interfaces = RTW89_MAX_INTERFACE_NUM,
+		.num_different_channels = 2,
+	},
+};
+
 static const u8 rtw89_ext_capa_sta[] = {
 	[0] = WLAN_EXT_CAPA1_EXT_CHANNEL_SWITCHING,
 	[2] = WLAN_EXT_CAPA3_MULTI_BSSID_SUPPORT,
@@ -575,6 +597,7 @@ int rtw89_set_channel(struct rtw89_dev *rtwdev)
 	rtw89_entity_get_conf(rtwdev, &conf);
 
 	__rtw89_set_channel(rtwdev, conf.chans[0], RTW89_MAC_0, RTW89_PHY_0);
+	rtw89_dfs_set_channel(rtwdev);
 
 	if (rtwdev->chip->chip_gen == RTW89_CHIP_AX)
 		return 0;
@@ -4066,6 +4089,9 @@ static void rtw89_core_rx_process_report(struct rtw89_dev *rtwdev,
 	case RTW89_CORE_RX_TYPE_PPDU_STAT:
 		rtw89_core_rx_process_ppdu_sts(rtwdev, desc_info, skb);
 		break;
+	case RTW89_CORE_RX_TYPE_DFS_REPORT:
+		rtw89_dfs_rx_report(rtwdev, skb);
+		break;
 	default:
 		rtw89_debug(rtwdev, RTW89_DBG_TXRX, "unhandled pkt_type=%d\n",
 			    desc_info->pkt_type);
@@ -5467,6 +5493,7 @@ static void rtw89_track_work(struct wiphy *wiphy, struct wiphy_work *work)
 	rtw89_phy_antdiv_track(rtwdev);
 	rtw89_phy_ul_tb_ctrl_track(rtwdev);
 	rtw89_phy_edcca_track(rtwdev);
+	rtw89_dfs_track(rtwdev);
 	rtw89_sar_track(rtwdev);
 	rtw89_chanctx_track(rtwdev);
 	rtw89_core_rfkill_poll(rtwdev, false);
@@ -6956,6 +6983,7 @@ int rtw89_core_init(struct rtw89_dev *rtwdev)
 	skb_queue_head_init(&rtwdev->c2h_queue);
 	rtw89_core_ppdu_sts_init(rtwdev);
 	rtw89_traffic_stats_init(rtwdev, &rtwdev->stats);
+	rtw89_dfs_init(rtwdev);
 
 	rtwdev->hal.rx_fltr = DEFAULT_AX_RX_FLTR;
 	rtwdev->dbcc_en = false;
@@ -7622,7 +7650,10 @@ struct rtw89_dev *rtw89_alloc_ieee80211_hw(struct device *device,
 		      RTW89_CHK_FW_FEATURE(NOTIFY_AP_INFO, &early_fw) &&
 		      RTW89_MLD_NON_STA_LINK_NUM == 1;
 
-	hw->wiphy->iface_combinations = rtw89_iface_combs;
+	if (rtw89_dfs_supported(variant))
+		hw->wiphy->iface_combinations = rtw89_iface_combs_dfs;
+	else
+		hw->wiphy->iface_combinations = rtw89_iface_combs;
 
