+static void rtw8832br_phycap_parsing_power_cal(struct rtw89_dev *rtwdev,
+					      u8 *phycap_map)
+{
+#define RTW8832BR_PWR_K_CHK_OFFSET 0x5E9
+#define RTW8832BR_PWR_K_CHK_VALUE 0xAA
+#define RTW8832BR_PROCESS_CHK_OFFSET 0x5EA
+#define RTW8832BR_PROCESS_CHK_T 0xFF
+	u32 addr = rtwdev->chip->phycap_addr;
+
+	if (phycap_map[RTW8832BR_PWR_K_CHK_OFFSET - addr] ==
+	    RTW8832BR_PWR_K_CHK_VALUE)
+		rtwdev->efuse.power_k_valid = true;
+
+	if (phycap_map[RTW8832BR_PROCESS_CHK_OFFSET - addr] ==
+	    RTW8832BR_PROCESS_CHK_T)
+		rtwdev->efuse.process_t = true;
+}
+
+static void rtw8832br_phycap_parsing_adc(struct rtw89_dev *rtwdev,
+					 u8 *phycap_map)
+{
+#define RTW8832BR_ADC_TD_OFFSET 0x5AF
+#define RTW8832BR_ADC_FT_OFFSET 0x5E3
+	struct rtw89_efuse *efuse = &rtwdev->efuse;
+	u32 addr = rtwdev->chip->phycap_addr;
+
+	efuse->adc_td = phycap_map[RTW8832BR_ADC_TD_OFFSET - addr] & 0x1f;
+	efuse->adc_ft = phycap_map[RTW8832BR_ADC_FT_OFFSET - addr];
+
+	rtw89_info(rtwdev, "ADC trim: ft 0x%02x td 0x%02x\n",
+		   efuse->adc_ft, efuse->adc_td);
+}
