 	rtw89_write32_set(rtwdev, R_AX_SYS_SDIO_CTRL, B_AX_PCIE_FORCE_PWR_NGAT);
@@ -2757,7 +2758,8 @@ static void rtw89_pci_l12_vmain(struct rtw89_dev *rtwdev)
 
 static void rtw89_pci_gen2_force_ib(struct rtw89_dev *rtwdev)
 {
-	if (!(rtwdev->chip->chip_id == RTL8852C && rtwdev->hal.cv == CHIP_CAV))
+	if (!(rtwdev->chip->chip_id == RTL8852C &&
+	      (rtwdev->hal.cv == CHIP_CAV || rtw89_is_rtl8832br(rtwdev))))
 		return;
 
 	rtw89_write32_set(rtwdev, R_AX_PMC_DBG_CTRL2,
diff --git drivers/net/wireless/realtek/rtw89/reg.h drivers/net/wireless/realtek/rtw89/reg.h
index 086ef77..5904954 100644
--- a/drivers/net/wireless/realtek/rtw89/reg.h
+++ b/drivers/net/wireless/realtek/rtw89/reg.h
@@ -44,6 +44,10 @@
 #define B_AX_SYM_PADPDN_WL_PTA_1P3 BIT(6)
 #define B_AX_SYM_PADPDN_WL_RFC_1P3 BIT(5)
 
+#define R_AX_ANAPAR_POW_MAC 0x0016
+#define B_AX_POW_PC_LDO_PORT1 BIT(3)
+#define B_AX_POW_PC_LDO_PORT0 BIT(2)
+
 #define R_AX_RSV_CTRL 0x001C
 #define B_AX_R_DIS_PRST BIT(6)
 #define B_AX_WLOCK_1C_BIT6 BIT(5)
@@ -149,6 +153,7 @@
 #define R_AX_WLLPS_CTRL 0x0090
 #define B_AX_LPSOP_ASWRM BIT(17)
 #define B_AX_LPSOP_DSWRM BIT(9)
+#define B_AX_LPSOP_DSWR BIT(8)
 #define B_AX_FORCE_LEAVE_LPS BIT(3)
 #define B_AX_DIS_WLBT_LPSEN_LOPC BIT(1)
 #define SW_LPS_OPTION 0x0001A0B2
@@ -178,6 +183,7 @@
 #define USB_SWITCH_DELAY 0xF
 
 #define R_AX_PMC_DBG_CTRL2 0x00CC
+#define B_AX_SYSON_DIS_WLR_AX_WRMSK BIT(3)
 #define B_AX_SYSON_DIS_PMCR_AX_WRMSK BIT(2)
 
 #define R_AX_PCIE_MIO_INTF 0x00E4
@@ -194,6 +200,7 @@
 
 #define R_AX_SYS_CFG1 0x00F0
 #define B_AX_CHIP_VER_MASK GENMASK(15, 12)
+#define B_AX_OPT1_ADIE BIT(9)
 
 #define R_AX_SYS_STATUS1 0x00F4
 #define B_AX_SEL_0XC0_MASK GENMASK(17, 16)
@@ -260,11 +267,20 @@
 #define R_AX_LDO_AON_CTRL0 0x0218
 #define B_AX_PD_REGU_L BIT(16)
 
+#define R_AX_SPS_ANA_ON_CTRL0 0x0220
+#define B_AX_VOL_L1_ANA_MASK GENMASK(3, 0)
+
 #define R_AX_SPSANA_ON_CTRL1 0x0224
 
 #define R_AX_SPS_ANA_ON_CTRL2 0x0228
 #define RTL8852B_RFE_05_SPS_ANA 0x4A82
 
+#define R_AX_SPS_ANALDO_ON_CTRL 0x0238
+#define B_AX_VOL_ANALDO_MASK GENMASK(5, 2)
+
+#define R_AX_AFE_ON_CTRL1 0x0244
+#define B_AX_REG_VCO_KVCO BIT(25)
+
 #define R_AX_WLAN_XTAL_SI_CTRL 0x0270
 #define B_AX_WL_XTAL_SI_CMD_POLL BIT(31)
 #define B_AX_BT_XTAL_SI_ERR_FLAG BIT(30)
@@ -308,10 +324,15 @@
 #define B_AX_PINMUX_EESK_FUNC_SEL_V1_MASK GENMASK(27, 24)
 #define PINMUX_EESK_FUNC_SEL_BT_LOG 0x1
 
+#define R_AX_GPIO0_15_EECS_EESK_LED1_PULL_HIGH_EN 0x02E0
+#define B_AX_GPIO11_PULL_HIGH_EN BIT(11)
+
 #define R_AX_GPIO0_15_EECS_EESK_LED1_PULL_LOW_EN 0x02E4
 #define B_AX_LED1_PULL_LOW_EN BIT(18)
 #define B_AX_EESK_PULL_LOW_EN BIT(17)
 #define B_AX_EECS_PULL_LOW_EN BIT(16)
+#define B_AX_GPIO11_PULL_LOW_EN BIT(11)
+#define B_AX_GPIO1_PULL_LOW_EN BIT(1)
 
 #define R_AX_GPIO0_16_EECS_EESK_LED1_PULL_LOW_EN 0x02E4
 #define B_AX_GPIO16_PULL_LOW_EN_V1 BIT(19)
@@ -2131,6 +2152,8 @@
 #define B_AX_R_SYM_FEN_WLBBGLB_1 BIT(17)
 #define B_AX_R_SYM_FEN_WLBBFUN_1 BIT(16)
 #define B_AX_R_SYM_ISO_CMAC12PP BIT(5)
+#define B_AX_R_SYM_ISO_P12PP BIT(6)
+#define B_AX_R_SYM_ISO_P02PP BIT(3)
 
 #define R_AX_SYSON_FSM_MON 0x00A0
 #define B_AX_FSM_MON_SEL_MASK GENMASK(26, 24)
diff --git drivers/net/wireless/realtek/rtw89/rtw8852c.c drivers/net/wireless/realtek/rtw89/rtw8852c.c
index 8082188..d29d8fb 100644
--- a/drivers/net/wireless/realtek/rtw89/rtw8852c.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8852c.c
@@ -20,6 +20,11 @@
 #define RTW8852C_MODULE_FIRMWARE \
 	RTW89_GEN_MODULE_FWNAME(RTW8852C_FW_BASENAME, RTW8852C_FW_FORMAT_MAX)
 
+#define RTW8832BR_FW_FORMAT_MAX 0
+#define RTW8832BR_FW_BASENAME "rtw89/rtw8832br_fw"
+#define RTW8832BR_MODULE_FIRMWARE \
+	RTW89_GEN_MODULE_FWNAME(RTW8832BR_FW_BASENAME, RTW8832BR_FW_FORMAT_MAX)
+
 static const struct rtw89_hfc_ch_cfg rtw8852c_hfc_chcfg_pcie[] = {
 	{13, 1614, grp_0}, /* ACH 0 */
 	{13, 1614, grp_0}, /* ACH 1 */
@@ -324,11 +329,156 @@ static void rtw8852c_ctrl_btg_bt_rx(struct rtw89_dev *rtwdev, bool en,
 static void rtw8852c_ctrl_tx_path_tmac(struct rtw89_dev *rtwdev, u8 tx_path,
 				       enum rtw89_mac_idx mac_idx);
 
+static void rtw8832br_pwr_on_trim(struct rtw89_dev *rtwdev)
+{
+	if (!rtwdev->efuse.valid || rtwdev->efuse.power_k_valid ||
+	    !rtwdev->efuse.process_t)
+		return;
+
+	if (rtw89_read32(rtwdev, R_AX_SYS_CFG1) & B_AX_OPT1_ADIE) {
+		rtw89_write32_mask(rtwdev, R_AX_SPS_ANA_ON_CTRL0,
+				   B_AX_VOL_L1_ANA_MASK, 0xA);
+		rtw89_write32_mask(rtwdev, R_AX_SPS_DIG_ON_CTRL0,
+				   B_AX_VOL_L1_MASK, 0x9);
+	} else {
+		rtw89_write32_mask(rtwdev, R_AX_SPS_ANALDO_ON_CTRL,
+				   B_AX_VOL_ANALDO_MASK, 0xA);
+		rtw89_write32_mask(rtwdev, R_AX_SPS_DIG_ON_CTRL0,
+				   B_AX_VOL_L1_MASK, 0x9);
+		rtw89_write32_mask(rtwdev, R_AX_SPS_ANA_ON_CTRL0,
+				   B_AX_VOL_L1_ANA_MASK, 0x8);
+	}
+}
+
+static int rtw8832br_pwr_on_func(struct rtw89_dev *rtwdev)
+{
+	u32 val32;
+	int ret;
+
+	rtw89_write32_clr(rtwdev, R_AX_SYS_PW_CTRL, B_AX_AFSM_WLSUS_EN |
+						    B_AX_AFSM_PCIE_SUS_EN);
+	rtw89_write32_set(rtwdev, R_AX_SYS_PW_CTRL, B_AX_DIS_WLBT_PDNSUSEN_SOPC);
+	rtw89_write32_set(rtwdev, R_AX_WLLPS_CTRL, B_AX_DIS_WLBT_LPSEN_LOPC);
+	rtw89_write32_set(rtwdev, R_AX_AFE_ON_CTRL1, B_AX_REG_VCO_KVCO);
+	rtw89_write32_clr(rtwdev, R_AX_SYS_PW_CTRL, B_AX_APDM_HPDN);
+	rtw89_write32_clr(rtwdev, R_AX_SYS_PW_CTRL, B_AX_APFM_SWLPS);
+
+	ret = read_poll_timeout(rtw89_read32, val32, val32 & B_AX_RDY_SYSPWR,
+				1000, 20000, false, rtwdev, R_AX_SYS_PW_CTRL);
+	if (ret)
+		return ret;
+
+	rtw89_write32_set(rtwdev, R_AX_SYS_PW_CTRL, B_AX_EN_WLON);
+	rtw89_write32_set(rtwdev, R_AX_SYS_PW_CTRL, B_AX_APFN_ONMAC);
+
+	ret = read_poll_timeout(rtw89_read32, val32, !(val32 & B_AX_APFN_ONMAC),
+				1000, 20000, false, rtwdev, R_AX_SYS_PW_CTRL);
+	if (ret)
+		return ret;
+
+	rtw89_write8_set(rtwdev, R_AX_ANAPAR_POW_MAC, B_AX_POW_PC_LDO_PORT0);
+	rtw89_write8_set(rtwdev, R_AX_ANAPAR_POW_MAC, B_AX_POW_PC_LDO_PORT1);
+
+	rtw89_write32_set(rtwdev, R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_WLR_AX_WRMSK);
+	rtw89_write32_clr(rtwdev, R_AX_SYS_ISO_CTRL_EXTEND, B_AX_R_SYM_ISO_P02PP);
+	rtw89_write32_clr(rtwdev, R_AX_SYS_ISO_CTRL_EXTEND, B_AX_R_SYM_ISO_P12PP);
+	rtw89_write32_clr(rtwdev, R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_WLR_AX_WRMSK);
+
+	rtw89_write8_set(rtwdev, R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+	rtw89_write8_clr(rtwdev, R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+	rtw89_write8_set(rtwdev, R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+	rtw89_write8_clr(rtwdev, R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+
+	rtw89_write8_set(rtwdev, R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+
+	rtw89_write32_clr(rtwdev, R_AX_SYS_SDIO_CTRL, B_AX_PCIE_CALIB_EN_V1);
+
+	rtw89_write32_set(rtwdev, R_AX_SYS_ADIE_PAD_PWR_CTRL, B_AX_SYM_PADPDN_WL_PTA_1P3);
+
+	ret = rtw89_mac_write_xtal_si(rtwdev, XTAL_SI_ANAPAR_WL,
+				      XTAL_SI_GND_SHDN_WL, XTAL_SI_GND_SHDN_WL);
+	if (ret)
+		return ret;
+
+	rtw89_write32_set(rtwdev, R_AX_SYS_ADIE_PAD_PWR_CTRL, B_AX_SYM_PADPDN_WL_RFC_1P3);
+
+	ret = rtw89_mac_write_xtal_si(rtwdev, XTAL_SI_ANAPAR_WL,
+				      XTAL_SI_SHDN_WL, XTAL_SI_SHDN_WL);
+	if (ret)
+		return ret;
+	ret = rtw89_mac_write_xtal_si(rtwdev, XTAL_SI_ANAPAR_WL, XTAL_SI_OFF_WEI,
+				      XTAL_SI_OFF_WEI);
+	if (ret)
+		return ret;
+	ret = rtw89_mac_write_xtal_si(rtwdev, XTAL_SI_ANAPAR_WL, XTAL_SI_OFF_EI,
+				      XTAL_SI_OFF_EI);
