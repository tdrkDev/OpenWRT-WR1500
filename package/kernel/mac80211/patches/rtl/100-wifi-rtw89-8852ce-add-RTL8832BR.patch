+/* RTL8832BR ADC settings: trimmed per chip by the ADC efuse values */
+struct rtw8832br_adc_cfg {
+	u8 idac2;	/* 0xff: keep */
+	u8 idac2_1;
+	u8 td;
+	u8 op5;
+	u8 rck;
+	u8 rck_cnt;	/* 0: keep */
+	u8 rst_cycle;	/* 0: keep */
+};
+
+static const struct rtw8832br_adc_cfg *
+rtw8832br_adc_cfg_get(struct rtw89_dev *rtwdev, u8 bw)
+{
+	static const struct rtw8832br_adc_cfg def_80 = {0xff, 0, 2, 0x5, 0x9, 0xa, 0};
+	static const struct rtw8832br_adc_cfg def = {0xff, 0, 3, 0xc, 0xc, 0, 0};
+	static const struct rtw8832br_adc_cfg untrimmed = {0xff, 0, 2, 0xf, 0x9, 0, 0};
+	static const struct {
+		u8 td;
+		struct rtw8832br_adc_cfg cfg;
+		struct rtw8832br_adc_cfg cfg_80;
+	} trims[] = {
+		{0x19, {8, 2, 2, 0x4, 0xf, 0xa, 3}, {8, 2, 2, 0x4, 0xf, 0xa, 3}},
+		{0x11, {8, 2, 2, 0x5, 0xf, 0xa, 3}, {8, 2, 2, 0x5, 0xf, 0xa, 3}},
+		{0x09, {8, 2, 2, 0x3, 0xf, 0xa, 3}, {8, 2, 2, 0x3, 0xf, 0xa, 3}},
+		{0x1b, {8, 2, 3, 0xc, 0xc, 0x9, 3}, {8, 2, 2, 0x5, 0x9, 0xa, 3}},
+		{0x1a, {5, 0, 3, 0xe, 0xf, 0x9, 3}, {8, 2, 2, 0x4, 0xf, 0xa, 3}},
+		{0x12, {5, 0, 3, 0xd, 0xf, 0x9, 3}, {8, 2, 2, 0x5, 0xf, 0xa, 3}},
+		{0x0a, {5, 0, 3, 0xc, 0xf, 0x9, 3}, {8, 2, 2, 0x3, 0xf, 0xa, 3}},
+	};
+	struct rtw89_efuse *efuse = &rtwdev->efuse;
+	bool bw80 = bw == RTW89_CHANNEL_WIDTH_80;
+	int i;
+
+	if (efuse->adc_ft == 0xff)
+		return bw80 ? &def_80 : &def;
+
+	if (efuse->adc_ft != 0xcc && efuse->adc_ft != 0xfc)
+		return bw80 ? &def_80 : &untrimmed;
+
+	for (i = 0; i < ARRAY_SIZE(trims); i++)
+		if (trims[i].td == efuse->adc_td)
+			return bw80 ? &trims[i].cfg_80 : &trims[i].cfg;
+
+	return bw80 ? &def_80 : &def;
+}
+
+static void rtw8832br_bw_setting(struct rtw89_dev *rtwdev, u8 bw, u8 path)
+{
+	const struct rtw8832br_adc_cfg *cfg = rtw8832br_adc_cfg_get(rtwdev, bw);
+	u32 ofst = path << 8;
+	u8 decim;
+
+	if (bw == RTW89_CHANNEL_WIDTH_5)
+		rtw89_phy_write32_mask(rtwdev, 0xc0e4 + ofst, 0x30, 0x0);
+	else if (bw == RTW89_CHANNEL_WIDTH_10)
+		rtw89_phy_write32_mask(rtwdev, 0xc0e4 + ofst, 0x30, 0x1);
+	else
+		rtw89_phy_write32_mask(rtwdev, 0xc0e4 + ofst, 0x30, 0x2);
+
+	if (cfg->idac2 != 0xff) {
+		rtw89_phy_write32_mask(rtwdev, 0xc0d4 + ofst, 0x780, cfg->idac2);
+		rtw89_phy_write32_mask(rtwdev, 0xc0d4 + ofst, 0x7800, cfg->idac2_1);
+	}
+	rtw89_phy_write32_mask(rtwdev, 0xc0d4 + ofst, GENMASK(27, 26), cfg->td);
+	rtw89_phy_write32_mask(rtwdev, 0xc0d8 + ofst, 0x1e0, cfg->op5);
+	rtw89_phy_write32_mask(rtwdev, 0xc0c4 + ofst, 0x3e0000, cfg->rck);
+	if (cfg->rck_cnt)
+		rtw89_phy_write32_mask(rtwdev, 0xc0e8 + ofst, 0xffff0000, cfg->rck_cnt);
+	if (cfg->rst_cycle)
+		rtw89_phy_write32_mask(rtwdev, 0xc0ec + ofst, 0xff0000, cfg->rst_cycle);
+
+	if (rtwdev->hal.cv == CHIP_CAV) {
+		/* ADC at 480 MHz */
+		rtw89_phy_write32_mask(rtwdev, 0x12a0 + (path << 13), 0xff800000, 0x49);
+		if (bw == RTW89_CHANNEL_WIDTH_5)
+			decim = 1;
+		else if (bw == RTW89_CHANNEL_WIDTH_10)
+			decim = 2;
+		else
+			decim = 0;
+	} else {
+		/* ADC at 960 MHz, decimated for narrow channels */
+		rtw89_phy_write32_mask(rtwdev, 0x12a0 + (path << 13), 0xff800000, 0x92);
+		rtw89_phy_write32_mask(rtwdev, 0xc000, BIT(18), 0);
+		if (bw == RTW89_CHANNEL_WIDTH_5 || bw == RTW89_CHANNEL_WIDTH_10)
+			decim = 1;
+		else if (bw == RTW89_CHANNEL_WIDTH_20 || bw == RTW89_CHANNEL_WIDTH_40)
+			decim = 2;
+		else
+			decim = 0;
+	}
+	rtw89_phy_write32_mask(rtwdev, 0xc0ec + ofst, 0x6000, decim);
+}
+
+static void rtw8832br_ctrl_bw(struct rtw89_dev *rtwdev, u8 bw)
+{
+	u8 val = bw == RTW89_CHANNEL_WIDTH_20 ? 0x2 : 0xc;
+
+	/* DFIR type: DFIR-0 for 20 MHz */
+	rtw89_phy_write32_mask(rtwdev, 0x4c00, BIT(4), bw != RTW89_CHANNEL_WIDTH_20);
+	rtw89_phy_write32_mask(rtwdev, 0x4cc4, BIT(4), bw != RTW89_CHANNEL_WIDTH_20);
+
+	/* pilot and data tracking loop filters */
+	rtw89_phy_write32_mask(rtwdev, 0x440c, 0xf8000, val);
+	rtw89_phy_write32_mask(rtwdev, 0x4df4, 0x1f, val);
+	rtw89_phy_write32_mask(rtwdev, 0x4404, 0xf8000, val);
+	rtw89_phy_write32_mask(rtwdev, 0x4da0, 0x3e000000, val);
+}
