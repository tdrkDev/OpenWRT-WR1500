From: Roman Rikhter <teledurak@gmail.com>
Subject: [PATCH] wifi: rtw89: stop the TX queue work with the core

rtw89_core_stop() cancels the delayed work that reinvokes the TX queue
work, but not the TX queue work itself. Since TX completions queue it,
the NAPI poll that runs last before rtw89_hci_stop() can queue it, and
it then runs while or after the MAC is powered off: at a wifi restart,
at an idle power save entry, or at an SER L2 reset, which stops the core
without stopping the queues of mac80211. With frames in the TX queues,
it reads the DMA indexes and writes the host index of a device that is
off. On hosts whose PCIe controller stalls the bus on MMIO to a device
that doesn't answer, like the one of the RTL8197F, that hangs the
system.

Don't run the TX queue work while the device isn't running, and don't
queue it from TX completion then. In rtw89_core_stop(), wait for a work
that started before, once NAPI is stopped, then cancel the reinvoke work
it may have armed. A TX queue that got frames while the device was
stopped would wait for more frames to be woken again, so queue the work
when the device runs again.

Signed-off-by: Roman Rikhter <teledurak@gmail.com>
---
diff --git drivers/net/wireless/realtek/rtw89/core.c drivers/net/wireless/realtek/rtw89/core.c
index e4f6fb5..b31e6df 100644
--- a/drivers/net/wireless/realtek/rtw89/core.c
+++ b/drivers/net/wireless/realtek/rtw89/core.c
@@ -4828,6 +4828,10 @@ static void rtw89_core_txq_work(struct work_struct *w)
 	bool reinvoke = false;
 	u8 ac;
 
+	/* it is queued again when the device runs again */
+	if (!test_bit(RTW89_FLAG_RUNNING, rtwdev->flags))
+		return;
+
 	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
 		rtw89_core_txq_schedule(rtwdev, ac, &reinvoke);
 
@@ -6634,6 +6638,9 @@ int rtw89_core_start(struct rtw89_dev *rtwdev)
 
 	set_bit(RTW89_FLAG_RUNNING, rtwdev->flags);
 
+	/* serve the TX queues scheduled while the device was stopped */
+	queue_work(rtwdev->txq_wq, &rtwdev->txq_work);
+
 	rtw89_chip_rfk_init_late(rtwdev);
 	rtw89_btc_ntfy_radio_state(rtwdev, BTC_RFCTRL_WL_ON);
 	rtw89_fw_h2c_fw_log(rtwdev, rtwdev->fw.log.enable);
@@ -6666,7 +6673,6 @@ void rtw89_core_stop(struct rtw89_dev *rtwdev)
 	wiphy_work_cancel(wiphy, &btc->arp_notify_work);
 	wiphy_work_cancel(wiphy, &btc->dhcp_notify_work);
 	wiphy_work_cancel(wiphy, &btc->icmp_notify_work);
-	cancel_delayed_work_sync(&rtwdev->txq_reinvoke_work);
 	wiphy_delayed_work_cancel(wiphy, &rtwdev->tx_wait_work);
 	wiphy_delayed_work_cancel(wiphy, &rtwdev->track_work);
 	wiphy_delayed_work_cancel(wiphy, &rtwdev->track_ps_work);
@@ -6683,6 +6689,9 @@ void rtw89_core_stop(struct rtw89_dev *rtwdev)
 	rtw89_hci_flush_queues(rtwdev, BIT(rtwdev->hw->queues) - 1, true);
 	rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1, true);
 	rtw89_hci_stop(rtwdev);
+	/* wait for a TX queue work that started before RUNNING was cleared */
+	cancel_work_sync(&rtwdev->txq_work);
+	cancel_delayed_work_sync(&rtwdev->txq_reinvoke_work);
 	rtw89_hci_deinit(rtwdev);
 	rtw89_mac_pwr_off(rtwdev);
 	rtw89_hci_reset(rtwdev);
diff --git drivers/net/wireless/realtek/rtw89/pci.c drivers/net/wireless/realtek/rtw89/pci.c
index 3da69e5..e519090 100644
--- a/drivers/net/wireless/realtek/rtw89/pci.c
+++ b/drivers/net/wireless/realtek/rtw89/pci.c
@@ -848,7 +848,7 @@ out_unlock:
 	spin_unlock_bh(&rtwpci->trx_lock);
 
 	/* frames left in the TX queues may wait for what was released */
-	if (cnt)
+	if (cnt && test_bit(RTW89_FLAG_RUNNING, rtwdev->flags))
 		queue_work(rtwdev->txq_wq, &rtwdev->txq_work);
 
 	/* always release all RPQ */
diff --git drivers/net/wireless/realtek/rtw89/ser.c drivers/net/wireless/realtek/rtw89/ser.c
index a507ce1..c2027ef 100644
--- a/drivers/net/wireless/realtek/rtw89/ser.c
+++ b/drivers/net/wireless/realtek/rtw89/ser.c
@@ -295,6 +295,9 @@ static void drv_resume_rx(struct rtw89_ser *ser)
 
 	set_bit(RTW89_FLAG_RUNNING, rtwdev->flags);
 	clear_bit(RTW89_SER_DRV_STOP_RX, ser->flags);
+
+	/* serve the TX queues scheduled while the device was stopped */
+	queue_work(rtwdev->txq_wq, &rtwdev->txq_work);
 }
 
 static void ser_reset_vif(struct rtw89_dev *rtwdev, struct rtw89_vif *rtwvif)
