From: Roman Rikhter <teledurak@gmail.com>
Subject: [PATCH] wifi: rtw89: pci: pass RX buffers up instead of copying

Every received frame is copied out of its RX buffer into a new skb, and
the buffer goes back to the ring. On a small CPU this copy is the most
expensive single step of the receive path: on an RTL8197F (MIPS 24Kc),
forwarding a 230 Mbit/s TCP stream received from a client, the copy
takes about a fifth of the CPU.

Put the buffers of the data ring into pages of their own and build the
skbs around them. A received WLAN frame then goes up in its buffer, and
the ring slot gets a new one. Short frames, reports and frames that need
more than one buffer are still copied, as is any frame for which no new
buffer can be allocated.

Because the frame head is a page fragment, mac80211 can split A-MSDUs
into fragments of the same page instead of copying the subframes.

Signed-off-by: Roman Rikhter <teledurak@gmail.com>
---
diff --git drivers/net/wireless/realtek/rtw89/pci.c drivers/net/wireless/realtek/rtw89/pci.c
index f0585f9..8e5da90 100644
--- a/drivers/net/wireless/realtek/rtw89/pci.c
+++ b/drivers/net/wireless/realtek/rtw89/pci.c
@@ -318,6 +318,86 @@ static u32 rtw89_pci_get_rx_skb_idx(struct rtw89_dev *rtwdev,
 	return wp;
 }
 
+/*
+ * RX buffers of the data ring sit in pages of their own, so that a frame can
+ * go up in its buffer while the ring gets a new one, instead of copying every
+ * frame out of the buffer. Short frames are still copied: cheaper than a new
+ * buffer.
+ */
+#define RTW89_PCI_RX_HEADROOM NET_SKB_PAD
+#define RTW89_PCI_RX_PAGE_ORDER \
+	get_order(RTW89_PCI_RX_HEADROOM + RTW89_PCI_RX_BUF_SIZE + \
+		  SKB_DATA_ALIGN(sizeof(struct skb_shared_info)))
+#define RTW89_PCI_RX_COPYBREAK 256
+
+static struct sk_buff *rtw89_pci_alloc_rx_page_skb(gfp_t gfp)
+{
+	unsigned int order = RTW89_PCI_RX_PAGE_ORDER;
+	struct sk_buff *skb;
+	struct page *page;
+
+	page = __dev_alloc_pages(gfp | __GFP_NOWARN, order);
+	if (!page)
+		return NULL;
+
+	skb = build_skb(page_address(page), PAGE_SIZE << order);
+	if (!skb) {
+		__free_pages(page, order);
+		return NULL;
+	}
+	skb_reserve(skb, RTW89_PCI_RX_HEADROOM);
+
+	return skb;
+}
+
+static int rtw89_pci_init_rx_bd(struct rtw89_dev *rtwdev, struct pci_dev *pdev,
+				struct rtw89_pci_rx_ring *rx_ring,
+				struct sk_buff *skb, int buf_sz, u32 idx);
+
+static bool rtw89_pci_rx_swap_skb(struct rtw89_dev *rtwdev,
+				  struct rtw89_pci_rx_ring *rx_ring, u32 idx,
+				  const struct rtw89_rx_desc_info *desc_info,
+				  u32 offset)
+{
+	struct rtw89_pci *rtwpci = (struct rtw89_pci *)rtwdev->priv;
+	struct sk_buff *skb = rx_ring->buf[idx];
+	struct rtw89_pci_rx_info *rx_info = RTW89_PCI_RX_SKB_CB(skb);
+	dma_addr_t dma = rx_info->dma;
+	struct sk_buff *new;
+
+	if (!rx_ring->page_buf ||
+	    desc_info->pkt_type != RTW89_CORE_RX_TYPE_WIFI ||
+	    desc_info->pkt_size < RTW89_PCI_RX_COPYBREAK ||
+	    rtwdev->hw->conf.flags & IEEE80211_CONF_MONITOR)
+		return false;
+
+	if (offset + desc_info->pkt_size != rx_info->len ||
+	    rx_info->len > rx_ring->buf_sz) {
+		rtw89_debug(rtwdev, RTW89_DBG_UNEXP,
+			    "rx len %u, offset %u + pkt size %u\n",
+			    rx_info->len, offset, desc_info->pkt_size);
+		return false;
+	}
+
+	new = rtw89_pci_alloc_rx_page_skb(GFP_ATOMIC);
+	if (!new)
+		return false;
+
+	if (rtw89_pci_init_rx_bd(rtwdev, rtwpci->pdev, rx_ring, new,
+				 rx_ring->buf_sz, idx)) {
+		dev_kfree_skb_any(new);
+		return false;
+	}
+	rx_ring->buf[idx] = new;
+
+	dma_unmap_single(&rtwpci->pdev->dev, dma, rx_ring->buf_sz,
+			 DMA_FROM_DEVICE);
+	skb_reserve(skb, offset);
+	skb_put(skb, desc_info->pkt_size);
+
+	return true;
+}
+
 static u32 rtw89_pci_rxbd_deliver_skbs(struct rtw89_dev *rtwdev,
 				       struct rtw89_pci_rx_ring *rx_ring)
 {
@@ -366,14 +446,23 @@ static u32 rtw89_pci_rxbd_deliver_skbs(struct rtw89_dev *rtwdev,
 
 		rtw89_chip_query_rxdesc(rtwdev, desc_info, skb->data, rxinfo_size);
 
+		/* first segment has RX desc */
+		offset = desc_info->offset + desc_info->rxd_len;
+
+		if (ls && rtw89_pci_rx_swap_skb(rtwdev, rx_ring, skb_idx,
+						desc_info, offset)) {
+			rtw89_pci_rxbd_increase(rx_ring, 1);
+			rtw89_core_rx(rtwdev, desc_info, skb);
+			desc_info->ready = false;
+
+			return cnt;
+		}
+
 		new = rtw89_alloc_skb_for_rx(rtwdev, desc_info->pkt_size);
 		if (!new)
 			goto err_sync_device;
 
 		rx_ring->diliver_skb = new;
-
-		/* first segment has RX desc */
-		offset = desc_info->offset + desc_info->rxd_len;
 	} else {
 		offset = sizeof(struct rtw89_pci_rxbd_info);
 		if (!new) {
@@ -3717,12 +3806,16 @@ static int rtw89_pci_alloc_rx_ring(struct rtw89_dev *rtwdev,
 		rx_ring->bd_ring.wp = 0;
 	rx_ring->bd_ring.rp = 0;
 	rx_ring->buf_sz = buf_sz;
+	rx_ring->page_buf = rxch == RTW89_RXCH_RXQ;
 	rx_ring->diliver_skb = NULL;
 	rx_ring->diliver_desc.ready = false;
 	rx_ring->target_rx_tag = 0;
 
 	for (i = 0; i < len; i++) {
-		skb = dev_alloc_skb(buf_sz);
+		if (rx_ring->page_buf)
+			skb = rtw89_pci_alloc_rx_page_skb(GFP_KERNEL);
+		else
+			skb = dev_alloc_skb(buf_sz);
 		if (!skb) {
 			ret = -ENOMEM;
 			goto err_free;
diff --git drivers/net/wireless/realtek/rtw89/pci.h drivers/net/wireless/realtek/rtw89/pci.h
index c3f2d0d..f78b888 100644
--- a/drivers/net/wireless/realtek/rtw89/pci.h
+++ b/drivers/net/wireless/realtek/rtw89/pci.h
@@ -1607,6 +1607,7 @@ struct rtw89_pci_rx_ring {
 	struct rtw89_pci_dma_ring bd_ring;
 	struct sk_buff *buf[RTW89_PCI_RXBD_NUM_MAX];
 	u32 buf_sz;
+	bool page_buf;
 	struct sk_buff *diliver_skb;
 	struct rtw89_rx_desc_info diliver_desc;
 	u32 target_rx_tag:13;
