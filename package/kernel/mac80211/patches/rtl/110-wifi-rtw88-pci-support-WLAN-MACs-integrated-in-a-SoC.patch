+/* WLAN MACs integrated in a SoC: the same HCI as the PCIe chips, but on
+ * the SoC bus. The glue driver of the SoC powers the block up before and
+ * down after these calls.
+ */
+static int rtw_pci_soc_read_efuse_map(struct rtw_dev *rtwdev, u8 *map,
+				      u32 size)
+{
+	struct rtw_pci *rtwpci = (struct rtw_pci *)rtwdev->priv;
+	u32 i, val = 0;
+
+	/* the calibration data lives in the efuse of the SoC, if anywhere */
+	memset(map, 0, size);
+	if (!rtwpci->efuse)
+		return 0;
+
+	for (i = 0; i < min(size, rtwpci->efuse_size); i++) {
+		if (!(i & 3))
+			val = readl(rtwpci->efuse + i);
+		map[i] = val >> ((i & 3) * 8);
+	}
+
+	return 0;
+}
+
+static const struct rtw_hci_ops rtw_pci_soc_ops = {
+	.tx_write = rtw_pci_tx_write,
+	.tx_kick_off = rtw_pci_tx_kick_off,
+	.flush_queues = rtw_pci_flush_queues,
+	.setup = rtw_pci_setup,
+	.start = rtw_pci_start,
+	.stop = rtw_pci_stop,
+	.deep_ps = rtw_pci_deep_ps,
+	.link_ps = rtw_pci_link_ps,
+	.interface_cfg = rtw_pci_interface_cfg,
+	.dynamic_rx_agg = NULL,
+	.write_firmware_page = rtw_write_firmware_page,
+	.read_efuse_map = rtw_pci_soc_read_efuse_map,
+
+	.read8 = rtw_pci_read8,
+	.read16 = rtw_pci_read16,
+	.read32 = rtw_pci_read32,
+	.write8 = rtw_pci_write8,
+	.write16 = rtw_pci_write16,
+	.write32 = rtw_pci_write32,
+	.write_data_rsvd_page = rtw_pci_write_data_rsvd_page,
+	.write_data_h2c = rtw_pci_write_data_h2c,
+};
+
+int rtw_pci_soc_probe(struct platform_device *pdev,
+		      const struct rtw_chip_info *chip)
+{
+	struct ieee80211_hw *hw;
+	struct rtw_dev *rtwdev;
+	struct rtw_pci *rtwpci;
+	struct resource *res;
+	int drv_data_size;
+	int ret;
+
+	drv_data_size = sizeof(struct rtw_dev) + sizeof(struct rtw_pci);
+	hw = ieee80211_alloc_hw(drv_data_size, &rtw_ops);
+	if (!hw) {
+		dev_err(&pdev->dev, "failed to allocate hw\n");
+		return -ENOMEM;
+	}
+
+	rtwdev = hw->priv;
+	rtwdev->hw = hw;
+	rtwdev->dev = &pdev->dev;
+	rtwdev->chip = chip;
+	rtwdev->hci.ops = &rtw_pci_soc_ops;
+	rtwdev->hci.type = RTW_HCI_TYPE_PCIE;
+	rtwdev->hci.rx_amsdu_3839 = true;
+
+	rtwpci = (struct rtw_pci *)rtwdev->priv;
+	atomic_set(&rtwpci->link_usage, 1);
+	rtwpci->rx_buf_size = RTK_SOC_RX_BUF_SIZE;
+
+	rtwpci->mmap = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(rtwpci->mmap)) {
+		ret = PTR_ERR(rtwpci->mmap);
+		goto err_release_hw;
+	}
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "efuse");
+	if (res) {
+		rtwpci->efuse = devm_ioremap_resource(&pdev->dev, res);
+		if (IS_ERR(rtwpci->efuse)) {
+			ret = PTR_ERR(rtwpci->efuse);
+			goto err_release_hw;
+		}
+		rtwpci->efuse_size = resource_size(res);
+	}
+
+	rtwpci->irq = platform_get_irq(pdev, 0);
+	if (rtwpci->irq < 0) {
+		ret = rtwpci->irq;
+		goto err_release_hw;
+	}
+
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto err_release_hw;
+
+	ret = rtw_core_init(rtwdev);
+	if (ret)
+		goto err_release_hw;
+
+	platform_set_drvdata(pdev, hw);
+	SET_IEEE80211_DEV(hw, &pdev->dev);
+
+	ret = rtw_pci_init(rtwdev);
+	if (ret) {
+		rtw_err(rtwdev, "failed to allocate pci resources\n");
+		goto err_deinit_core;
+	}
+
+	ret = rtw_pci_napi_init(rtwdev);
+	if (ret) {
+		rtw_err(rtwdev, "failed to setup NAPI\n");
+		goto err_pci_deinit;
+	}
+
+	ret = rtw_chip_info_setup(rtwdev);
+	if (ret) {
+		rtw_err(rtwdev, "failed to setup chip information\n");
+		goto err_napi_deinit;
+	}
+
+	ret = rtw_register_hw(rtwdev, hw);
+	if (ret) {
+		rtw_err(rtwdev, "failed to register hw\n");
+		goto err_napi_deinit;
+	}
+
+	ret = devm_request_threaded_irq(rtwdev->dev, rtwpci->irq,
+					rtw_pci_interrupt_handler,
+					rtw_pci_interrupt_threadfn,
+					0, KBUILD_MODNAME, rtwdev);
+	if (ret) {
+		rtw_err(rtwdev, "failed to request irq %d\n", ret);
+		ieee80211_unregister_hw(hw);
+		goto err_napi_deinit;
+	}
+
+	return 0;
+
+err_napi_deinit:
+	rtw_pci_napi_deinit(rtwdev);
+
+err_pci_deinit:
+	rtw_pci_deinit(rtwdev);
+
+err_deinit_core:
+	rtw_core_deinit(rtwdev);
+
+err_release_hw:
+	ieee80211_free_hw(hw);
+
+	return ret;
+}
+EXPORT_SYMBOL(rtw_pci_soc_probe);
+
+void rtw_pci_soc_remove(struct platform_device *pdev)
+{
+	struct ieee80211_hw *hw = platform_get_drvdata(pdev);
+	struct rtw_dev *rtwdev;
+	struct rtw_pci *rtwpci;
+
+	if (!hw)
+		return;
+
+	rtwdev = hw->priv;
+	rtwpci = (struct rtw_pci *)rtwdev->priv;
+
+	rtw_unregister_hw(rtwdev, hw);
+	rtw_pci_disable_interrupt(rtwdev, rtwpci);
+	devm_free_irq(rtwdev->dev, rtwpci->irq, rtwdev);
+	rtw_pci_napi_deinit(rtwdev);
+	rtw_pci_deinit(rtwdev);
+	rtw_core_deinit(rtwdev);
+	ieee80211_free_hw(hw);
+}
+EXPORT_SYMBOL(rtw_pci_soc_remove);
+
+void rtw_pci_soc_shutdown(struct platform_device *pdev)
+{
+	struct ieee80211_hw *hw = platform_get_drvdata(pdev);
+	struct rtw_dev *rtwdev;
+
+	if (!hw)
+		return;
+
+	rtwdev = hw->priv;
+	if (rtwdev->chip->ops->shutdown)
+		rtwdev->chip->ops->shutdown(rtwdev);
+}
+EXPORT_SYMBOL(rtw_pci_soc_shutdown);
