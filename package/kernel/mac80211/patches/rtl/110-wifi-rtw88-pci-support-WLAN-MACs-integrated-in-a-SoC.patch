 			BIT_RST_TRXDMA_INTF | BIT_RX_TAG_EN);
 	rtwpci->rx_tag = 0;
+
+	if (rtwpci->pdev)
+		return;
+
+	/* The queue stop bits of a SoC WLAN MAC keep their value across the
+	 * MAC power sequences. Release all queues, and run without DMA
+	 * prefetch and multiple tags as the vendor driver does.
+	 */
+	rtw_write32_clr(rtwdev, RTK_PCI_CTRL, BITS_TRXDMA_STOP);
+	rtw_write8_set(rtwdev, RTK_PCI_CTRL2, BITS_DIS_TRXDMA_PRE);
