From: Roman Rikhter <teledurak@gmail.com>
Subject: [PATCH] wifi: rtw88: add RTL8197G support

The 2.4 GHz 2T2R 802.11n WLAN MAC of the Realtek RTL8197F SoC is called
RTL8197G by the vendor driver. Its baseband and RF follow the RTL8822C
(the same PHY status, TX AGC and RF access), its MAC is a newer one
than the one of the 8822C, and it runs an access point firmware.

Add the chip, and the glue driver for the SoC: the system controller
gates the whole block, and any access to it before the gate is open
stalls the bus.

Differences to the 8822C handled in the core:
- the firmware download reports its checksum results in other bits of
  REG_MCUFW_CTRL, runs the CPU at clock select 2, needs no platform
  reset, and the firmware only sets its init ready bit, within 100 ms;
- the TX DMA queue map has 3 bit fields and two more queues;
- there is no H2C queue: H2C commands go through the mailbox, H2C
  packets are dropped;
- the DTIM counter of port 0 is at 0x5a4 (0x5a8 is a HIQ register);
- the HW sequence number field of the TX descriptor has 2 bits, mode 1
  is what the vendor driver uses;
- the firmware sends no TX reports: frames that need a status count as
  acked;
- there is no BT: coex is off, and the power on skips the pin setup of
  the combo chips.

The PHY tables are the ones of the vendor driver (BB/MAC release 20, RF
release 19), the channel, bandwidth and path setup follows its phydm
code. The vendor RF calibration (IQK, DPK, TSSI) is not ported yet: TX
power is open loop from the vendor's default indexes.

Signed-off-by: Roman Rikhter <teledurak@gmail.com>
---
diff --git drivers/net/wireless/realtek/rtw88/Kconfig drivers/net/wireless/realtek/rtw88/Kconfig
index f0427eb..550c96f 100644
--- a/drivers/net/wireless/realtek/rtw88/Kconfig
+++ b/drivers/net/wireless/realtek/rtw88/Kconfig
@@ -36,6 +36,10 @@ config RTW88_8822C
 	tristate
 	depends on m
 
+config RTW88_8197G
+	tristate
+	depends on m
+
 config RTW88_8723X
 	tristate
 	depends on m
@@ -120,6 +124,17 @@ config RTW88_8822CE
 
 	  802.11ac PCIe wireless network adapter
 
+config RTW88_8197GE
+	tristate "Realtek 8197GE (RTL8197F SoC) wireless network adapter"
+	depends on m
+	depends on PCI && OF && MFD_SYSCON
+	select RTW88_CORE
+	select RTW88_PCI
+	select RTW88_8197G
+	help
+	  Select this option will enable support for the 802.11n 2.4 GHz
+	  WLAN MAC of the Realtek RTL8197F SoC
+
 config RTW88_8822CS
 	tristate "Realtek 8822CS SDIO wireless network adapter"
 	depends on m
diff --git drivers/net/wireless/realtek/rtw88/Makefile drivers/net/wireless/realtek/rtw88/Makefile
index ab1c032..882d6b7 100644
--- a/drivers/net/wireless/realtek/rtw88/Makefile
+++ b/drivers/net/wireless/realtek/rtw88/Makefile
@@ -46,6 +46,12 @@ rtw88_8822cs-objs		:= rtw8822cs.o
 obj-$(CPTCFG_RTW88_8822CU)	+= rtw88_8822cu.o
 rtw88_8822cu-objs		:= rtw8822cu.o
 
+obj-$(CPTCFG_RTW88_8197G)	+= rtw88_8197g.o
+rtw88_8197g-objs		:= rtw8197g.o rtw8197g_table.o
+
+obj-$(CPTCFG_RTW88_8197GE)	+= rtw88_8197ge.o
+rtw88_8197ge-objs		:= rtw8197ge.o
+
 obj-$(CPTCFG_RTW88_8723X)	+= rtw88_8723x.o
 rtw88_8723x-objs		:= rtw8723x.o
 
diff --git drivers/net/wireless/realtek/rtw88/coex.c drivers/net/wireless/realtek/rtw88/coex.c
index 24da1cb..83e741d 100644
--- a/drivers/net/wireless/realtek/rtw88/coex.c
+++ b/drivers/net/wireless/realtek/rtw88/coex.c
@@ -464,6 +464,12 @@ static void rtw_coex_gnt_workaround(struct rtw_dev *rtwdev, bool force, u8 mode)
 	rtw_coex_set_gnt_fix(rtwdev);
 }
 
+/* the WLAN MAC of the RTL8197F SoC has no BT to coexist with */
+static bool rtw_coex_no_bt(struct rtw_dev *rtwdev)
+{
+	return rtwdev->chip->id == RTW_CHIP_TYPE_8197G;
+}
+
 static void rtw_coex_monitor_bt_ctr(struct rtw_dev *rtwdev)
 {
 	struct rtw_coex *coex = &rtwdev->coex;
@@ -2555,7 +2561,7 @@ static void rtw_coex_run_coex(struct rtw_dev *rtwdev, u8 reason)
 
 	lockdep_assert_held(&rtwdev->mutex);
 
-	if (!test_bit(RTW_FLAG_RUNNING, rtwdev->flags))
+	if (!test_bit(RTW_FLAG_RUNNING, rtwdev->flags) || rtw_coex_no_bt(rtwdev))
 		return;
 
 	coex_dm->reason = reason;
@@ -2770,6 +2776,9 @@ void rtw_coex_power_on_setting(struct rtw_dev *rtwdev)
 	coex->stop_dm = true;
 	coex->wl_rf_off = false;
 
+	if (rtw_coex_no_bt(rtwdev))
+		return;
+
 	/* enable BB, we can write 0x948 */
 	rtw_write8_set(rtwdev, REG_SYS_FUNC_EN,
 		       BIT_FEN_BB_GLB_RST | BIT_FEN_BB_RSTB);
@@ -2789,12 +2798,20 @@ EXPORT_SYMBOL(rtw_coex_power_on_setting);
 
 void rtw_coex_power_off_setting(struct rtw_dev *rtwdev)
 {
+	if (rtw_coex_no_bt(rtwdev))
+		return;
+
 	rtw_write16(rtwdev, REG_WIFI_BT_INFO, BIT_BT_INT_EN);
 }
 EXPORT_SYMBOL(rtw_coex_power_off_setting);
 
 void rtw_coex_init_hw_config(struct rtw_dev *rtwdev, bool wifi_only)
 {
+	if (rtw_coex_no_bt(rtwdev)) {
+		rtwdev->coex.stop_dm = true;
+		return;
+	}
+
 	__rtw_coex_init_hw_config(rtwdev, wifi_only);
 }
 EXPORT_SYMBOL(rtw_coex_init_hw_config);
@@ -3459,7 +3476,7 @@ void rtw_coex_wl_status_check(struct rtw_dev *rtwdev)
 	struct rtw_coex_stat *coex_stat = &rtwdev->coex.stat;
 
 	if ((coex_stat->wl_under_lps && !coex_stat->wl_force_lps_ctrl) ||
-	    coex_stat->wl_under_ips)
+	    coex_stat->wl_under_ips || rtw_coex_no_bt(rtwdev))
 		return;
 
 	rtw_coex_monitor_bt_ctr(rtwdev);
diff --git drivers/net/wireless/realtek/rtw88/fw.c drivers/net/wireless/realtek/rtw88/fw.c
index 945fedc..0e54252 100644
--- a/drivers/net/wireless/realtek/rtw88/fw.c
+++ b/drivers/net/wireless/realtek/rtw88/fw.c
@@ -510,6 +510,13 @@ static void rtw_fw_send_h2c_packet(struct rtw_dev *rtwdev, u8 *h2c_pkt)
 
 	lockdep_assert_held(&rtwdev->mutex);
 
+	/* the 8197G has no H2C queue set up, its firmware uses the mailbox */
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G) {
+		rtw_dbg(rtwdev, RTW_DBG_FW, "no H2C queue, packet %*ph dropped\n",
+			8, h2c_pkt);
+		return;
+	}
+
 	FW_OFFLOAD_H2C_SET_SEQ_NUM(h2c_pkt, rtwdev->h2c.seq);
 	ret = rtw_hci_write_data_h2c(rtwdev, h2c_pkt, H2C_PKT_SIZE);
 	if (ret)
diff --git drivers/net/wireless/realtek/rtw88/mac.c drivers/net/wireless/realtek/rtw88/mac.c
index eaa928b..54592f1 100644
--- a/drivers/net/wireless/realtek/rtw88/mac.c
+++ b/drivers/net/wireless/realtek/rtw88/mac.c
@@ -67,6 +67,12 @@ static int rtw_mac_pre_system_cfg(struct rtw_dev *rtwdev)
 
 	rtw_write8(rtwdev, REG_RSV_CTRL, 0);
 
+	/* The WLAN MAC of the RTL8197F SoC has no BT to share pins with, and
+	 * its vendor driver powers it on without further setup.
+	 */
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G)
+		return 0;
+
 	if (rtw_chip_wcpu_8051(rtwdev)) {
 		if (rtw_read32(rtwdev, REG_SYS_CFG1) & BIT_LDO)
 			rtw_write8(rtwdev, REG_LDO_SWR_CTRL, LDO_SEL);
@@ -333,13 +339,20 @@ static int __rtw_mac_init_system_cfg(struct rtw_dev *rtwdev)
 	u8 value8;
 	u32 value, tmp;
 
-	value = rtw_read32(rtwdev, REG_CPU_DMEM_CON);
-	value |= BIT_WL_PLATFORM_RST | BIT_DDMA_EN;
-	rtw_write32(rtwdev, REG_CPU_DMEM_CON, value);
+	/* The RTL8197G has neither the DDMA enable bit nor the platform
+	 * reset its vendor driver would need here, and no PHY request delay
+	 */
+	if (rtwdev->chip->id != RTW_CHIP_TYPE_8197G) {
+		value = rtw_read32(rtwdev, REG_CPU_DMEM_CON);
+		value |= BIT_WL_PLATFORM_RST | BIT_DDMA_EN;
+		rtw_write32(rtwdev, REG_CPU_DMEM_CON, value);
+	}
 
 	rtw_write8_set(rtwdev, REG_SYS_FUNC_EN + 1, sys_func_en);
-	value8 = (rtw_read8(rtwdev, REG_CR_EXT + 3) & 0xF0) | 0x0C;
-	rtw_write8(rtwdev, REG_CR_EXT + 3, value8);
+	if (rtwdev->chip->id != RTW_CHIP_TYPE_8197G) {
+		value8 = (rtw_read8(rtwdev, REG_CR_EXT + 3) & 0xF0) | 0x0C;
+		rtw_write8(rtwdev, REG_CR_EXT + 3, value8);
+	}
 
 	/* disable boot-from-flash for driver's DL FW */
 	tmp = rtw_read32(rtwdev, REG_MCUFW_CTRL);
@@ -468,7 +481,9 @@ static void download_firmware_reg_backup(struct rtw_dev *rtwdev,
 	bckp[bckp_idx].val = rtw_read8(rtwdev, REG_TXDMA_PQ_MAP + 1);
 	bckp_idx++;
 	tmp = RTW_DMA_MAPPING_HIGH << 6;
-	rtw_write8(rtwdev, REG_TXDMA_PQ_MAP + 1, tmp);
+	/* the 8197G map has other fields, and its download needs none */
+	if (rtwdev->chip->id != RTW_CHIP_TYPE_8197G)
+		rtw_write8(rtwdev, REG_TXDMA_PQ_MAP + 1, tmp);
 
 	/* DLFW only use HIQ, map HIQ to hi priority */
 	bckp[bckp_idx].len = 1;
@@ -608,11 +623,34 @@ int rtw_ddma_to_fw_fifo(struct rtw_dev *rtwdev, u32 ocp_src, u32 size)
 	return 0;
 }
 
+/* The 8197G reports download results in other bits of REG_MCUFW_CTRL */
+static bool
+check_fw_checksum_8197g(struct rtw_dev *rtwdev, u32 addr)
+{
+	bool ok = !(rtw_read32(rtwdev, REG_DDMA_CH0CTRL) & BIT_DDMACH0_CHKSUM_STS);
+	u8 fw_ctrl;
+
+	fw_ctrl = rtw_read8(rtwdev, REG_MCUFW_CTRL);
+	if (addr < OCPBASE_DMEM_88XX)
+		fw_ctrl = ok ? (fw_ctrl & ~BIT(4)) | BIT(3) : fw_ctrl | BIT(4);
+	else
+		fw_ctrl = ok ? (fw_ctrl & ~BIT(6)) | BIT(5) : fw_ctrl | BIT(6);
+	rtw_write8(rtwdev, REG_MCUFW_CTRL, fw_ctrl);
+
+	if (!ok)
+		rtw_err(rtwdev, "invalid fw checksum\n");
+
+	return ok;
+}
+
 static bool
 check_fw_checksum(struct rtw_dev *rtwdev, u32 addr)
 {
 	u8 fw_ctrl;
 
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G)
+		return check_fw_checksum_8197g(rtwdev, addr);
+
 	fw_ctrl = rtw_read8(rtwdev, REG_MCUFW_CTRL);
 
 	if (rtw_read32(rtwdev, REG_DDMA_CH0CTRL) & BIT_DDMACH0_CHKSUM_STS) {
@@ -713,7 +751,13 @@ start_download_firmware(struct rtw_dev *rtwdev, const u8 *data, u32 size)
 	imem_size += FW_HDR_CHKSUM_SIZE;
 	emem_size += emem_size ? FW_HDR_CHKSUM_SIZE : 0;
 
-	val = (u16)(rtw_read16(rtwdev, REG_MCUFW_CTRL) & 0x3800);
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G) {
+		/* the vendor driver runs the WLAN CPU at clock select 2 */
+		val = (u16)(rtw_read16(rtwdev, REG_MCUFW_CTRL) & 0x0800);
+		val |= u16_encode_bits(2, BIT_CPU_CLK_SEL);
+	} else {
+		val = (u16)(rtw_read16(rtwdev, REG_MCUFW_CTRL) & 0x3800);
+	}
 	val |= BIT_MCUFWDL_EN;
 	rtw_write16(rtwdev, REG_MCUFW_CTRL, val);
 
@@ -747,6 +791,14 @@ start_download_firmware(struct rtw_dev *rtwdev, const u8 *data, u32 size)
 static int download_firmware_validate(struct rtw_dev *rtwdev)
 {
 	u32 fw_key;
+	u16 val;
+
+	/* the 8197G firmware only sets its init ready bit, within ~100 ms */
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G)
+		return read_poll_timeout(rtw_read16, val,
+					 val & BIT_FW_INIT_RDY, 1000,
+					 200 * 1000, false,
+					 rtwdev, REG_MCUFW_CTRL);
 
 	if (!check_hw_ready(rtwdev, REG_MCUFW_CTRL, FW_READY_MASK, FW_READY)) {
 		fw_key = rtw_read32(rtwdev, REG_FW_DBG7) & FW_KEY_MASK;
@@ -764,6 +816,11 @@ static void download_firmware_end_flow(struct rtw_dev *rtwdev)
 
 	rtw_write32(rtwdev, REG_TXDMA_STATUS, BTI_PAGE_OVF);
 
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G) {
+		rtw_write8_clr(rtwdev, REG_MCUFW_CTRL, BIT_MCUFWDL_EN);
+		return;
+	}
+
 	/* Check IMEM & DMEM checksum is OK or not */
 	fw_ctrl = rtw_read16(rtwdev, REG_MCUFW_CTRL);
 	if ((fw_ctrl & BIT_CHECK_SUM_OK) != BIT_CHECK_SUM_OK)
@@ -792,7 +849,10 @@ static int __rtw_download_firmware(struct rtw_dev *rtwdev,
 	wlan_cpu_enable(rtwdev, false);
 
 	download_firmware_reg_backup(rtwdev, bckp);
-	download_firmware_reset_platform(rtwdev);
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G)
+		rtw_write8_set(rtwdev, REG_SYS_CLK_CTRL + 1, BIT_CPU_CLK_EN >> 8);
+	else
+		download_firmware_reset_platform(rtwdev);
 
 	ret = start_download_firmware(rtwdev, data, size);
 	if (ret)
@@ -1112,6 +1172,19 @@ static int txdma_queue_mapping(struct rtw_dev *rtwdev)
 	}
 
 	rtwdev->fifo.rqpn = rqpn;
+	if (chip->id == RTW_CHIP_TYPE_8197G) {
+		/* 3 bit wide fields, the map of the vendor driver's MAC v3 */
+		u32 map = BIT_RXSHFT_EN;
+
+		map |= u32_encode_bits(rqpn->dma_map_hi, GENMASK(21, 19));
+		map |= u32_encode_bits(rqpn->dma_map_mg, GENMASK(18, 16));
+		map |= u32_encode_bits(rqpn->dma_map_bk, GENMASK(15, 13));
+		map |= u32_encode_bits(rqpn->dma_map_be, GENMASK(12, 10));
+		map |= u32_encode_bits(rqpn->dma_map_vi, GENMASK(9, 7));
+		map |= u32_encode_bits(rqpn->dma_map_vo, GENMASK(6, 4));
+		rtw_write32(rtwdev, REG_TXDMA_PQ_MAP, map);
+		goto enable_trx;
+	}
 	txdma_pq_map |= BIT_TXDMA_HIQ_MAP(rqpn->dma_map_hi);
 	txdma_pq_map |= BIT_TXDMA_MGQ_MAP(rqpn->dma_map_mg);
 	txdma_pq_map |= BIT_TXDMA_BKQ_MAP(rqpn->dma_map_bk);
@@ -1120,6 +1193,8 @@ static int txdma_queue_mapping(struct rtw_dev *rtwdev)
 	txdma_pq_map |= BIT_TXDMA_VOQ_MAP(rqpn->dma_map_vo);
 	rtw_write16(rtwdev, REG_TXDMA_PQ_MAP, txdma_pq_map);
 
+enable_trx:
+
 	rtw_write8(rtwdev, REG_CR, 0);
 	rtw_write8(rtwdev, REG_CR, MAC_TRX_ENABLE);
 	if (rtw_chip_wcpu_3081(rtwdev))
@@ -1201,6 +1276,11 @@ static int __priority_queue_cfg(struct rtw_dev *rtwdev,
 	rtw_write16(rtwdev, REG_FIFOPAGE_INFO_3, pg_tbl->nq_num);
 	rtw_write16(rtwdev, REG_FIFOPAGE_INFO_4, pg_tbl->exq_num);
 	rtw_write16(rtwdev, REG_FIFOPAGE_INFO_5, pubq_num);
+	/* the two extra queues of the 8197G get no pages */
+	if (chip->id == RTW_CHIP_TYPE_8197G) {
+		rtw_write16(rtwdev, REG_FIFOPAGE_INFO_6, 0);
+		rtw_write16(rtwdev, REG_FIFOPAGE_INFO_7, 0);
+	}
 	rtw_write32_set(rtwdev, REG_RQPN_CTRL_2, BIT_LD_RQPN);
 
 	rtw_write16(rtwdev, REG_FIFOPAGE_CTRL_2, fifo->rsvd_boundary);
@@ -1308,7 +1388,9 @@ static int init_h2c(struct rtw_dev *rtwdev)
 	u32 h2cq_free;
 	u32 wp, rp;
 
-	if (rtw_chip_wcpu_8051(rtwdev))
+	/* the 8197G firmware only takes H2C commands from the mailbox */
+	if (rtw_chip_wcpu_8051(rtwdev) ||
+	    rtwdev->chip->id == RTW_CHIP_TYPE_8197G)
 		return 0;
 
 	h2cq_addr = fifo->rsvd_h2cq_addr << TX_PAGE_SIZE_SHIFT;
diff --git drivers/net/wireless/realtek/rtw88/main.c drivers/net/wireless/realtek/rtw88/main.c
index eb5d1cb..29523b6 100644
--- a/drivers/net/wireless/realtek/rtw88/main.c
+++ b/drivers/net/wireless/realtek/rtw88/main.c
@@ -733,8 +733,14 @@ EXPORT_SYMBOL(rtw_set_rx_freq_band);
 
 void rtw_set_dtim_period(struct rtw_dev *rtwdev, u8 dtim_period)
 {
+	u32 addr = REG_DTIM_COUNTER_ROOT;
+
+	/* 0x5a8 is a HIQ register on the 8197G */
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G)
+		addr = REG_DTIM_COUNT_GROUP1;
+
 	rtw_write32_set(rtwdev, REG_TCR, BIT_TCR_UPDATE_TIMIE);
-	rtw_write8(rtwdev, REG_DTIM_COUNTER_ROOT, dtim_period ? dtim_period - 1 : 0);
+	rtw_write8(rtwdev, addr, dtim_period ? dtim_period - 1 : 0);
 }
 
 void rtw_update_channel(struct rtw_dev *rtwdev, u8 center_channel,
@@ -1935,7 +1941,9 @@ static int rtw_chip_efuse_enable(struct rtw_dev *rtwdev)
 		goto err;
 	}
 
-	rtw_write8(rtwdev, REG_C2HEVT, C2H_HW_FEATURE_DUMP);
+	/* the 8197G firmware knows no feature dump, leave its C2H free */
+	if (rtwdev->chip->id != RTW_CHIP_TYPE_8197G)
+		rtw_write8(rtwdev, REG_C2HEVT, C2H_HW_FEATURE_DUMP);
 
 	wait_for_completion(&fw->completion);
 	if (!fw->firmware) {
diff --git drivers/net/wireless/realtek/rtw88/main.h drivers/net/wireless/realtek/rtw88/main.h
index 5329d8c..94dedeb 100644
--- a/drivers/net/wireless/realtek/rtw88/main.h
+++ b/drivers/net/wireless/realtek/rtw88/main.h
@@ -200,6 +200,7 @@ enum rtw_chip_type {
 	RTW_CHIP_TYPE_8821A,
 	RTW_CHIP_TYPE_8812A,
 	RTW_CHIP_TYPE_8814A,
+	RTW_CHIP_TYPE_8197G,
 };
 
 enum rtw_tx_queue_type {
diff --git drivers/net/wireless/realtek/rtw88/pci.c drivers/net/wireless/realtek/rtw88/pci.c
index 9129bf1..1459563 100644
--- a/drivers/net/wireless/realtek/rtw88/pci.c
+++ b/drivers/net/wireless/realtek/rtw88/pci.c
@@ -1014,7 +1014,8 @@ static void rtw_pci_tx_isr(struct rtw_dev *rtwdev, struct rtw_pci *rtwpci,
 		info = IEEE80211_SKB_CB(skb);
 
 		/* enqueue to wait for tx report */
-		if (info->flags & IEEE80211_TX_CTL_REQ_TX_STATUS) {
+		if (info->flags & IEEE80211_TX_CTL_REQ_TX_STATUS &&
+		    rtw_tx_report_supported(rtwdev)) {
 			rtw_tx_report_enqueue(rtwdev, skb, tx_data->sn);
 			continue;
 		}
diff --git drivers/net/wireless/realtek/rtw88/reg.h drivers/net/wireless/realtek/rtw88/reg.h
index 08e9494..46c3019 100644
--- a/drivers/net/wireless/realtek/rtw88/reg.h
+++ b/drivers/net/wireless/realtek/rtw88/reg.h
@@ -352,6 +352,8 @@
 #define REG_FIFOPAGE_INFO_3	0x0238
 #define REG_FIFOPAGE_INFO_4	0x023C
 #define REG_FIFOPAGE_INFO_5	0x0240
+#define REG_FIFOPAGE_INFO_6	0x0268
+#define REG_FIFOPAGE_INFO_7	0x026C
 #define REG_H2C_HEAD		0x0244
 #define REG_H2C_TAIL		0x0248
 #define REG_H2C_READ_ADDR	0x024C
@@ -491,6 +493,8 @@
 #define BIT_DIS_SECOND_CCA	(BIT(0) | BIT(1))
 #define REG_HIQ_NO_LMT_EN	0x5A7
 #define REG_DTIM_COUNTER_ROOT	0x5A8
+#define REG_DTIM_COUNT_GROUP1	0x5A4
+#define REG_HIQ_NO_LMT_EN_V2	0x5A8
 #define BIT_HIQ_NO_LMT_EN_ROOT	BIT(0)
 #define REG_TIMER0_SRC_SEL	0x05B4
 #define BIT_TSFT_SEL_TIMER0	(BIT(4) | BIT(5) | BIT(6))
diff --git drivers/net/wireless/realtek/rtw88/rtw8197g.c drivers/net/wireless/realtek/rtw88/rtw8197g.c
new file mode 100644
index 0000000..691309b
--- /dev/null
+++ b/drivers/net/wireless/realtek/rtw88/rtw8197g.c
@@ -0,0 +1,1524 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/* Copyright(c) 2018-2019  Realtek Corporation
+ */
+
+#include <linux/module.h>
+#include "main.h"
+#include "coex.h"
+#include "fw.h"
+#include "tx.h"
+#include "rx.h"
+#include "phy.h"
+#include "rtw8197g.h"
+#include "rtw8197g_table.h"
+#include "mac.h"
+#include "reg.h"
+#include "debug.h"
+#include "util.h"
+#include "efuse.h"
+
+/* The vendor driver runs this chip without power, thermal or crystal
+ * calibration data: all it has are RF trims in the SoC efuse. These are
+ * the indexes it falls back to.
+ */
+#define RTW8197G_DEF_CCK_IDX	100
+#define RTW8197G_DEF_OFDM_IDX	0x5a
+
+static void rtw8197g_config_trx_mode(struct rtw_dev *rtwdev, u8 tx_path,
+				     u8 rx_path, bool is_tx2_path);
+
+static int rtw8197g_read_efuse(struct rtw_dev *rtwdev, u8 *log_map)
+{
+	struct rtw_efuse *efuse = &rtwdev->efuse;
+	struct rtw_hal *hal = &rtwdev->hal;
+	int i, j;
+
+	rtw_dbg(rtwdev, RTW_DBG_EFUSE,
+		"trims: tssi %*ph lna %*ph thermal %02x/%02x power %02x %02x %02x pa %02x\n",
+		4, &log_map[EFUSE_TSSI_TRIM_2GL_A], 2, &log_map[EFUSE_LNA_TRIM_A],
+		log_map[EFUSE_THERMAL_TRIM_A], log_map[0x27],
+		log_map[EFUSE_PWR_TRIM_2GL], log_map[0x51], log_map[0x55],
+		log_map[EFUSE_PA_BIAS]);
+
+	efuse->rfe_option = 0;
+	efuse->rf_board_option = 0;
+	efuse->channel_plan = 0xff;
+	efuse->country_code[0] = 0xff;
+	efuse->country_code[1] = 0xff;
+	efuse->regd = 0;
+	efuse->thermal_meter[RF_PATH_A] = 0xff;
+	efuse->thermal_meter[RF_PATH_B] = 0xff;
+	efuse->thermal_meter_k = 0xff;
+	/* no thermal base, so no power tracking */
+	efuse->power_track_type = 0xff;
+
+	/* keep the crystal cap the boot code left */
+	efuse->crystal_cap = rtw_read32_mask(rtwdev, REG_XCAP_XI, BIT_XCAP_XI);
+
+	for (i = 0; i < RTW_RF_PATH_MAX; i++) {
+		struct rtw_2g_txpwr_idx *idx = &efuse->txpwr_idx_table[i].pwr_idx_2g;
+
+		memset(&efuse->txpwr_idx_table[i], 0,
+		       sizeof(efuse->txpwr_idx_table[i]));
+		for (j = 0; j < ARRAY_SIZE(idx->cck_base); j++)
+			idx->cck_base[j] = RTW8197G_DEF_CCK_IDX;
+		for (j = 0; j < ARRAY_SIZE(idx->bw40_base); j++)
+			idx->bw40_base[j] = RTW8197G_DEF_OFDM_IDX;
+	}
+
+	efuse->hw_cap.bw = BIT(RTW_CHANNEL_WIDTH_20) | BIT(RTW_CHANNEL_WIDTH_40);
+	efuse->hw_cap.hci = 0;
+	efuse->hw_cap.nss = hal->rf_path_num;
+	efuse->hw_cap.ptcl = EFUSE_HW_CAP_IGNORE;
+	efuse->hw_cap.ant_num = hal->rf_path_num;
+
+	return 0;
+}
+
+static void rtw8197g_header_file_init(struct rtw_dev *rtwdev, bool pre)
+{
+	rtw_write32_set(rtwdev, REG_3WIRE, BIT_3WIRE_TX_EN | BIT_3WIRE_RX_EN);
+	rtw_write32_set(rtwdev, REG_3WIRE, BIT_3WIRE_PI_ON);
+	rtw_write32_set(rtwdev, REG_3WIRE2, BIT_3WIRE_TX_EN | BIT_3WIRE_RX_EN);
+	rtw_write32_set(rtwdev, REG_3WIRE2, BIT_3WIRE_PI_ON);
+
+	if (pre)
+		rtw_write32_clr(rtwdev, REG_ENCCK, BIT_CCK_OFDM_BLK_EN);
+	else
+		rtw_write32_set(rtwdev, REG_ENCCK, BIT_CCK_OFDM_BLK_EN);
+}
+
+static void rtw8197g_bb_reset(struct rtw_dev *rtwdev)
+{
+	rtw_write16_set(rtwdev, REG_SYS_FUNC_EN, BIT_FEN_BB_RSTB);
+	rtw_write16_clr(rtwdev, REG_SYS_FUNC_EN, BIT_FEN_BB_RSTB);
+	rtw_write16_set(rtwdev, REG_SYS_FUNC_EN, BIT_FEN_BB_RSTB);
+}
+
+static void rtw8197g_pwrtrack_init(struct rtw_dev *rtwdev)
+{
+	struct rtw_dm_info *dm_info = &rtwdev->dm_info;
+	u8 path;
+
+	for (path = RF_PATH_A; path < RTW_RF_PATH_MAX; path++) {
+		dm_info->delta_power_index[path] = 0;
+		ewma_thermal_init(&dm_info->avg_thermal[path]);
+		dm_info->thermal_avg[path] = 0xff;
+	}
+
+	dm_info->pwr_trk_triggered = false;
+	dm_info->thermal_meter_k = rtwdev->efuse.thermal_meter_k;
+	dm_info->thermal_meter_lck = rtwdev->efuse.thermal_meter_k;
+}
+
+static void rtw8197g_phy_set_param(struct rtw_dev *rtwdev)
+{
+	struct rtw_dm_info *dm_info = &rtwdev->dm_info;
+	struct rtw_hal *hal = &rtwdev->hal;
+	u8 cck_gi_u_bnd_msb = 0;
+	u8 cck_gi_u_bnd_lsb = 0;
+	u8 cck_gi_l_bnd_msb = 0;
+	u8 cck_gi_l_bnd_lsb = 0;
+
+	/* power on BB/RF domain, as the vendor driver does */
+	rtw_write16_set(rtwdev, REG_SYS_FUNC_EN,
+			BIT(13) | BIT_FEN_BB_GLB_RST | BIT_FEN_BB_RSTB);
+	rtw_write8(rtwdev, REG_RF_CTRL,
+		   BIT_RF_EN | BIT_RF_RSTB | BIT_RF_SDM_RSTB);
+
+	/* pre init before header files config */
+	rtw8197g_header_file_init(rtwdev, true);
+
+	rtw_phy_load_tables(rtwdev);
+
+	/* post init after header files config */
+	rtw8197g_header_file_init(rtwdev, false);
+
+	/* RFE type 0: the WLAN MAC drives its own front end pins */
+	rtw_write32_clr(rtwdev, REG_LED_CFG, BIT(24));
+	rtw_write32_clr(rtwdev, REG_PAD_CTRL1,
+			BIT_PAPE_WLBT_SEL | BIT_LNAON_WLBT_SEL);
+
+	/* CCK and 1ss OFDM go out on both paths, like the vendor driver */
+	rtw8197g_config_trx_mode(rtwdev, hal->antenna_tx, hal->antenna_rx,
+				 true);
+	rtw_phy_init(rtwdev);
+
+	cck_gi_u_bnd_msb = (u8)rtw_read32_mask(rtwdev, 0x1a98, 0xc000);
+	cck_gi_u_bnd_lsb = (u8)rtw_read32_mask(rtwdev, 0x1aa8, 0xf0000);
+	cck_gi_l_bnd_msb = (u8)rtw_read32_mask(rtwdev, 0x1a98, 0xc0);
+	cck_gi_l_bnd_lsb = (u8)rtw_read32_mask(rtwdev, 0x1a70, 0x0f000000);
+
+	dm_info->cck_gi_u_bnd = ((cck_gi_u_bnd_msb << 4) | (cck_gi_u_bnd_lsb));
+	dm_info->cck_gi_l_bnd = ((cck_gi_l_bnd_msb << 4) | (cck_gi_l_bnd_lsb));
+
+	rtw8197g_pwrtrack_init(rtwdev);
+}
+
+#define WLAN_TXQ_RPT_EN		0x1F
+#define WLAN_SLOT_TIME		0x09
+#define WLAN_PIFS_TIME		0x1C
+#define WLAN_SIFS_CCK_CONT_TX	0x0A
+#define WLAN_SIFS_OFDM_CONT_TX	0x0E
+#define WLAN_SIFS_CCK_TRX	0x0A
+#define WLAN_SIFS_OFDM_TRX	0x10
+#define WLAN_NAV_MAX		0xC8
+#define WLAN_RDG_NAV		0x05
+#define WLAN_TXOP_NAV		0x1B
+#define WLAN_CCK_RX_TSF		0x30
+#define WLAN_OFDM_RX_TSF	0x30
+#define WLAN_TBTT_PROHIBIT	0x04 /* unit : 32us */
+#define WLAN_TBTT_HOLD_TIME	0x064 /* unit : 32us */
+#define WLAN_DRV_EARLY_INT	0x04
+#define WLAN_BCN_CTRL_CLT0	0x10
+#define WLAN_BCN_DMA_TIME	0x02
+#define WLAN_BCN_MAX_ERR	0xFF
+#define WLAN_SIFS_CCK_DUR_TUNE	0x0A
+#define WLAN_SIFS_OFDM_DUR_TUNE	0x10
+#define WLAN_SIFS_CCK_CTX	0x0A
+#define WLAN_SIFS_CCK_IRX	0x0A
+#define WLAN_SIFS_OFDM_CTX	0x0E
+#define WLAN_SIFS_OFDM_IRX	0x0E
+#define WLAN_EIFS_DUR_TUNE	0x40
+#define WLAN_EDCA_VO_PARAM	0x002FA226
+#define WLAN_EDCA_VI_PARAM	0x005EA328
+#define WLAN_EDCA_BE_PARAM	0x005EA42B
+#define WLAN_EDCA_BK_PARAM	0x0000A44F
+
+#define WLAN_RX_FILTER0		0xFFFFFFFF
+#define WLAN_RX_FILTER2		0xFFFF
+#define WLAN_RCR_CFG		0xE400220E
+#define WLAN_RXPKT_MAX_SZ	12288
+#define WLAN_RXPKT_MAX_SZ_512	(WLAN_RXPKT_MAX_SZ >> 9)
+
+#define WLAN_AMPDU_MAX_TIME		0x70
+#define WLAN_RTS_LEN_TH			0xFF
+#define WLAN_RTS_TX_TIME_TH		0x08
+#define WLAN_MAX_AGG_PKT_LIMIT		0x3f
+#define WLAN_RTS_MAX_AGG_PKT_LIMIT	0x3f
+#define WLAN_PRE_TXCNT_TIME_TH		0x1E0
+#define FAST_EDCA_VO_TH		0x06
+#define FAST_EDCA_VI_TH		0x06
+#define FAST_EDCA_BE_TH		0x06
+#define FAST_EDCA_BK_TH		0x06
+#define WLAN_BAR_RETRY_LIMIT		0x01
+#define WLAN_BAR_ACK_TYPE		0x05
+#define WLAN_RA_TRY_RATE_AGG_LIMIT	0x08
+#define WLAN_RESP_TXRATE		0x84
+#define WLAN_ACK_TO			0x21
+#define WLAN_ACK_TO_CCK			0x6A
+#define WLAN_DATA_RATE_FB_CNT_1_4	0x01000000
+#define WLAN_DATA_RATE_FB_CNT_5_8	0x08070504
+#define WLAN_RTS_RATE_FB_CNT_5_8	0x08070504
+#define WLAN_DATA_RATE_FB_RATE0		0xFE01F010
+#define WLAN_DATA_RATE_FB_RATE0_H	0x40000000
+#define WLAN_RTS_RATE_FB_RATE1		0x003FF010
+#define WLAN_RTS_RATE_FB_RATE1_H	0x40000000
+#define WLAN_RTS_RATE_FB_RATE4		0x0600F010
+#define WLAN_RTS_RATE_FB_RATE4_H	0x400003E0
+#define WLAN_RTS_RATE_FB_RATE5		0x0600F015
+#define WLAN_RTS_RATE_FB_RATE5_H	0x000000E0
+#define WLAN_MULTI_ADDR			0xFFFFFFFF
+
+#define WLAN_TX_FUNC_CFG1		0x30
+#define WLAN_TX_FUNC_CFG2		0x30
+#define WLAN_MAC_OPT_FUNC1		0x50802080
+#define WLAN_MAC_OPT_FUNC2		0x30810041
+#define WLAN_MAC_INT_MIG_CFG		0x33330000
+
+#define WLAN_SIFS_CFG	(WLAN_SIFS_CCK_CONT_TX | \
+			(WLAN_SIFS_OFDM_CONT_TX << BIT_SHIFT_SIFS_OFDM_CTX) | \
+			(WLAN_SIFS_CCK_TRX << BIT_SHIFT_SIFS_CCK_TRX) | \
+			(WLAN_SIFS_OFDM_TRX << BIT_SHIFT_SIFS_OFDM_TRX))
+
+#define WLAN_SIFS_DUR_TUNE	(WLAN_SIFS_CCK_DUR_TUNE | \
+				(WLAN_SIFS_OFDM_DUR_TUNE << 8))
+
+#define WLAN_TBTT_TIME	(WLAN_TBTT_PROHIBIT |\
+			(WLAN_TBTT_HOLD_TIME << BIT_SHIFT_TBTT_HOLD_TIME_AP))
+
+#define WLAN_NAV_CFG		(WLAN_RDG_NAV | (WLAN_TXOP_NAV << 16))
+#define WLAN_RX_TSF_CFG		(WLAN_CCK_RX_TSF | (WLAN_OFDM_RX_TSF) << 8)
+
+#define MAC_CLK_SPEED	80 /* 80M */
+
+/* The vendor driver writes its MAC table before its own MAC setup: do the
+ * same here, and give the generic table loader an empty one.
+ */
+static const u32 rtw8197g_no_mac[] = {};
+RTW_DECL_TABLE_PHY_COND(rtw8197g_no_mac, rtw_phy_cfg_mac);
+
+static int rtw8197g_mac_init(struct rtw_dev *rtwdev)
+{
+	u8 value8;
+	u16 value16;
+	u32 value32;
+	u16 pre_txcnt;
+
+	rtw_load_table(rtwdev, &rtw8197g_mac_tbl);
+
+	/* txq control */
+	value8 = rtw_read8(rtwdev, REG_FWHW_TXQ_CTRL);
+	value8 |= (BIT(7) & ~BIT(1) & ~BIT(2));
+	rtw_write8(rtwdev, REG_FWHW_TXQ_CTRL, value8);
+	rtw_write8(rtwdev, REG_FWHW_TXQ_CTRL + 1, WLAN_TXQ_RPT_EN);
+	/* sifs control */
+	rtw_write16(rtwdev, REG_SPEC_SIFS, WLAN_SIFS_DUR_TUNE);
+	rtw_write32(rtwdev, REG_SIFS, WLAN_SIFS_CFG);
+	rtw_write16(rtwdev, REG_RESP_SIFS_CCK,
+		    WLAN_SIFS_CCK_CTX | WLAN_SIFS_CCK_IRX << 8);
+	rtw_write16(rtwdev, REG_RESP_SIFS_OFDM,
+		    WLAN_SIFS_OFDM_CTX | WLAN_SIFS_OFDM_IRX << 8);
+	/* rate fallback control */
+	rtw_write32(rtwdev, REG_DARFRC, WLAN_DATA_RATE_FB_CNT_1_4);
+	rtw_write32(rtwdev, REG_DARFRCH, WLAN_DATA_RATE_FB_CNT_5_8);
+	rtw_write32(rtwdev, REG_RARFRCH, WLAN_RTS_RATE_FB_CNT_5_8);
+	rtw_write32(rtwdev, REG_ARFR0, WLAN_DATA_RATE_FB_RATE0);
+	rtw_write32(rtwdev, REG_ARFRH0, WLAN_DATA_RATE_FB_RATE0_H);
+	rtw_write32(rtwdev, REG_ARFR1_V1, WLAN_RTS_RATE_FB_RATE1);
+	rtw_write32(rtwdev, REG_ARFRH1_V1, WLAN_RTS_RATE_FB_RATE1_H);
+	rtw_write32(rtwdev, REG_ARFR4, WLAN_RTS_RATE_FB_RATE4);
+	rtw_write32(rtwdev, REG_ARFRH4, WLAN_RTS_RATE_FB_RATE4_H);
+	rtw_write32(rtwdev, REG_ARFR5, WLAN_RTS_RATE_FB_RATE5);
+	rtw_write32(rtwdev, REG_ARFRH5, WLAN_RTS_RATE_FB_RATE5_H);
+	/* protocol configuration */
+	rtw_write8(rtwdev, REG_AMPDU_MAX_TIME_V1, WLAN_AMPDU_MAX_TIME);
+	rtw_write8_set(rtwdev, REG_TX_HANG_CTRL, BIT_EN_EOF_V1);
+	pre_txcnt = WLAN_PRE_TXCNT_TIME_TH | BIT_EN_PRECNT;
+	rtw_write8(rtwdev, REG_PRECNT_CTRL, (u8)(pre_txcnt & 0xFF));
+	rtw_write8(rtwdev, REG_PRECNT_CTRL + 1, (u8)(pre_txcnt >> 8));
+	value32 = WLAN_RTS_LEN_TH | (WLAN_RTS_TX_TIME_TH << 8) |
+		  (WLAN_MAX_AGG_PKT_LIMIT << 16) |
+		  (WLAN_RTS_MAX_AGG_PKT_LIMIT << 24);
+	rtw_write32(rtwdev, REG_PROT_MODE_CTRL, value32);
+	rtw_write16(rtwdev, REG_BAR_MODE_CTRL + 2,
+		    WLAN_BAR_RETRY_LIMIT | WLAN_RA_TRY_RATE_AGG_LIMIT << 8);
+	rtw_write8(rtwdev, REG_FAST_EDCA_VOVI_SETTING, FAST_EDCA_VO_TH);
+	rtw_write8(rtwdev, REG_FAST_EDCA_VOVI_SETTING + 2, FAST_EDCA_VI_TH);
+	rtw_write8(rtwdev, REG_FAST_EDCA_BEBK_SETTING, FAST_EDCA_BE_TH);
+	rtw_write8(rtwdev, REG_FAST_EDCA_BEBK_SETTING + 2, FAST_EDCA_BK_TH);
+	/* close BA parser */
+	rtw_write8_clr(rtwdev, REG_LIFETIME_EN, BIT_BA_PARSER_EN);
+	rtw_write32_clr(rtwdev, REG_RRSR, BITS_RRSR_RSC);
+
+	/* EDCA configuration */
+	rtw_write32(rtwdev, REG_EDCA_VO_PARAM, WLAN_EDCA_VO_PARAM);
+	rtw_write32(rtwdev, REG_EDCA_VI_PARAM, WLAN_EDCA_VI_PARAM);
+	rtw_write32(rtwdev, REG_EDCA_BE_PARAM, WLAN_EDCA_BE_PARAM);
+	rtw_write32(rtwdev, REG_EDCA_BK_PARAM, WLAN_EDCA_BK_PARAM);
+	rtw_write8(rtwdev, REG_PIFS, WLAN_PIFS_TIME);
+	rtw_write8_clr(rtwdev, REG_TX_PTCL_CTRL + 1, BIT_SIFS_BK_EN >> 8);
+	rtw_write8_set(rtwdev, REG_RD_CTRL + 1,
+		       (BIT_DIS_TXOP_CFE | BIT_DIS_LSIG_CFE |
+			BIT_DIS_STBC_CFE) >> 8);
+
+	/* MAC clock configuration */
+	rtw_write32_clr(rtwdev, REG_AFE_CTRL1, BIT_MAC_CLK_SEL);
+	rtw_write8(rtwdev, REG_USTIME_TSF, MAC_CLK_SPEED);
+	rtw_write8(rtwdev, REG_USTIME_EDCA, MAC_CLK_SPEED);
+
+	rtw_write8_set(rtwdev, REG_MISC_CTRL,
+		       BIT_EN_FREE_CNT | BIT_DIS_SECOND_CCA);
+	rtw_write8_clr(rtwdev, REG_TIMER0_SRC_SEL, BIT_TSFT_SEL_TIMER0);
+	rtw_write16(rtwdev, REG_TXPAUSE, 0x0000);
+	rtw_write8(rtwdev, REG_SLOT, WLAN_SLOT_TIME);
+	rtw_write32(rtwdev, REG_RD_NAV_NXT, WLAN_NAV_CFG);
+	rtw_write16(rtwdev, REG_RXTSF_OFFSET_CCK, WLAN_RX_TSF_CFG);
+	/* Set beacon cotnrol - enable TSF and other related functions */
+	rtw_write8_set(rtwdev, REG_BCN_CTRL, BIT_EN_BCN_FUNCTION);
+	/* Set send beacon related registers */
+	rtw_write32(rtwdev, REG_TBTT_PROHIBIT, WLAN_TBTT_TIME);
+	rtw_write8(rtwdev, REG_DRVERLYINT, WLAN_DRV_EARLY_INT);
+	rtw_write8(rtwdev, REG_BCN_CTRL_CLINT0, WLAN_BCN_CTRL_CLT0);
+	rtw_write8(rtwdev, REG_BCNDMATIM, WLAN_BCN_DMA_TIME);
+	rtw_write8(rtwdev, REG_BCN_MAX_ERR, WLAN_BCN_MAX_ERR);
+	/* Send the high queue (broadcast and multicast) at once, as the
+	 * vendor driver does. Held for DTIM beacons it drains only a few
+	 * frames per beacon, fills its ring and stops the BE queue.
+	 */
+	rtw_write8(rtwdev, REG_HIQ_NO_LMT_EN_V2, 0xff);
+
+	/* WMAC configuration */
+	rtw_write32(rtwdev, REG_MAR, WLAN_MULTI_ADDR);
+	rtw_write32(rtwdev, REG_MAR + 4, WLAN_MULTI_ADDR);
+	rtw_write8(rtwdev, REG_BBPSF_CTRL + 2, WLAN_RESP_TXRATE);
+	rtw_write8(rtwdev, REG_ACKTO, WLAN_ACK_TO);
+	rtw_write8(rtwdev, REG_ACKTO_CCK, WLAN_ACK_TO_CCK);
+	rtw_write16(rtwdev, REG_EIFS, WLAN_EIFS_DUR_TUNE);
+	rtw_write8(rtwdev, REG_NAV_CTRL + 2, WLAN_NAV_MAX);
+	rtw_write8(rtwdev, REG_WMAC_TRXPTCL_CTL_H  + 2, WLAN_BAR_ACK_TYPE);
+	rtw_write32(rtwdev, REG_RXFLTMAP0, WLAN_RX_FILTER0);
+	rtw_write16(rtwdev, REG_RXFLTMAP2, WLAN_RX_FILTER2);
+	rtw_write32(rtwdev, REG_RCR, WLAN_RCR_CFG);
+	rtw_write8(rtwdev, REG_RX_PKT_LIMIT, WLAN_RXPKT_MAX_SZ_512);
+	rtw_write8(rtwdev, REG_TCR + 2, WLAN_TX_FUNC_CFG2);
+	rtw_write8(rtwdev, REG_TCR + 1, WLAN_TX_FUNC_CFG1);
+	rtw_write32_set(rtwdev, REG_GENERAL_OPTION, BIT_DUMMY_FCS_READY_MASK_EN);
+	rtw_write32(rtwdev, REG_WMAC_OPTION_FUNCTION + 8, WLAN_MAC_OPT_FUNC2);
+	rtw_write32(rtwdev, REG_WMAC_OPTION_FUNCTION_1, WLAN_MAC_OPT_FUNC1);
+
+	/* init low power */
+	value16 = rtw_read16(rtwdev, REG_RXPSF_CTRL + 2) & 0xF00F;
+	value16 |= (BIT_RXGCK_VHT_FIFOTHR(1) | BIT_RXGCK_HT_FIFOTHR(1) |
+		    BIT_RXGCK_OFDM_FIFOTHR(1) | BIT_RXGCK_CCK_FIFOTHR(1)) >> 16;
+	rtw_write16(rtwdev, REG_RXPSF_CTRL + 2, value16);
+	value16 = 0;
+	value16 = BIT_SET_RXPSF_PKTLENTHR(value16, 1);
+	value16 |= BIT_RXPSF_CTRLEN | BIT_RXPSF_VHTCHKEN | BIT_RXPSF_HTCHKEN
+		| BIT_RXPSF_OFDMCHKEN | BIT_RXPSF_CCKCHKEN
+		| BIT_RXPSF_OFDMRST;
+	rtw_write16(rtwdev, REG_RXPSF_CTRL, value16);
+	rtw_write32(rtwdev, REG_RXPSF_TYPE_CTRL, 0xFFFFFFFF);
+	/* rx ignore configuration */
+	value16 = rtw_read16(rtwdev, REG_RXPSF_CTRL);
+	value16 &= ~(BIT_RXPSF_MHCHKEN | BIT_RXPSF_CCKRST |
+		     BIT_RXPSF_CONT_ERRCHKEN);
+	value16 = BIT_SET_RXPSF_ERRTHR(value16, 0x07);
+	rtw_write16(rtwdev, REG_RXPSF_CTRL, value16);
+
+	/* Interrupt migration configuration */
+	rtw_write32(rtwdev, REG_INT_MIG, WLAN_MAC_INT_MIG_CFG);
+
+	/* the rest of the vendor driver's MAC setup for this chip */
+	rtw_write8(rtwdev, REG_GPIO_MUXCFG, 0);
+	rtw_write8(rtwdev, 0x523, 0x80);
+	rtw_write32_set(rtwdev, 0x70, BIT(26));
+	rtw_write16(rtwdev, 0x4ca, 0x2020);
+	rtw_write32(rtwdev, 0x14f0, 0);
+	/* duplicate RTS, and CTS/ACK on the duplicate */
+	rtw_write32_mask(rtwdev, REG_RRSR, GENMASK(22, 21), 0x2);
+	rtw_write8_set(rtwdev, 0x480, BIT(5));
+
+	return 0;
+}
+
+static void rtw8197g_toggle_igi(struct rtw_dev *rtwdev)
+{
+	u32 igi;
+
+	igi = rtw_read32_mask(rtwdev, REG_RXIGI, 0x7f);
+	rtw_write32_mask(rtwdev, REG_RXIGI, 0x7f, igi - 2);
+	rtw_write32_mask(rtwdev, REG_RXIGI, 0x7f00, igi - 2);
+	rtw_write32_mask(rtwdev, REG_RXIGI, 0x7f, igi);
+	rtw_write32_mask(rtwdev, REG_RXIGI, 0x7f00, igi);
+}
+
+static void rtw8197g_set_channel_rf(struct rtw_dev *rtwdev, u8 channel, u8 bw)
+{
+#define RF18_CHANNEL_MASK	(MASKBYTE0)
+#define RF18_RFSI_MASK		(BIT(18) | BIT(17))
+#define RF18_BW_MASK		(BIT(11) | BIT(10))
+#define RF18_BW_20M		(BIT(11) | BIT(10))
+#define RF18_BW_40M		(BIT(11))
+
+	u32 rf_reg18;
+
+	rf_reg18 = rtw_read_rf(rtwdev, RF_PATH_A, 0x18, RFREG_MASK);
+	rf_reg18 &= ~(RF18_CHANNEL_MASK | RF18_RFSI_MASK | RF18_BW_MASK);
+	rf_reg18 |= channel & RF18_CHANNEL_MASK;
+	rf_reg18 |= bw == RTW_CHANNEL_WIDTH_40 ? RF18_BW_40M : RF18_BW_20M;
+
+	rtw_write_rf(rtwdev, RF_PATH_A, RF_CFGCH, RFREG_MASK, rf_reg18);
+	rtw_write_rf(rtwdev, RF_PATH_B, RF_CFGCH, RFREG_MASK, rf_reg18);
+}
+
+static void rtw8197g_set_channel_bb(struct rtw_dev *rtwdev, u8 channel, u8 bw,
+				    u8 primary_ch_idx)
+{
+	/* AGC tables: CCK 0, OFDM 2 for RFE type 0 */
+	rtw_write32_mask(rtwdev, REG_RXAGCCTL0, BITS_RXAGC_CCK, 0x0);
+	rtw_write32_mask(rtwdev, REG_RXAGCCTL, BITS_RXAGC_CCK, 0x0);
+	rtw_write32_mask(rtwdev, REG_RXAGCCTL0, BITS_RXAGC_OFDM, 0x2);
+	rtw_write32_mask(rtwdev, REG_RXAGCCTL, BITS_RXAGC_OFDM, 0x2);
+
+	switch (bw) {
+	case RTW_CHANNEL_WIDTH_20:
+	default:
+		rtw_write32_mask(rtwdev, REG_DFIRBW, 0x3ff0, 0x19b);
+		rtw_write32_mask(rtwdev, REG_TXBWCTL, 0xffc0, 0x0);
+		/* DAC 480M, ADC 160M */
+		rtw_write32_mask(rtwdev, REG_TXCLK, 0x700, 0x3);
+		rtw_write32_mask(rtwdev, REG_ADCCLK_8197G, 0xf, 0xc);
+		rtw_write32_mask(rtwdev, REG_TXBWCTL, 0xf, 0x0);
+		rtw_write32_mask(rtwdev, REG_PT_CHSMO, BIT_PT_OPT, 0x0);
+		rtw_write32_mask(rtwdev, REG_CCK_SOURCE, BIT_CCK_SRC_40M, 0x0);
+		rtw_write32_mask(rtwdev, REG_CCK_SOURCE, BIT_NBI_EN, 0x1);
+		/* TX band edge */
+		rtw_write32_mask(rtwdev, REG_TXDFIR0, 0xf0000, 0x3);
+		rtw_write32_mask(rtwdev, REG_TXDFIR0, 0xff, 0x40);
+		rtw_write32_mask(rtwdev, REG_CCK_MBC, BIT_MBC_FORGET, 0x0);
+		break;
+	case RTW_CHANNEL_WIDTH_40:
+		rtw_write32_mask(rtwdev, REG_CCKSB, BIT(4),
+				 primary_ch_idx == RTW_SC_20_UPPER ? 1 : 0);
+		rtw_write32_mask(rtwdev, REG_CCK_40M_SB, BITS_CCK_40M_SB,
+				 primary_ch_idx == RTW_SC_20_UPPER ? 0x5 : 0x6);
+		rtw_write32_mask(rtwdev, REG_TXBWCTL, 0xf, 0x5);
+		rtw_write32_mask(rtwdev, REG_TXBWCTL, 0xc0, 0x0);
+		rtw_write32_mask(rtwdev, REG_TXBWCTL, 0xff00,
+				 (primary_ch_idx | (primary_ch_idx << 4)));
+		rtw_write32_mask(rtwdev, REG_PT_CHSMO, BIT_PT_OPT, 0x1);
+		rtw_write32_mask(rtwdev, REG_CCK_SOURCE, BIT_CCK_SRC_40M, 0x1);
+		rtw_write32_mask(rtwdev, REG_CCK_SOURCE, BIT_NBI_EN, 0x1);
+		rtw_write32_mask(rtwdev, REG_TXDFIR0, 0xf0000, 0x5);
+		rtw_write32_mask(rtwdev, REG_TXDFIR0, 0xff, 0x24);
+		rtw_write32_mask(rtwdev, REG_CCK_MBC, BIT_MBC_FORGET, 0x1);
+		break;
+	}
+
+	if (channel == 13 || channel == 14)
+		rtw_write32_mask(rtwdev, REG_SCOTRK, 0xfff, 0x969);
+	else if (channel == 11 || channel == 12)
+		rtw_write32_mask(rtwdev, REG_SCOTRK, 0xfff, 0x96a);
+	else
+		rtw_write32_mask(rtwdev, REG_SCOTRK, 0xfff, 0x9aa);
+
+	if (channel == 14) {
+		rtw_write32_mask(rtwdev, REG_TXF0, MASKHWORD, 0x3da0);
+		rtw_write32_mask(rtwdev, REG_TXF1, MASKDWORD, 0x4962c931);
+		rtw_write32_mask(rtwdev, REG_TXF2, MASKLWORD, 0x6aa3);
+		rtw_write32_mask(rtwdev, REG_TXF3, MASKHWORD, 0xaa7b);
+		rtw_write32_mask(rtwdev, REG_TXF4, MASKLWORD, 0xf3d7);
+		rtw_write32_mask(rtwdev, REG_TXF5, MASKDWORD, 0x0);
+		rtw_write32_mask(rtwdev, REG_TXF6, MASKDWORD, 0xed012455);
+		rtw_write32_mask(rtwdev, REG_TXF7, MASKDWORD, 0xffff);
+	} else {
+		rtw_write32_mask(rtwdev, REG_TXF0, MASKHWORD, 0x5284);
+		rtw_write32_mask(rtwdev, REG_TXF1, MASKDWORD, 0x3e18fec8);
+		rtw_write32_mask(rtwdev, REG_TXF2, MASKLWORD, 0x0a88);
+		rtw_write32_mask(rtwdev, REG_TXF3, MASKHWORD, 0xacc4);
+		rtw_write32_mask(rtwdev, REG_TXF4, MASKLWORD, 0xc8b2);
+		rtw_write32_mask(rtwdev, REG_TXF5, MASKDWORD, 0x00faf0de);
+		rtw_write32_mask(rtwdev, REG_TXF6, MASKDWORD, 0x00122344);
+		rtw_write32_mask(rtwdev, REG_TXF7, MASKDWORD, 0x0fffffff);
+	}
+}
+
+static void rtw8197g_set_channel(struct rtw_dev *rtwdev, u8 channel, u8 bw,
+				 u8 primary_chan_idx)
+{
+	rtw8197g_set_channel_bb(rtwdev, channel, bw, primary_chan_idx);
+	rtw_set_channel_mac(rtwdev, channel, bw, primary_chan_idx);
+	rtw8197g_set_channel_rf(rtwdev, channel, bw);
+	rtw8197g_bb_reset(rtwdev);
+	rtw8197g_toggle_igi(rtwdev);
+}
+
+static void rtw8197g_config_cck_rx_path(struct rtw_dev *rtwdev, u8 rx_path)
+{
+	rtw_write32_mask(rtwdev, REG_CCANRX, BIT_CCK_RX_1R, 0x0);
+
+	if (rx_path == BB_PATH_A || rx_path == BB_PATH_B) {
+		rtw_write32_mask(rtwdev, REG_CCANRX, 0x00060000, 0x0);
+		rtw_write32_mask(rtwdev, REG_CCANRX, 0x00600000, 0x0);
+	} else if (rx_path == BB_PATH_AB) {
+		rtw_write32_mask(rtwdev, REG_CCANRX, 0x00600000, 0x1);
+		rtw_write32_mask(rtwdev, REG_CCANRX, 0x00060000, 0x1);
+	}
+
+	if (rx_path == BB_PATH_A)
+		rtw_write32_mask(rtwdev, REG_RXCCKSEL, 0x0f000000, 0x0);
+	else if (rx_path == BB_PATH_B)
+		rtw_write32_mask(rtwdev, REG_RXCCKSEL, 0x0f000000, 0x5);
+	else if (rx_path == BB_PATH_AB)
+		rtw_write32_mask(rtwdev, REG_RXCCKSEL, 0x0f000000, 0x1);
+}
+
+static void rtw8197g_config_ofdm_rx_path(struct rtw_dev *rtwdev, u8 rx_path)
+{
+	if (rx_path == BB_PATH_A || rx_path == BB_PATH_B) {
+		rtw_write32_mask(rtwdev, REG_RXFNCTL, 0x300, 0x0);
+		rtw_write32_mask(rtwdev, REG_RXFNCTL, 0x600000, 0x0);
+		rtw_write32_mask(rtwdev, REG_AGCSWSH, BIT(17), 0x0);
+		rtw_write32_mask(rtwdev, REG_ANTWTPD, BIT(20), 0x0);
+		rtw_write32_mask(rtwdev, REG_MRCM, BIT(24), 0x0);
+	} else if (rx_path == BB_PATH_AB) {
+		rtw_write32_mask(rtwdev, REG_RXFNCTL, 0x300, 0x1);
+		rtw_write32_mask(rtwdev, REG_RXFNCTL, 0x600000, 0x1);
+		rtw_write32_mask(rtwdev, REG_AGCSWSH, BIT(17), 0x1);
+		rtw_write32_mask(rtwdev, REG_ANTWTPD, BIT(20), 0x1);
+		rtw_write32_mask(rtwdev, REG_MRCM, BIT(24), 0x1);
+	}
+
+	rtw_write32_mask(rtwdev, REG_ANTMAP, 0x0f000000, rx_path);
+	rtw_write32_mask(rtwdev, REG_ANTMAP, 0x000f0000, rx_path);
+}
+
+static void rtw8197g_config_rx_path(struct rtw_dev *rtwdev, u8 rx_path)
+{
+	rtw8197g_config_cck_rx_path(rtwdev, rx_path);
+	rtw8197g_config_ofdm_rx_path(rtwdev, rx_path);
+}
+
+static void rtw8197g_config_cck_tx_path(struct rtw_dev *rtwdev, u8 tx_path,
+					bool is_tx2_path)
+{
+	if (tx_path == BB_PATH_A) {
+		rtw_write32_mask(rtwdev, REG_RXCCKSEL, 0xf0000000, 0x8);
+	} else if (tx_path == BB_PATH_B) {
+		rtw_write32_mask(rtwdev, REG_RXCCKSEL, 0xf0000000, 0x4);
+	} else {
+		if (is_tx2_path)
+			rtw_write32_mask(rtwdev, REG_RXCCKSEL, 0xf0000000, 0xc);
+		else
+			rtw_write32_mask(rtwdev, REG_RXCCKSEL, 0xf0000000, 0x8);
+	}
+	rtw8197g_bb_reset(rtwdev);
+}
+
+static void rtw8197g_config_ofdm_tx_path(struct rtw_dev *rtwdev, u8 tx_path,
+					 enum rtw_bb_path tx_path_sel_1ss)
+{
+	if (tx_path == BB_PATH_A) {
+		rtw_write32_mask(rtwdev, REG_ANTMAP0, 0xff, 0x11);
+		rtw_write32_mask(rtwdev, REG_TXLGMAP, 0xfff, 0x0);
+	} else if (tx_path == BB_PATH_B) {
+		rtw_write32_mask(rtwdev, REG_ANTMAP0, 0xff, 0x12);
+		rtw_write32_mask(rtwdev, REG_TXLGMAP, 0xfff, 0x0);
+	} else {
+		if (tx_path_sel_1ss == BB_PATH_AB) {
+			rtw_write32_mask(rtwdev, REG_ANTMAP0, 0xff, 0x33);
+			rtw_write32_mask(rtwdev, REG_TXLGMAP, 0xffff, 0x0404);
+		} else if (tx_path_sel_1ss == BB_PATH_B) {
+			rtw_write32_mask(rtwdev, REG_ANTMAP0, 0xff, 0x32);
+			rtw_write32_mask(rtwdev, REG_TXLGMAP, 0xffff, 0x0400);
+		} else if (tx_path_sel_1ss == BB_PATH_A) {
+			rtw_write32_mask(rtwdev, REG_ANTMAP0, 0xff, 0x31);
+			rtw_write32_mask(rtwdev, REG_TXLGMAP, 0xffff, 0x0400);
+		}
+	}
+	rtw8197g_bb_reset(rtwdev);
+}
+
+static void rtw8197g_config_tx_path(struct rtw_dev *rtwdev, u8 tx_path,
+				    enum rtw_bb_path tx_path_sel_1ss,
+				    enum rtw_bb_path tx_path_cck,
+				    bool is_tx2_path)
+{
+	rtw8197g_config_cck_tx_path(rtwdev, tx_path_cck, is_tx2_path);
+	rtw8197g_config_ofdm_tx_path(rtwdev, tx_path, tx_path_sel_1ss);
+	rtw8197g_bb_reset(rtwdev);
+}
+
+static void rtw8197g_config_trx_mode(struct rtw_dev *rtwdev, u8 tx_path,
+				     u8 rx_path, bool is_tx2_path)
+{
+	if ((tx_path | rx_path) & BB_PATH_A)
+		rtw_write32_mask(rtwdev, REG_ORITXCODE, MASK20BITS, 0x33312);
+	else
+		rtw_write32_mask(rtwdev, REG_ORITXCODE, MASK20BITS, 0x11111);
+	if ((tx_path | rx_path) & BB_PATH_B)
+		rtw_write32_mask(rtwdev, REG_ORITXCODE2, MASK20BITS, 0x33312);
+	else
+		rtw_write32_mask(rtwdev, REG_ORITXCODE2, MASK20BITS, 0x11111);
+
+	rtw8197g_config_rx_path(rtwdev, rx_path);
+	/* the vendor driver sends 1ss rates on all enabled paths */
+	rtw8197g_config_tx_path(rtwdev, tx_path, tx_path, tx_path,
+				is_tx2_path);
+
+	rtw8197g_toggle_igi(rtwdev);
+}
+
+static void query_phy_status_page0(struct rtw_dev *rtwdev, u8 *phy_status,
+				   struct rtw_rx_pkt_stat *pkt_stat)
+{
+	struct rtw_dm_info *dm_info = &rtwdev->dm_info;
+	u8 l_bnd, u_bnd;
+	u8 gain_a, gain_b;
+	s8 rx_power[RTW_RF_PATH_MAX];
+	s8 min_rx_power = -120;
+	u8 rssi;
+	u8 channel;
+	int path;
+
+	rx_power[RF_PATH_A] = GET_PHY_STAT_P0_PWDB_A(phy_status);
+	rx_power[RF_PATH_B] = GET_PHY_STAT_P0_PWDB_B(phy_status);
+	l_bnd = dm_info->cck_gi_l_bnd;
+	u_bnd = dm_info->cck_gi_u_bnd;
+	gain_a = GET_PHY_STAT_P0_GAIN_A(phy_status);
+	gain_b = GET_PHY_STAT_P0_GAIN_B(phy_status);
+	if (gain_a < l_bnd)
+		rx_power[RF_PATH_A] += (l_bnd - gain_a) << 1;
+	else if (gain_a > u_bnd)
+		rx_power[RF_PATH_A] -= (gain_a - u_bnd) << 1;
+	if (gain_b < l_bnd)
+		rx_power[RF_PATH_B] += (l_bnd - gain_b) << 1;
+	else if (gain_b > u_bnd)
+		rx_power[RF_PATH_B] -= (gain_b - u_bnd) << 1;
+
+	rx_power[RF_PATH_A] -= 110;
+	rx_power[RF_PATH_B] -= 110;
+
+	channel = GET_PHY_STAT_P0_CHANNEL(phy_status);
+	if (channel != 0)
+		rtw_set_rx_freq_band(pkt_stat, channel);
+	else
+		pkt_stat->channel_invalid = true;
+
+	pkt_stat->rx_power[RF_PATH_A] = rx_power[RF_PATH_A];
+	pkt_stat->rx_power[RF_PATH_B] = rx_power[RF_PATH_B];
+
+	for (path = 0; path < rtwdev->hal.rf_path_num; path++) {
+		rssi = rtw_phy_rf_power_2_rssi(&pkt_stat->rx_power[path], 1);
+		dm_info->rssi[path] = rssi;
+	}
+
+	pkt_stat->rssi = rtw_phy_rf_power_2_rssi(pkt_stat->rx_power, 1);
+	pkt_stat->bw = RTW_CHANNEL_WIDTH_20;
+	pkt_stat->signal_power = max(pkt_stat->rx_power[RF_PATH_A],
+				     min_rx_power);
+}
+
+static void query_phy_status_page1(struct rtw_dev *rtwdev, u8 *phy_status,
+				   struct rtw_rx_pkt_stat *pkt_stat)
+{
+	struct rtw_dm_info *dm_info = &rtwdev->dm_info;
+	u8 rxsc, bw;
+	s8 min_rx_power = -120;
+	s8 rx_evm;
+	u8 evm_dbm = 0;
+	u8 rssi;
+	int path;
+	u8 channel;
+
+	if (pkt_stat->rate > DESC_RATE11M && pkt_stat->rate < DESC_RATEMCS0)
+		rxsc = GET_PHY_STAT_P1_L_RXSC(phy_status);
+	else
+		rxsc = GET_PHY_STAT_P1_HT_RXSC(phy_status);
+
+	if (rxsc == 0)
+		bw = rtwdev->hal.current_band_width;
+	else if (rxsc >= 1 && rxsc <= 8)
+		bw = RTW_CHANNEL_WIDTH_20;
+	else
+		bw = RTW_CHANNEL_WIDTH_40;
+
+	channel = GET_PHY_STAT_P1_CHANNEL(phy_status);
+	rtw_set_rx_freq_band(pkt_stat, channel);
+
+	pkt_stat->rx_power[RF_PATH_A] = GET_PHY_STAT_P1_PWDB_A(phy_status) - 110;
+	pkt_stat->rx_power[RF_PATH_B] = GET_PHY_STAT_P1_PWDB_B(phy_status) - 110;
+	pkt_stat->rssi = rtw_phy_rf_power_2_rssi(pkt_stat->rx_power, 2);
+	pkt_stat->bw = bw;
+	pkt_stat->signal_power = max3(pkt_stat->rx_power[RF_PATH_A],
+				      pkt_stat->rx_power[RF_PATH_B],
+				      min_rx_power);
+
+	dm_info->curr_rx_rate = pkt_stat->rate;
+
+	pkt_stat->rx_evm[RF_PATH_A] = GET_PHY_STAT_P1_RXEVM_A(phy_status);
+	pkt_stat->rx_evm[RF_PATH_B] = GET_PHY_STAT_P1_RXEVM_B(phy_status);
+
+	pkt_stat->rx_snr[RF_PATH_A] = GET_PHY_STAT_P1_RXSNR_A(phy_status);
+	pkt_stat->rx_snr[RF_PATH_B] = GET_PHY_STAT_P1_RXSNR_B(phy_status);
+
+	pkt_stat->cfo_tail[RF_PATH_A] = GET_PHY_STAT_P1_CFO_TAIL_A(phy_status);
+	pkt_stat->cfo_tail[RF_PATH_B] = GET_PHY_STAT_P1_CFO_TAIL_B(phy_status);
+
+	for (path = 0; path < rtwdev->hal.rf_path_num; path++) {
+		rssi = rtw_phy_rf_power_2_rssi(&pkt_stat->rx_power[path], 1);
+		dm_info->rssi[path] = rssi;
+		dm_info->rx_snr[path] = pkt_stat->rx_snr[path] >> 1;
+		dm_info->cfo_tail[path] = (pkt_stat->cfo_tail[path] * 5) >> 1;
+
+		rx_evm = pkt_stat->rx_evm[path];
+
+		if (rx_evm < 0) {
+			if (rx_evm == S8_MIN)
+				evm_dbm = 0;
+			else
+				evm_dbm = ((u8)-rx_evm >> 1);
+		}
+		dm_info->rx_evm_dbm[path] = evm_dbm;
+	}
+	rtw_phy_parsing_cfo(rtwdev, pkt_stat);
+}
+
+static void query_phy_status(struct rtw_dev *rtwdev, u8 *phy_status,
+			     struct rtw_rx_pkt_stat *pkt_stat)
+{
+	u8 page;
+
+	page = *phy_status & 0xf;
+
+	switch (page) {
+	case 0:
+		query_phy_status_page0(rtwdev, phy_status, pkt_stat);
+		break;
+	case 1:
+		query_phy_status_page1(rtwdev, phy_status, pkt_stat);
+		break;
+	default:
+		rtw_warn(rtwdev, "unused phy status page (%d)\n", page);
+		return;
+	}
+}
+
+static void
+rtw8197g_set_write_tx_power_ref(struct rtw_dev *rtwdev, u8 *tx_pwr_ref_cck,
+				u8 *tx_pwr_ref_ofdm)
+{
+	struct rtw_hal *hal = &rtwdev->hal;
+	u32 txref_cck[2] = {0x18a0, 0x41a0};
+	u32 txref_ofdm[2] = {0x18e8, 0x41e8};
+	u8 path;
+
+	for (path = 0; path < hal->rf_path_num; path++) {
+		rtw_write32_mask(rtwdev, 0x1c90, BIT(15), 0);
+		rtw_write32_mask(rtwdev, txref_cck[path], 0x7f0000,
+				 tx_pwr_ref_cck[path]);
+	}
+	for (path = 0; path < hal->rf_path_num; path++) {
+		rtw_write32_mask(rtwdev, 0x1c90, BIT(15), 0);
+		rtw_write32_mask(rtwdev, txref_ofdm[path], 0x1fc00,
+				 tx_pwr_ref_ofdm[path]);
+	}
+}
+
+static void rtw8197g_set_tx_power_diff(struct rtw_dev *rtwdev, u8 rate,
+				       s8 *diff_idx)
+{
+	u32 offset_txagc = 0x3a00;
+	u8 rate_idx = rate & 0xfc;
+	u8 pwr_idx[4];
+	u32 phy_pwr_idx;
+	int i;
+
+	for (i = 0; i < 4; i++)
+		pwr_idx[i] = diff_idx[i] & 0x7f;
+
+	phy_pwr_idx = pwr_idx[0] |
+		      (pwr_idx[1] << 8) |
+		      (pwr_idx[2] << 16) |
+		      (pwr_idx[3] << 24);
+
+	rtw_write32_mask(rtwdev, 0x1c90, BIT(15), 0x0);
+	rtw_write32_mask(rtwdev, offset_txagc + rate_idx, MASKDWORD,
+			 phy_pwr_idx);
+}
+
+static void rtw8197g_set_tx_power_index(struct rtw_dev *rtwdev)
+{
+	struct rtw_hal *hal = &rtwdev->hal;
+	u8 rs, rate, j;
+	u8 pwr_ref_cck[2] = {hal->tx_pwr_tbl[RF_PATH_A][DESC_RATE11M],
+			     hal->tx_pwr_tbl[RF_PATH_B][DESC_RATE11M]};
+	u8 pwr_ref_ofdm[2] = {hal->tx_pwr_tbl[RF_PATH_A][DESC_RATEMCS7],
+			      hal->tx_pwr_tbl[RF_PATH_B][DESC_RATEMCS7]};
+	s8 diff_a, diff_b;
+	u8 pwr_a, pwr_b;
+	s8 diff_idx[4];
+
+	rtw8197g_set_write_tx_power_ref(rtwdev, pwr_ref_cck, pwr_ref_ofdm);
+	for (rs = 0; rs <= RTW_RATE_SECTION_HT_2S; rs++) {
+		for (j = 0; j < rtw_rate_size[rs]; j++) {
+			rate = rtw_rate_section[rs][j];
+			pwr_a = hal->tx_pwr_tbl[RF_PATH_A][rate];
+			pwr_b = hal->tx_pwr_tbl[RF_PATH_B][rate];
+			if (rs == 0) {
+				diff_a = (s8)pwr_a - (s8)pwr_ref_cck[0];
+				diff_b = (s8)pwr_b - (s8)pwr_ref_cck[1];
+			} else {
+				diff_a = (s8)pwr_a - (s8)pwr_ref_ofdm[0];
+				diff_b = (s8)pwr_b - (s8)pwr_ref_ofdm[1];
+			}
+			diff_idx[rate % 4] = min(diff_a, diff_b);
+			if (rate % 4 == 3)
+				rtw8197g_set_tx_power_diff(rtwdev, rate - 3,
+							   diff_idx);
+		}
+	}
+}
