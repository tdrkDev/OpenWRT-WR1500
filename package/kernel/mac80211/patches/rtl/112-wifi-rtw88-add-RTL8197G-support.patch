diff --git drivers/net/wireless/realtek/rtw88/rtw8197ge.c drivers/net/wireless/realtek/rtw88/rtw8197ge.c
new file mode 100644
index 0000000..db6ae52
--- /dev/null
+++ b/drivers/net/wireless/realtek/rtw88/rtw8197ge.c
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/* The 802.11n WLAN MAC of the Realtek RTL8197F SoC. It has the HCI of the
+ * PCIe chips, but sits on the SoC bus behind a gate of the system
+ * controller.
+ */
+
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include "main.h"
+#include "pci.h"
+#include "rtw8197g.h"
+
+#define RTL8197F_SYS_WLAN_CTRL	0x64
+/* The vendor driver sets and clears these together. Until bit 0 is set, an
+ * access to the WLAN MAC stalls the bus.
+ */
+#define RTL8197F_WLAN_EN	GENMASK(4, 0)
+
+static struct regmap *rtw8197ge_sysctl(struct platform_device *pdev)
+{
+	return syscon_regmap_lookup_by_phandle(pdev->dev.of_node,
+					       "realtek,sysctl");
+}
+
+static int rtw8197ge_probe(struct platform_device *pdev)
+{
+	struct regmap *sysctl;
+	u32 val = 0;
+	int ret;
+
+	sysctl = rtw8197ge_sysctl(pdev);
+	if (IS_ERR(sysctl))
+		return dev_err_probe(&pdev->dev, PTR_ERR(sysctl),
+				     "no system controller\n");
+
+	ret = regmap_set_bits(sysctl, RTL8197F_SYS_WLAN_CTRL, RTL8197F_WLAN_EN);
+	if (!ret)
+		ret = regmap_read(sysctl, RTL8197F_SYS_WLAN_CTRL, &val);
+	if (!ret && (val & RTL8197F_WLAN_EN) != RTL8197F_WLAN_EN)
+		ret = -EIO;
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to enable the WLAN MAC\n");
+
+	ret = rtw_pci_soc_probe(pdev, &rtw8197g_hw_spec);
+	if (ret)
+		regmap_clear_bits(sysctl, RTL8197F_SYS_WLAN_CTRL,
+				  RTL8197F_WLAN_EN);
+
+	return ret;
+}
+
+static void rtw8197ge_remove(struct platform_device *pdev)
+{
+	struct regmap *sysctl = rtw8197ge_sysctl(pdev);
+
+	rtw_pci_soc_remove(pdev);
+
+	if (!IS_ERR(sysctl))
+		regmap_clear_bits(sysctl, RTL8197F_SYS_WLAN_CTRL,
+				  RTL8197F_WLAN_EN);
+}
+
+static const struct of_device_id rtw8197ge_of_match[] = {
+	{ .compatible = "realtek,rtl8197f-wifi" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, rtw8197ge_of_match);
+
+static struct platform_driver rtw8197ge_driver = {
+	.driver = {
+		.name = KBUILD_MODNAME,
+		.of_match_table = rtw8197ge_of_match,
+	},
+	.probe = rtw8197ge_probe,
+	.remove = rtw8197ge_remove,
+	.shutdown = rtw_pci_soc_shutdown,
+};
+module_platform_driver(rtw8197ge_driver);
+
+MODULE_DESCRIPTION("Realtek 802.11n wireless 8197ge driver");
+MODULE_LICENSE("Dual BSD/GPL");
diff --git drivers/net/wireless/realtek/rtw88/tx.c drivers/net/wireless/realtek/rtw88/tx.c
index 9d747a0..9e75044 100644
--- a/drivers/net/wireless/realtek/rtw88/tx.c
+++ b/drivers/net/wireless/realtek/rtw88/tx.c
@@ -78,7 +78,13 @@ void rtw_tx_fill_tx_desc(struct rtw_dev *rtwdev,
 
 	tx_desc->w6 = le32_encode_bits(pkt_info->sn, RTW_TX_DESC_W6_SW_DEFINE);
 
-	tx_desc->w8 = le32_encode_bits(pkt_info->en_hwseq, RTW_TX_DESC_W8_EN_HWSEQ);
+	/* 8197G: a 2 bit mode field, the vendor driver uses mode 1 */
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8197G)
+		tx_desc->w8 = le32_encode_bits(pkt_info->en_hwseq,
+					       RTW_TX_DESC_W8_EN_HWSEQ_MODE);
+	else
+		tx_desc->w8 = le32_encode_bits(pkt_info->en_hwseq,
+					       RTW_TX_DESC_W8_EN_HWSEQ);
 
 	tx_desc->w9 = le32_encode_bits(pkt_info->seq, RTW_TX_DESC_W9_SW_SEQ);
 
@@ -434,7 +440,8 @@ void rtw_tx_pkt_info_update(struct rtw_dev *rtwdev,
 	bmc = is_broadcast_ether_addr(hdr->addr1) ||
 	      is_multicast_ether_addr(hdr->addr1);
 
-	if (info->flags & IEEE80211_TX_CTL_REQ_TX_STATUS)
+	if (info->flags & IEEE80211_TX_CTL_REQ_TX_STATUS &&
+	    rtw_tx_report_supported(rtwdev))
 		rtw_tx_report_enable(rtwdev, pkt_info);
 
 	pkt_info->bmc = bmc;
