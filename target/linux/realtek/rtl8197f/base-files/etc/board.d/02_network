. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

rtl8197f_setup_interfaces()
{
	local board="$1"

	case $board in
	cudy,wr1500)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3" "wan"
		;;
	*)
		ucidef_set_interface_lan "eth0"
		;;
	esac
}

rtl8197f_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case $board in
	cudy,wr1500)
		label_mac=$(mtd_get_mac_binary cfg 0x7)
		lan_mac=$label_mac
		wan_mac=$(macaddr_add $label_mac 1)
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac
	[ -n "$label_mac" ] && ucidef_set_label_macaddr $label_mac
}

board_config_update
board=$(board_name)
rtl8197f_setup_interfaces $board
rtl8197f_setup_macs $board
board_config_flush

exit 0
