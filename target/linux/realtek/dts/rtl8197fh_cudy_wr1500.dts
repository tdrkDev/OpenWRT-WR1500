#include "rtl8197f.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "cudy,wr1500", "realtek,rtl8197f-soc";
	model = "Cudy WR1500";

	aliases {
		label-mac-device = &ethernet0;
		led-boot = &led_status_red;
		led-failsafe = &led_status_red;
		led-running = &led_status_blue;
		led-upgrade = &led_status_red;
	};

	chosen {
		bootargs = "console=ttyS0,38400";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_gpio_e2>;

		reset {
			label = "reset";
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	/*
	 * RTL8367RB-VC switch managed via SMI on GPIO 56 (H0, clock) and GPIO 55
	 * (G7, data). Its CPU port 7 (RGMII) connects to port 0 of the SoC switch
	 * core, which handles the 4 byte CPU tag in hardware.
	 */
	switch {
		compatible = "realtek,rtl8365mb";
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_smi>;
		mdc-gpios = <&gpio1 24 GPIO_ACTIVE_HIGH>;
		mdio-gpios = <&gpio1 23 GPIO_ACTIVE_HIGH>;
		realtek,short-cpu-tag;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			phy0: ethernet-phy@0 {
				reg = <0>;
			};

			phy1: ethernet-phy@1 {
				reg = <1>;
			};

			phy2: ethernet-phy@2 {
				reg = <2>;
			};

			phy3: ethernet-phy@3 {
				reg = <3>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "lan2";
				phy-handle = <&phy0>;
			};

			port@1 {
				reg = <1>;
				label = "lan3";
				phy-handle = <&phy1>;
			};

			port@2 {
				reg = <2>;
				label = "wan";
				phy-handle = <&phy2>;
			};

			port@3 {
				reg = <3>;
				label = "lan1";
				phy-handle = <&phy3>;
			};

			port@7 {
				reg = <7>;
				ethernet = <&ethernet0>;
				phy-mode = "rgmii";
				rx-internal-delay-ps = <600>;
				tx-internal-delay-ps = <0>;

				fixed-link {
					speed = <1000>;
					full-duplex;
					pause;
				};
			};
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_red: led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
		};

		led_status_blue: led-1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio1 25 GPIO_ACTIVE_HIGH>;
		};
	};
};

&ethernet0 {
	nvmem-cells = <&macaddr_cfg_7 0>;
	nvmem-cell-names = "mac-address";
	realtek,cpu-tag;

	status = "okay";
};

&pcie {
	status = "okay";

	/* RTL8832BR 5 GHz radio, calibrated from the cfg partition */
	wifi@1,0 {
		compatible = "pci10ec,b832";
		reg = <0x0800 0 0 0 0>;
		nvmem-cells = <&macaddr_cfg_7 2>, <&cal_cfg_14>, <&cal_cfg_16>,
			      <&cal_cfg_f4>, <&cal_cfg_1b8>;
		nvmem-cell-names = "mac-address", "efuse-2b9", "efuse-2d0",
				   "efuse-222", "efuse-24c";
		ieee80211-freq-limit = <5000000 5900000>;
	};
};

&pcie_phy {
	status = "okay";
};

&wifi {
	nvmem-cells = <&macaddr_cfg_7 3>;
	nvmem-cell-names = "mac-address";

	status = "okay";
};

&pinmux {
	/* PIN_MUX_SEL17[27:24]: E2 (WPS button) as GPIO */
	pinmux_gpio_e2: gpio-e2 {
		pinctrl-single,bits = <0x44 0x01000000 0x0f000000>;
	};

	/* PIN_MUX_SEL13[27:24,23:20]: G7 and H0 as GPIO for the switch SMI */
	pinmux_smi: smi {
		pinctrl-single,bits = <0x34 0x03300000 0x0ff00000>;
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x20000>;
				read-only;
			};

			/* Realtek hardware settings: MACs and Wi-Fi calibration */
			partition@20000 {
				label = "cfg";
				reg = <0x20000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_cfg_7: macaddr@7 {
						compatible = "mac-base";
						reg = <0x7 0x6>;
						#nvmem-cell-cells = <1>;
					};

					/* 5 GHz crystal cap and thermal A/B */
					cal_cfg_14: calibration@14 {
						reg = <0x14 0x1>;
					};

					cal_cfg_16: calibration@16 {
						reg = <0x16 0x2>;
					};

					/* 5 GHz BW40 1SS TSSI, path A and B */
					cal_cfg_f4: calibration@f4 {
						reg = <0xf4 0xe>;
					};

					cal_cfg_1b8: calibration@1b8 {
						reg = <0x1b8 0xe>;
					};
				};
			};

			partition@30000 {
				label = "bdinfo";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x40000 0xfa0000>;
			};

			/* JFFS2 used by the stock firmware, holds "default" */
			partition@fe0000 {
				label = "reserved";
				reg = <0xfe0000 0x10000>;
				read-only;
			};

			partition@ff0000 {
				label = "backup";
				reg = <0xff0000 0x10000>;
				read-only;
			};
		};
	};
};

&uart0 {
	status = "okay";
};
