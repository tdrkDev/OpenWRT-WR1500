#include "rtl8197f.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "cudy,wr1500", "realtek,rtl8197f-soc";
	model = "Cudy WR1500";

	aliases {
		label-mac-device = &ethernet0;
		led-boot = &led_status_red;
		led-failsafe = &led_status_red;
		led-running = &led_status_blue;
		led-upgrade = &led_status_red;
	};

	chosen {
		bootargs = "console=ttyS0,38400";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_gpio_e2>;

		reset {
			label = "reset";
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	/*
	 * RTL8367 family switch (chip number 0x6642) managed via SMI on GPIO 56
	 * (H0, clock) and GPIO 55 (G7, data), CPU port is MAC7 (RGMII).
	 */
	switch {
		compatible = "realtek,rtl8367b";
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_smi>;
		sck-gpios = <&gpio1 24 GPIO_ACTIVE_HIGH>;
		sda-gpios = <&gpio1 23 GPIO_ACTIVE_HIGH>;
		realtek,extif = <7 0 2 1 1 1 1 1 1 2>;
	};

	leds {
		compatible = "gpio-leds";

		led_status_red: led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
		};

		led_status_blue: led-1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio1 25 GPIO_ACTIVE_HIGH>;
		};
	};
};

&ethernet0 {
	nvmem-cells = <&macaddr_cfg_7>;
	nvmem-cell-names = "mac-address";

	status = "okay";
};

&pinmux {
	/* PIN_MUX_SEL17[27:24]: E2 (WPS button) as GPIO */
	pinmux_gpio_e2: gpio-e2 {
		pinctrl-single,bits = <0x44 0x01000000 0x0f000000>;
	};

	/* PIN_MUX_SEL13[27:24,23:20]: G7 and H0 as GPIO for the switch SMI */
	pinmux_smi: smi {
		pinctrl-single,bits = <0x34 0x03300000 0x0ff00000>;
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x20000>;
				read-only;
			};

			/* Realtek hardware settings: MACs and Wi-Fi calibration */
			partition@20000 {
				label = "cfg";
				reg = <0x20000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_cfg_7: macaddr@7 {
						reg = <0x7 0x6>;
					};
				};
			};

			partition@30000 {
				label = "bdinfo";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "firmware";
				reg = <0x40000 0xfa0000>;
				read-only;
			};

			/* JFFS2 used by the stock firmware, holds "default" */
			partition@fe0000 {
				label = "reserved";
				reg = <0xfe0000 0x10000>;
				read-only;
			};

			partition@ff0000 {
				label = "backup";
				reg = <0xff0000 0x10000>;
				read-only;
			};
		};
	};
};

&uart0 {
	status = "okay";
};
