From: Roman Rikhter <teledurak@gmail.com>
Subject: [PATCH] net: dsa: realtek: rtl8365mb: add RTL8367D family support

The RTL8367RB-VC (chip 0x6642, version 0x0030) belongs to the RTL8367D
family. Most registers are the same as on the RTL8367C family, except:

 - no init jam
 - the RGMII interface drives MAC7 through a mux, with its own pad setup,
   and uses the registers of external interface 1
 - the link of MAC7 is forced through per-port MAC force registers
 - there is no VLAN membership config table, the PVID registers hold the
   VID itself, and VLAN4k entries are two words long
 - there is no EFID, so bridges share one FDB
 - L2 table entries are five words long with a different layout
 - 8 ports and a smaller learning limit

Also add "realtek,short-cpu-tag" for SoCs whose MAC parses and inserts the
4 byte CPU tag and converts it from and to the "rtl8_4" tag for the DSA
core, like the Realtek RTL8197F.

Signed-off-by: Roman Rikhter <teledurak@gmail.com>
---
--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -108,6 +108,7 @@
 #include "realtek-mdio.h"
 #include "rtl83xx.h"
 #include "rtl8365mb_l2.h"
+#include "rtl8365mb_table.h"
 #include "rtl8365mb_vlan.h"
 
 /* Family-specific data and limits */
@@ -122,6 +123,10 @@
 #define RTL8365MB_LEARN_LIMIT_MAX	2112
 #define RTL8365MB_MAX_NUM_EXTINTS	3
 
+/* RTL8367D family limits */
+#define RTL8367D_NUM_PORTS		8
+#define RTL8367D_LEARN_LIMIT_MAX	2056
+
 /* Chip identification registers */
 #define RTL8365MB_CHIP_ID_REG		0x1300
 
@@ -346,6 +351,52 @@
 #define   RTL8365MB_DIGITAL_INTERFACE_FORCE_DUPLEX_MASK		0x0004
 #define   RTL8365MB_DIGITAL_INTERFACE_FORCE_SPEED_MASK		0x0003
 
+/* RTL8367D family MAC force registers - one per port, replacing the external
+ * interface force registers of the other chips. The enable register holds one
+ * force enable bit per field of the select register.
+ */
+#define RTL8367D_MAC_FORCE_SELECT_REG(_p)		(0x12C0 + (_p))
+#define   RTL8367D_MAC_FORCE_SELECT_SPEED_HI_MASK	0x3000
+#define   RTL8367D_MAC_FORCE_SELECT_NWAY_MASK		0x0080
+#define   RTL8367D_MAC_FORCE_SELECT_TXPAUSE_MASK	0x0040
+#define   RTL8367D_MAC_FORCE_SELECT_RXPAUSE_MASK	0x0020
+#define   RTL8367D_MAC_FORCE_SELECT_LINK_MASK		0x0010
+#define   RTL8367D_MAC_FORCE_SELECT_DUPLEX_MASK		0x0004
+#define   RTL8367D_MAC_FORCE_SELECT_SPEED_MASK		0x0003
+#define RTL8367D_MAC_FORCE_SELECT_EN_REG(_p)		(0x12C8 + (_p))
+#define   RTL8367D_MAC_FORCE_SELECT_EN_ALL		0xFFFF
+
+/* RTL8367D family RGMII pad configuration of external interface 1 */
+#define RTL8367D_CHIP_DEBUG0_REG		0x1303
+#define   RTL8367D_CHIP_DEBUG0_SEL33_EXT1_MASK	0x0200
+#define   RTL8367D_CHIP_DEBUG0_DRI_EXT1_RG_MASK	0x0040
+#define   RTL8367D_CHIP_DEBUG0_DRI_EXT1_MASK	0x0010
+#define   RTL8367D_CHIP_DEBUG0_SLR_EXT1_MASK	0x0002
+#define RTL8367D_CHIP_DEBUG1_REG		0x1304
+#define   RTL8367D_CHIP_DEBUG1_RG1_DN_MASK	0x7000
+#define   RTL8367D_CHIP_DEBUG1_RG1_DP_MASK	0x0700
+
+/* RTL8367D family RGMII TX clock delay of external interface 1 */
+#define RTL8367D_EXT_TXC_DLY_REG		0x13F9
+#define   RTL8367D_EXT_TXC_DLY_EXT1_MASK	0x0038
+
+/* RTL8367D family external interface 1 mux: MAC7 or MAC4 */
+#define RTL8367D_TOP_CON0_REG			0x1D70
+#define   RTL8367D_TOP_CON0_MAC7_SEL_EXT1_MASK	0x2000
+#define   RTL8367D_TOP_CON0_MAC4_SEL_EXT1_MASK	0x1000
+
+/* RTL8367D family SerDes 1 mode, which shares MAC7 with external interface 1 */
+#define RTL8367D_SDS1_MISC0_REG			0x1D78
+#define   RTL8367D_SDS1_MISC0_MODE_MASK		0x001F
+#define   RTL8367D_SDS1_MISC0_MODE_DISABLE	0x1F
+
+/* RTL8367D family per-port selection of the maximum frame length register */
+#define RTL8367D_MAX_LENGTH_CFG_REG		0x0883
+
+/* RTL8367D family action on an L2 hit that port isolation excludes */
+#define RTL8367D_LOOKUP_HIT_ISO_ACT_REG		0x0A10
+#define   RTL8367D_LOOKUP_HIT_ISO_ACT_UNKNOWN	0x0001
+
 /* CPU port mask register - controls which ports are treated as CPU ports */
 #define RTL8365MB_CPU_PORT_MASK_REG	0x1219
 #define   RTL8365MB_CPU_PORT_MASK_MASK	0x07FF
@@ -695,6 +746,7 @@
  * @extints: available external interfaces
  * @jam_table: chip-specific initialization jam table
  * @jam_size: size of the chip's jam table
+ * @family_d: RTL8367D family chip
  *
  * These data are specific to a given chip in the family of switches supported
  * by this driver. When adding support for another chip in the family, a new
@@ -707,6 +759,7 @@
 	const struct rtl8365mb_extint extints[RTL8365MB_MAX_NUM_EXTINTS];
 	const struct rtl8365mb_jam_tbl_entry *jam_table;
 	size_t jam_size;
+	bool family_d;
 };
 
 /* Chip info for each supported switch in the family */
@@ -762,6 +815,19 @@
 		.jam_table = rtl8365mb_init_jam_8365mb_vc,
 		.jam_size = ARRAY_SIZE(rtl8365mb_init_jam_8365mb_vc),
 	},
+	{
+		/* The vendor driver does no init jam for this chip. Its only
+		 * external interface drives MAC7, but uses the registers of
+		 * external interface 1.
+		 */
+		.name = "RTL8367RB-VC",
+		.chip_id = 0x6642,
+		.chip_ver = 0x0030,
+		.extints = {
+			{ 7, 1, PHY_INTF(RGMII) },
+		},
+		.family_d = true,
+	},
 };
 
 enum rtl8365mb_stp_state {
@@ -843,6 +909,8 @@
  * @pcs: PCS for the SerDes external interface
  * @sds_supported: SerDes tuning parameters match the chip option, so the
  *                 SerDes interface modes can be advertised
+ * @short_cpu_tag: the CPU port uses the 4 byte CPU tag, which the conduit
+ *                 converts from and to the "rtl8_4" tag
  *
  * Private data for this driver.
  */
@@ -855,10 +923,18 @@
 	struct rtl8365mb_port ports[RTL8365MB_MAX_NUM_PORTS];
 	struct phylink_pcs pcs;
 	bool sds_supported;
+	bool short_cpu_tag;
 };
 
 #define pcs_to_rtl8365mb(_pcs) container_of((_pcs), struct rtl8365mb, pcs)
 
+bool rtl8365mb_is_family_d(struct realtek_priv *priv)
+{
+	struct rtl8365mb *mb = priv->chip_data;
+
+	return mb->chip_info->family_d;
+}
+
 static int rtl8365mb_phy_poll_busy(struct realtek_priv *priv)
 {
 	u32 val;
@@ -1077,6 +1153,60 @@
 	return DSA_TAG_PROTO_RTL8_4;
 }
 
+/* RTL8367D family: RGMII setup of external interface 1, as the vendor driver
+ * does it. The interface is muxed to MAC7 and shares it with SerDes 1.
+ */
+static int rtl8367d_ext_config_rgmii(struct realtek_priv *priv, int port)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read(priv->map, RTL8367D_TOP_CON0_REG, &val);
+	if (ret)
+		return ret;
+
+	if (val & RTL8367D_TOP_CON0_MAC4_SEL_EXT1_MASK) {
+		dev_err(priv->dev, "RGMII interface is muxed to port 4\n");
+		return -EBUSY;
+	}
+
+	ret = regmap_update_bits(priv->map, RTL8365MB_BYPASS_LINE_RATE_REG,
+				 RTL8365MB_BYPASS_LINE_RATE_MASK(port), 0);
+	if (ret)
+		return ret;
+
+	ret = regmap_set_bits(priv->map, RTL8367D_CHIP_DEBUG0_REG,
+			      RTL8367D_CHIP_DEBUG0_SEL33_EXT1_MASK |
+			      RTL8367D_CHIP_DEBUG0_DRI_EXT1_RG_MASK |
+			      RTL8367D_CHIP_DEBUG0_DRI_EXT1_MASK |
+			      RTL8367D_CHIP_DEBUG0_SLR_EXT1_MASK);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8367D_CHIP_DEBUG1_REG,
+				 RTL8367D_CHIP_DEBUG1_RG1_DN_MASK |
+				 RTL8367D_CHIP_DEBUG1_RG1_DP_MASK,
+				 FIELD_PREP(RTL8367D_CHIP_DEBUG1_RG1_DN_MASK, 7) |
+				 FIELD_PREP(RTL8367D_CHIP_DEBUG1_RG1_DP_MASK, 5));
+	if (ret)
+		return ret;
+
+	/* The TX delay is set up through EXT1_RGMXF, keep this one off */
+	ret = regmap_update_bits(priv->map, RTL8367D_EXT_TXC_DLY_REG,
+				 RTL8367D_EXT_TXC_DLY_EXT1_MASK, 0);
+	if (ret)
+		return ret;
+
+	ret = regmap_set_bits(priv->map, RTL8367D_TOP_CON0_REG,
+			      RTL8367D_TOP_CON0_MAC7_SEL_EXT1_MASK);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(priv->map, RTL8367D_SDS1_MISC0_REG,
+				  RTL8367D_SDS1_MISC0_MODE_MASK,
+				  RTL8367D_SDS1_MISC0_MODE_DISABLE);
+}
+
 static int rtl8365mb_ext_config_rgmii(struct realtek_priv *priv, int port,
 				      phy_interface_t interface)
 {
@@ -1147,6 +1277,12 @@
 	if (ret)
 		return ret;
 
+	if (rtl8365mb_is_family_d(priv)) {
+		ret = rtl8367d_ext_config_rgmii(priv, port);
+		if (ret)
+			return ret;
+	}
+
 	ret = regmap_update_bits(
 		priv->map, RTL8365MB_DIGITAL_INTERFACE_SELECT_REG(extint->id),
 		RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_MASK(extint->id),
@@ -1601,6 +1737,26 @@
 		r_duplex = 0;
 	}
 
+	if (rtl8365mb_is_family_d(priv)) {
+		val = FIELD_PREP(RTL8367D_MAC_FORCE_SELECT_TXPAUSE_MASK,
+				 r_tx_pause) |
+		      FIELD_PREP(RTL8367D_MAC_FORCE_SELECT_RXPAUSE_MASK,
+				 r_rx_pause) |
+		      FIELD_PREP(RTL8367D_MAC_FORCE_SELECT_LINK_MASK, r_link) |
+		      FIELD_PREP(RTL8367D_MAC_FORCE_SELECT_DUPLEX_MASK,
+				 r_duplex) |
+		      FIELD_PREP(RTL8367D_MAC_FORCE_SELECT_SPEED_MASK, r_speed);
+		ret = regmap_write(priv->map,
+				   RTL8367D_MAC_FORCE_SELECT_REG(port), val);
+		if (ret)
+			return ret;
+
+		/* Force all fields, which forces the link down if needed */
+		return regmap_write(priv->map,
+				    RTL8367D_MAC_FORCE_SELECT_EN_REG(port),
+				    RTL8367D_MAC_FORCE_SELECT_EN_ALL);
+	}
+
 	val = FIELD_PREP(RTL8365MB_DIGITAL_INTERFACE_FORCE_EN_MASK, 1) |
 	      FIELD_PREP(RTL8365MB_DIGITAL_INTERFACE_FORCE_TXPAUSE_MASK,
 			 r_tx_pause) |
@@ -2162,8 +2318,11 @@
 	 * disables learning. When enabling learning, set it to the chip's
 	 * maximum.
 	 */
+	u32 limit = rtl8365mb_is_family_d(priv) ? RTL8367D_LEARN_LIMIT_MAX :
+						  RTL8365MB_LEARN_LIMIT_MAX;
+
 	return regmap_write(priv->map, RTL8365MB_LUT_PORT_LEARN_LIMIT_REG(port),
-			    enable ? RTL8365MB_LEARN_LIMIT_MAX : 0);
+			    enable ? limit : 0);
 }
 
 static int rtl8365mb_port_set_ucast_flood(struct realtek_priv *priv, int port,
@@ -2212,6 +2371,12 @@
 static int rtl8365mb_port_set_efid(struct realtek_priv *priv, int port,
 				   u32 efid)
 {
+	/* The RTL8367D family has no EFID, its register address is used by
+	 * something else.
+	 */
+	if (rtl8365mb_is_family_d(priv))
+		return 0;
+
 	return regmap_update_bits(priv->map, RTL8365MB_PORT_EFID_REG(port),
 				  RTL8365MB_PORT_EFID_MASK(port),
 				  efid << RTL8365MB_PORT_EFID_OFFSET(port));
@@ -2907,9 +3072,11 @@
 	      FIELD_PREP(RTL8365MB_CPU_CTRL_TAG_POSITION_MASK, cpu->position) |
 	      FIELD_PREP(RTL8365MB_CPU_CTRL_RXBYTECOUNT_MASK, cpu->rx_length) |
 	      FIELD_PREP(RTL8365MB_CPU_CTRL_TAG_FORMAT_MASK, cpu->format) |
-	      FIELD_PREP(RTL8365MB_CPU_CTRL_TRAP_PORT_MASK, cpu->trap_port & 0x7) |
-	      FIELD_PREP(RTL8365MB_CPU_CTRL_TRAP_PORT_EXT_MASK,
-			 cpu->trap_port >> 3 & 0x1);
+	      FIELD_PREP(RTL8365MB_CPU_CTRL_TRAP_PORT_MASK, cpu->trap_port & 0x7);
+	/* On the RTL8367D family, this bit selects the 4 byte tag with priority */
+	if (!rtl8365mb_is_family_d(priv))
+		val |= FIELD_PREP(RTL8365MB_CPU_CTRL_TRAP_PORT_EXT_MASK,
+				  cpu->trap_port >> 3 & 0x1);
 	ret = regmap_write(priv->map, RTL8365MB_CPU_CTRL_REG, val);
 	if (ret)
 		return ret;
@@ -2929,10 +3096,13 @@
 
 	switch (proto) {
 	case DSA_TAG_PROTO_RTL8_4:
-		cpu->format = RTL8365MB_CPU_FORMAT_8BYTES;
+		cpu->format = mb->short_cpu_tag ? RTL8365MB_CPU_FORMAT_4BYTES :
+						  RTL8365MB_CPU_FORMAT_8BYTES;
 		cpu->position = RTL8365MB_CPU_POS_AFTER_SA;
 		break;
 	case DSA_TAG_PROTO_RTL8_4T:
+		if (mb->short_cpu_tag)
+			return -EPROTONOSUPPORT;
 		cpu->format = RTL8365MB_CPU_FORMAT_8BYTES;
 		cpu->position = RTL8365MB_CPU_POS_BEFORE_CRC;
 		break;
@@ -2967,6 +3137,21 @@
 		}
 	}
 
+	/* The common init jam is for the RTL8367C family. The RTL8367D family
+	 * works as reset, only select the maximum frame length register this
+	 * driver programs for all ports, and treat destinations that port
+	 * isolation excludes as unknown instead of dropping the frame, which
+	 * softens the lack of EFID.
+	 */
+	if (ci->family_d) {
+		ret = regmap_write(priv->map, RTL8367D_MAX_LENGTH_CFG_REG, 0);
+		if (ret)
+			return ret;
+
+		return regmap_write(priv->map, RTL8367D_LOOKUP_HIT_ISO_ACT_REG,
+				    RTL8367D_LOOKUP_HIT_ISO_ACT_UNKNOWN);
+	}
+
 	/* Common init jam */
 	for (i = 0; i < ARRAY_SIZE(rtl8365mb_init_jam_common); i++) {
 		ret = regmap_write(priv->map, rtl8365mb_init_jam_common[i].reg,
@@ -3162,9 +3347,14 @@
 		goto out_teardown_irq;
 
 	ds->assisted_learning_on_cpu_port = true;
-	ds->fdb_isolation = true;
-	/* The EFID is 3 bits, but EFID 0 is reserved for standalone ports */
-	ds->max_num_bridges = FIELD_MAX(RTL8365MB_EFID_MASK);
+	/* The RTL8367D family has no EFID to separate the FDB of bridges */
+	if (!mb->chip_info->family_d) {
+		ds->fdb_isolation = true;
+		/* The EFID is 3 bits, but EFID 0 is reserved for standalone
+		 * ports
+		 */
+		ds->max_num_bridges = FIELD_MAX(RTL8365MB_EFID_MASK);
+	}
 
 	ds->configure_vlan_while_not_filtering = true;
 
@@ -3264,13 +3454,21 @@
 
 	dev_info(priv->dev, "found an %s switch\n", mb->chip_info->name);
 
-	priv->num_ports = RTL8365MB_MAX_NUM_PORTS;
+	priv->num_ports = mb->chip_info->family_d ? RTL8367D_NUM_PORTS :
+						    RTL8365MB_MAX_NUM_PORTS;
 	mb->priv = priv;
 	mb->cpu.trap_port = RTL8365MB_MAX_NUM_PORTS;
 	mb->cpu.insert = RTL8365MB_CPU_INSERT_TO_ALL;
 	mb->cpu.position = RTL8365MB_CPU_POS_AFTER_SA;
 	mb->cpu.rx_length = RTL8365MB_CPU_RXLEN_64BYTES;
-	mb->cpu.format = RTL8365MB_CPU_FORMAT_8BYTES;
+
+	/* Some SoCs parse and insert a 4 byte CPU tag in their MAC, converting
+	 * it from and to the "rtl8_4" tag for the DSA core.
+	 */
+	mb->short_cpu_tag = of_property_read_bool(priv->dev->of_node,
+						  "realtek,short-cpu-tag");
+	mb->cpu.format = mb->short_cpu_tag ? RTL8365MB_CPU_FORMAT_4BYTES :
+					     RTL8365MB_CPU_FORMAT_8BYTES;
 
 	return 0;
 }
--- a/drivers/net/dsa/realtek/rtl8365mb_vlan.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_vlan.c
@@ -44,6 +44,8 @@
  *
  * VLANMC index 0 is reserved as a neutral PVID, used for standalone ports.
  *
+ * The RTL8367D family has no VLAN membership config database. Its PVID
+ * registers hold the VID itself, and its VLAN4k entries are shorter.
  */
 
 #include "rtl8365mb_vlan.h"
@@ -75,6 +77,11 @@
 #define RTL8365MB_CVLAN_ENTRY_D2_METERIDX_EXT_MASK	GENMASK(6, 6)
 #define   RTL8365MB_CVLAN_METERIDX_HI_MASK		GENMASK(5, 5)
 
+/* RTL8367D family CVLAN table entry layout, u16[2] */
+#define RTL8367D_CVLAN_ENTRY_SIZE			2 /* 32-bits */
+#define RTL8367D_CVLAN_ENTRY_D1_FID_MASK		GENMASK(1, 0)
+#define RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK		GENMASK(3, 3)
+
 /* VLAN member configuration registers 0~31, u16[3] */
 #define RTL8365MB_VLAN_MC_BASE				0x0728
 #define RTL8365MB_VLAN_MC_ENTRY_SIZE			4 /* 64-bit */
@@ -102,6 +109,10 @@
 #define RTL8365MB_MAX_4K_VID	0x0FFF /* 4095 */
 #define RTL8365MB_MAX_MC_VID	0x1FFF /* 8191 */
 
+/* RTL8367D family port-based VID registers - one VID per port */
+#define RTL8367D_VLAN_PVID_CTRL_REG(_p)		(0x0700 + (_p))
+#define   RTL8367D_VLAN_PVID_CTRL_VID_MASK	GENMASK(11, 0)
+
  /* Port-based VID registers 0~5 - each one holds an MC index for two ports */
 #define RTL8365MB_VLAN_PVID_CTRL_BASE			0x0700
 #define RTL8365MB_VLAN_PVID_CTRL_REG(_p) \
@@ -190,8 +201,10 @@
 	int ret;
 
 	ret = rtl8365mb_table_query(priv, RTL8365MB_TABLE_CVLAN,
-				    RTL8365MB_TABLE_OP_READ, &vid, 0, 0,
-				    data, ARRAY_SIZE(data));
+				    RTL8365MB_TABLE_OP_READ, &vid, 0, 0, data,
+				    rtl8365mb_is_family_d(priv) ?
+					RTL8367D_CVLAN_ENTRY_SIZE :
+					RTL8365MB_CVLAN_ENTRY_SIZE);
 	if (ret)
 		return ret;
 
@@ -199,6 +212,18 @@
 	memset(vlan4k, 0, sizeof(*vlan4k));
 	vlan4k->vid = vid;
 
+	if (rtl8365mb_is_family_d(priv)) {
+		vlan4k->member = FIELD_GET(RTL8365MB_CVLAN_ENTRY_D0_MBR_MASK,
+					   data[0]);
+		vlan4k->untag = FIELD_GET(RTL8365MB_CVLAN_ENTRY_D0_UNTAG_MASK,
+					  data[0]);
+		vlan4k->fid = FIELD_GET(RTL8367D_CVLAN_ENTRY_D1_FID_MASK,
+					data[1]);
+		vlan4k->ivl_en = FIELD_GET(RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK,
+					   data[1]);
+		return 0;
+	}
+
 	val = FIELD_GET(RTL8365MB_CVLAN_ENTRY_D0_MBR_MASK, data[0]);
 	vlan4k->member = FIELD_PREP(RTL8365MB_CVLAN_MBR_LO_MASK, val);
 	val = FIELD_GET(RTL8365MB_CVLAN_ENTRY_D2_MBR_EXT_MASK, data[2]);
@@ -234,9 +259,25 @@
 				   const struct rtl8365mb_vlan4k *vlan4k)
 {
 	u16 data[RTL8365MB_CVLAN_ENTRY_SIZE] = { 0 };
-	u16 vid;
+	u16 vid = vlan4k->vid;
 	int val;
 
+	if (rtl8365mb_is_family_d(priv)) {
+		data[0] = FIELD_PREP(RTL8365MB_CVLAN_ENTRY_D0_MBR_MASK,
+				     vlan4k->member) |
+			  FIELD_PREP(RTL8365MB_CVLAN_ENTRY_D0_UNTAG_MASK,
+				     vlan4k->untag);
+		data[1] = FIELD_PREP(RTL8367D_CVLAN_ENTRY_D1_FID_MASK,
+				     vlan4k->fid) |
+			  FIELD_PREP(RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK,
+				     vlan4k->ivl_en);
+
+		return rtl8365mb_table_query(priv, RTL8365MB_TABLE_CVLAN,
+					     RTL8365MB_TABLE_OP_WRITE, &vid,
+					     0, 0, data,
+					     RTL8367D_CVLAN_ENTRY_SIZE);
+	}
+
 	/* Pack table entry value */
 	val = FIELD_GET(RTL8365MB_CVLAN_MBR_LO_MASK, vlan4k->member);
 	data[0] |= FIELD_PREP(RTL8365MB_CVLAN_ENTRY_D0_MBR_MASK, val);
@@ -270,7 +311,6 @@
 	val = FIELD_GET(RTL8365MB_CVLAN_METERIDX_HI_MASK, val);
 	data[2] |= FIELD_PREP(RTL8365MB_CVLAN_ENTRY_D2_METERIDX_EXT_MASK, val);
 
-	vid = vlan4k->vid;
 	return rtl8365mb_table_query(priv, RTL8365MB_TABLE_CVLAN,
 				     RTL8365MB_TABLE_OP_WRITE, &vid, 0, 0,
 				     data, ARRAY_SIZE(data));
@@ -662,6 +702,94 @@
 	return 0;
 }
 
+static int rtl8367d_vlan_port_get_pvid(struct realtek_priv *priv, int port,
+				       u16 *pvid)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read(priv->map, RTL8367D_VLAN_PVID_CTRL_REG(port), &val);
+	if (ret)
+		return ret;
+
+	*pvid = FIELD_GET(RTL8367D_VLAN_PVID_CTRL_VID_MASK, val);
+
+	return 0;
+}
+
