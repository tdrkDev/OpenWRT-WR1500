From: Roman Rikhter <teledurak@gmail.com>
Subject: [PATCH] spi: add Realtek SPIC flash controller driver

Add Kconfig and Makefile entries for the SPI memory driver of the SPIC
(SHEIPA) NOR flash controller found in Realtek RTL8197F router SoCs.

Signed-off-by: Roman Rikhter <teledurak@gmail.com>
---
Index: linux-6.18.52/drivers/spi/Kconfig
===================================================================
--- linux-6.18.52.orig/drivers/spi/Kconfig
+++ linux-6.18.52/drivers/spi/Kconfig
@@ -890,6 +890,14 @@ config SPI_PXA2XX
 config SPI_PXA2XX_PCI
 	def_tristate SPI_PXA2XX && PCI && COMMON_CLK
 
+config SPI_REALTEK_SPIC
+	tristate "Realtek SPIC SPI flash controller"
+	depends on MACH_REALTEK_RTL || COMPILE_TEST
+	depends on SPI_MEM
+	help
+	  This enables support for the SPIC (SHEIPA) SPI NOR flash controller
+	  found on Realtek RTL8197F router SoCs.
+
 config SPI_REALTEK_SNAND
 	tristate "Realtek SPI-NAND Flash Controller"
 	depends on MACH_REALTEK_RTL || COMPILE_TEST
Index: linux-6.18.52/drivers/spi/Makefile
===================================================================
--- linux-6.18.52.orig/drivers/spi/Makefile
+++ linux-6.18.52/drivers/spi/Makefile
@@ -126,6 +126,7 @@ obj-$(CONFIG_SPI_ROCKCHIP_SFC)		+= spi-r
 obj-$(CONFIG_SPI_RB4XX)			+= spi-rb4xx.o
 obj-$(CONFIG_MACH_REALTEK_RTL)		+= spi-realtek-rtl.o
 obj-$(CONFIG_SPI_REALTEK_SNAND)		+= spi-realtek-rtl-snand.o
+obj-$(CONFIG_SPI_REALTEK_SPIC)		+= spi-realtek-spic.o
 obj-$(CONFIG_SPI_RPCIF)			+= spi-rpc-if.o
 obj-$(CONFIG_SPI_RSPI)			+= spi-rspi.o
 obj-$(CONFIG_SPI_RZV2H_RSPI)		+= spi-rzv2h-rspi.o
