From: Roman Rikhter <teledurak@gmail.com>
Subject: [PATCH] irqchip: realtek-rtl: add RTL8197F support

The RTL8197F router SoC uses the same interrupt controller block as the
Realtek Otto switch SoCs (GIMR, GISR, IRR0-IRR3), but with three
differences:

 - registers are accessed in native (little) endian
 - IRR0 routes inputs 0-7 instead of 31-24 (linear layout)
 - the routing value is the MIPS CPU interrupt number itself, e.g.
   the vendor BSP routes UART0 (input 9) with value 2 to CPU IRQ 2

Add a "realtek,rtl8197f-intc" compatible that selects these properties.

Signed-off-by: Roman Rikhter <teledurak@gmail.com>
---
diff --git a/drivers/irqchip/irq-realtek-rtl.c b/drivers/irqchip/irq-realtek-rtl.c
index 26e52c3f8..4e734c8a8 100644
--- a/drivers/irqchip/irq-realtek-rtl.c
+++ b/drivers/irqchip/irq-realtek-rtl.c
@@ -3,7 +3,8 @@
  * Realtek Interrupt controller.
  *
  * The Realtek Interrupt controller is a big endian device found in the
- * Realtek MIPS SoCs.
+ * Realtek MIPS SoCs. The RTL8197F variant is accessed in native (little)
+ * endian and uses a linear routing register layout.
  *
  * Copyright (C) 2020 Birger Koblitz <mail@birger-koblitz.de>
  * Copyright (C) 2020 Bert Vermeulen <bert@biot.com>
@@ -39,46 +40,89 @@ struct realtek_ictl_output {
 	u32			mask;
 };
 
+struct realtek_ictl_variant {
+	/* Registers are native endian instead of big endian */
+	bool native_endian;
+	/* IRR0 holds inputs 0-7 (linear) instead of inputs 31-24 (inverted) */
+	bool linear_irr;
+	/* Routing value is the parent CPU interrupt number minus this offset */
+	unsigned int route_offset;
+};
+
+static const struct realtek_ictl_variant realtek_otto_variant = {
+	.route_offset = 1,
+};
+
+static const struct realtek_ictl_variant realtek_rtl8197f_variant = {
+	.native_endian = true,
+	.linear_irr = true,
+	.route_offset = 0,
+};
+
 static DEFINE_RAW_SPINLOCK(irq_lock);
 static void __iomem *realtek_ictl_base[NR_CPUS];
+static const struct realtek_ictl_variant *realtek_ictl_variant = &realtek_otto_variant;
+
+static inline u32 ictl_r32(void __iomem *addr)
+{
+	return realtek_ictl_variant->native_endian ? __raw_readl(addr) : readl_be(addr);
+}
+
+static inline void ictl_w32(u32 val, void __iomem *addr)
+{
+	if (realtek_ictl_variant->native_endian) {
+		__raw_writel(val, addr);
+		wmb();
+	} else {
+		writel_be(val, addr);
+	}
+}
 
 /*
- * IRR0-IRR3 store 4 bits per interrupt, but Realtek uses inverted numbering,
- * placing IRQ 31 in the first four bits. A routing value of '0' means the
- * interrupt is left disconnected. Routing values {1..15} connect to output
- * lines {0..14}.
+ * IRR0-IRR3 store 4 bits per interrupt. The Otto SoCs use inverted numbering,
+ * placing IRQ 31 in the first four bits, while RTL8197F places IRQ 0 there.
+ * A routing value of '0' means the interrupt is left disconnected. On Otto,
+ * routing values {1..15} connect to output lines {0..14}, on RTL8197F the
+ * routing value is the MIPS CPU interrupt number itself.
  */
-#define IRR_OFFSET(idx)		(4 * (3 - (idx * 4) / 32))
+static inline unsigned int irr_offset(unsigned int idx)
+{
+	if (realtek_ictl_variant->linear_irr)
+		return 4 * ((idx * 4) / 32);
+
+	return 4 * (3 - (idx * 4) / 32);
+}
+
 #define IRR_SHIFT(idx)		((idx * 4) % 32)
 
 static inline void enable_gimr(unsigned int cpu, unsigned int hw_irq)
 {
 	u32 gimr;
 
-	gimr = readl_be(REG(cpu, RTL_ICTL_GIMR));
+	gimr = ictl_r32(REG(cpu, RTL_ICTL_GIMR));
 	gimr |= BIT(hw_irq);
-	writel_be(gimr, REG(cpu, RTL_ICTL_GIMR));
+	ictl_w32(gimr, REG(cpu, RTL_ICTL_GIMR));
 }
 
 static inline void disable_gimr(unsigned int cpu, unsigned int hw_irq)
 {
 	u32 gimr;
 
-	gimr = readl_be(REG(cpu, RTL_ICTL_GIMR));
+	gimr = ictl_r32(REG(cpu, RTL_ICTL_GIMR));
 	gimr &= ~BIT(hw_irq);
-	writel_be(gimr, REG(cpu, RTL_ICTL_GIMR));
+	ictl_w32(gimr, REG(cpu, RTL_ICTL_GIMR));
 }
 
 static void write_irr(unsigned int cpu, int hw_irq, u32 value)
 {
 	void __iomem *irr0 = REG(cpu, RTL_ICTL_IRR0);
-	unsigned int offset = IRR_OFFSET(hw_irq);
+	unsigned int offset = irr_offset(hw_irq);
 	unsigned int shift = IRR_SHIFT(hw_irq);
 	u32 irr;
 
-	irr = readl_be(irr0 + offset) & ~(0xf << shift);
+	irr = ictl_r32(irr0 + offset) & ~(0xf << shift);
 	irr |= (value & 0xf) << shift;
-	writel_be(irr, irr0 + offset);
+	ictl_w32(irr, irr0 + offset);
 }
 
 static void realtek_ictl_unmask_irq(struct irq_data *i)
@@ -129,7 +173,8 @@ static int intc_map(struct irq_domain *d, unsigned int irq, irq_hw_number_t hw_i
 	guard(raw_spinlock_irqsave)(&irq_lock);
 	output->mask |= BIT(hw_irq);
 	for_each_present_cpu(cpu)
-		write_irr(cpu, hw_irq, output->parent_hwirq - 1);
+		write_irr(cpu, hw_irq, output->parent_hwirq -
+			  realtek_ictl_variant->route_offset);
 
 	return 0;
 }
@@ -164,8 +209,8 @@ static void realtek_irq_dispatch(struct irq_desc *desc)
 	unsigned int hw_irq;
 
 	chained_irq_enter(chip, desc);
-	pending = readl_be(REG(cpu, RTL_ICTL_GIMR)) &
-		  readl_be(REG(cpu, RTL_ICTL_GISR)) & output->mask;
+	pending = ictl_r32(REG(cpu, RTL_ICTL_GIMR)) &
+		  ictl_r32(REG(cpu, RTL_ICTL_GISR)) & output->mask;
 
 	if (unlikely(!pending)) {
 		spurious_interrupt();
@@ -272,3 +317,12 @@ static int __init realtek_rtl_of_init(struct device_node *node, struct device_no
 }
 
 IRQCHIP_DECLARE(realtek_rtl_intc, "realtek,rtl-intc", realtek_rtl_of_init);
+
+static int __init realtek_rtl8197f_of_init(struct device_node *node, struct device_node *parent)
+{
+	realtek_ictl_variant = &realtek_rtl8197f_variant;
+
+	return realtek_rtl_of_init(node, parent);
+}
+
+IRQCHIP_DECLARE(realtek_rtl8197f_intc, "realtek,rtl8197f-intc", realtek_rtl8197f_of_init);
